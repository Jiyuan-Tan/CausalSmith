formalization/retrieval_eval/gate_data.jsonl

# Regenerable numeric dumps, compiled caches and environments left by discovery scripts.
# The scripts and their JSON/text summaries are the record; these are not.
research/**/*.npz
research/**/*.npy
research/**/*.bin
research/**/*.pkl
research/**/*.so
research/**/*.o
research/**/*.a
**/__pycache__/
**/*.pyc
**/.venv*/

# Downloaded third-party source documents (papers, book excerpts, arXiv sources, saved
# web pages) fetched by discovery agents as citation evidence. They stay on disk and
# never enter git. Most already live under an ignored logs/ dir; these rules cover the
# copies agents left elsewhere in a run. A run's own compiled PDFs (writeup.pdf,
# proposal.pdf, *_check.pdf, *_compile.pdf, ...) are NOT matched.
# (1) Formats that are only ever downloads: arXiv e-print payloads and saved pages.
research/**/*.source
research/**/*.src
research/**/*.download
research/_bank/**/*.html
research/active/**/*.html
# (2) Directories that hold fetched sources (PDFs only; scripts/receipts beside them stay visible).
research/**/.source_reads/**/*.pdf
!research/**/.source_reads/*_validation.pdf
research/**/source_evidence/*.pdf
research/**/source_verification/*.pdf
research/**/evidence/causal_literature/*.pdf
research/**/lit_seed_scan/*.pdf
research/**/discovery/author_sources/*.pdf
research/**/author_audit/*_tex/*.pdf
# (3) Source-document file names: arXiv ids and the -source / -primary conventions.
research/**/[0-9][0-9][0-9][0-9].[0-9][0-9][0-9][0-9]*.pdf
research/**/*-source.pdf
research/**/*_source.pdf
research/**/*-primary.pdf
# (4) Individually named downloads that follow no convention.
research/_bank/downgraded/exp_batchpilot_depletion_local_frontier_v1/discovery/solve_checks/aronow.pdf
research/_bank/downgraded/exp_batchpilot_depletion_local_frontier_v1/discovery/solve_checks/dai.pdf
research/_bank/downgraded/exp_batchpilot_depletion_local_frontier_v1/discovery/solve_checks/li-ding.pdf
research/_bank/downgraded/exp_batchpilot_depletion_local_frontier_v1/discovery/solve_checks/noarov.pdf
research/_bank/downgraded/exp_categorical_endpoint_collision_power_v1/discovery/author_audit/delve.pdf
research/_bank/downgraded/exp_categorical_endpoint_collision_power_v1/discovery/author_audit/jana.pdf
research/_bank/downgraded/exp_hardcount_network_calibration_v1/discovery/solve_context/feray-1605.03836v3.pdf
research/_bank/downgraded/exp_nnt_critical_support_v1/discovery/support_bjm.pdf
research/_bank/downgraded/exp_ordinal_retention_omnibus_power_v1/discovery/source_repair/folland.pdf
research/_bank/downgraded/exp_standardized_critical_precision_v1/discovery/Sion1958.pdf
research/_bank/downgraded/exp_standardized_critical_precision_v1/discovery/bulus_smd_v2.pdf
research/_bank/downgraded/exp_standardized_critical_precision_v1/discovery/chattopadhyay_kelley2017.pdf
research/_bank/downgraded/stat_auxprognosis_cate_frontier_v1/discovery/author_checks/sundberg26a.pdf
research/_bank/downgraded/stat_calibrated_latenthomogeneity_frontier_v1/discovery/evidence/levy.pdf
research/_bank/downgraded/stat_contpce_binary_margin_information_v1/discovery/solve_context/zhang-yang-v2-audit.pdf
research/_bank/downgraded/stat_weakprincipal_pnie_precision_v1/discovery/solve_context/billingsley-worker.pdf

# Topic-selection rounds (slates, collision checks, gate verdicts, presolve receipts): working
# records of how a topic was chosen. They are published with the run-record dataset, not in git.
research/_topics/*
!research/_topics/README.md

# Dual receipts an unfinished F4 pass leaves beside its run, reused and removed by the next pass.
research/**/convergence_partial.json
# The snapshot banking records for the promotion gate (a raw run record: file and statement hashes).
research/**/promotion_snapshot.json
