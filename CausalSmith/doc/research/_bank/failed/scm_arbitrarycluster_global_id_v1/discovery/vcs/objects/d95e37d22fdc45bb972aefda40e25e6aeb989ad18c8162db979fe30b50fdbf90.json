  "body": {
    "id": "ass:stable-covariance-rank",
    "kind": "regularity",
    "condition": "\\(\\operatorname{rank}\\{\\Sigma_F(q)\\}=r\\) for every \\(q\\) in some neighborhood of \\(p\\) within \\(S\\).",
    "free_symbols": [
      "Sigma",
      "r",
      "p",
      "S"
    ],
    "standard": {
      "name": "Locally constant covariance rank",
      "cite": "BhattacharyaNabiShpitser2022Semiparametric"
    }
  }
}