{
  "node_type": "assumption",
  "body": {
    "id": "ass:covariance-regularity",
    "kind": "information condition",
    "condition": "\\(\\underline\\omega\\le\\lambda_{\\min}(\\Omega_n)\\le\\lambda_{\\max}(\\Omega_n)\\le\\overline\\omega\\) for every \\(n\\).",
    "free_symbols": [
      "\\(\\underline\\omega\\)",
      "\\(\\overline\\omega\\)",
      "\\(\\Omega_n\\)",
      "n"
    ],
    "standard": {
      "name": "uniform nonsingularity of the Gaussian information matrix",
      "cite": "AndrewsMikusheva2016"
    }
  }
}