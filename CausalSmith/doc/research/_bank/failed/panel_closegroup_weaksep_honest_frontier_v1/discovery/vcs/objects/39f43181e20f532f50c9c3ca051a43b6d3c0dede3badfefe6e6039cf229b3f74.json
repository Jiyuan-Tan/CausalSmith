{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-fourth-moment",
    "kind": "moment condition",
    "condition": "\\(\\sup_{n\\ge1}\\max_{r\\in\\mathcal R}\\mathbb E_{P_{r,n}}[\\|W_{ri}-\\mu_{r,n}\\|_2^4]\\le M_4\\).",
    "free_symbols": [
      "n",
      "r",
      "\\(\\mathcal R\\)",
      "\\(P_{r,n}\\)",
      "\\(W_{ri}\\)",
      "\\(\\mu_{r,n}\\)",
      "\\(M_4\\)"
    ],
    "standard": {
      "name": "uniform Lyapunov fourth-moment condition",
      "cite": "vanDerVaart1998"
    }
  }
}