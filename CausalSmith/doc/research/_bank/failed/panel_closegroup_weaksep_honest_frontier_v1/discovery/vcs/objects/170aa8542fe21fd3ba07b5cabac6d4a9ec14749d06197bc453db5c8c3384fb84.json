{
  "node_type": "assumption",
  "body": {
    "id": "ass:stable-fractions",
    "kind": "sampling-rate condition",
    "condition": "For every \\(r\\in\\mathcal R\\), \\(n_r/n\\to\\lambda_r\\in(0,1)\\).",
    "free_symbols": [
      "r",
      "\\(\\mathcal R\\)",
      "\\(n_r\\)",
      "n",
      "\\(\\lambda_r\\)"
    ],
    "standard": {
      "name": "stable unequal group-size asymptotics",
      "cite": "FermanPinto2019"
    }
  }
}