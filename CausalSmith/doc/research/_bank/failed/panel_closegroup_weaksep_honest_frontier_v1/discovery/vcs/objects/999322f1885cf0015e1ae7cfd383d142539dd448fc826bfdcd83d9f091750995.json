      "\\(C^{\\mathrm{NP}}_{c,\\Delta,\\alpha}\\)",
      "\\(Z^{\\mathrm{sw}}\\)",
      "D",
      "c",
      "\\(\\Delta\\)",
      "\\(\\alpha\\)",
      "\\(z_{1-\\alpha}\\)",
      "\\(\\Phi\\)"
    ],
    "inputs": [
      "D",
      "c",
      "\\(\\Delta\\)"
    ]
  }
}