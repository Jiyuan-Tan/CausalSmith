    "id": "def:schur-certificate",
    "name": "Exact Schur covariance and deterministic risk certificate",
    "construction": "When \\(M_n<n\\), form \\(K_G=n^{-1}D_q(G)^{-1}B_2(G)P_nB_2(G)^{\\mathsf T}D_q(G)^{-1}\\), \\(Q_G=\\sum_{r=1}^{k_n}\\binom{k_n}{r}K_G^{\\circ r}\\), and \\(U(G,k_n)=2/k_n+2\\|B_2(G)P_n\\|_{\\mathrm{op}}^2[(1-M_n/n)^{-k_n}-1]/[nM_n(1-M_n/n)]\\).",
    "free_symbols": [
      "n",
      "M_n",
      "K_G",
      "D_q(G)",
      "B_2(G)",
      "P_n",
      "G",
      "Q_G",
      "k_n",
      "U(G,k_n)"
    ],
    "inputs": [
      "G",
      "k_n"
    ]
  }
}