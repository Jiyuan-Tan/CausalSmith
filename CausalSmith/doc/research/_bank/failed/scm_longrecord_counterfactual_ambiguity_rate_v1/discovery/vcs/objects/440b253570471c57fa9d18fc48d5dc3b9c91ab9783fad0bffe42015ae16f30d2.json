{
  "node_type": "assumption",
  "body": {
    "id": "ass:poisson-span",
    "kind": "regularity",
    "condition": "The Poisson solution satisfies \\(\\operatorname{span}(h)=\\max_z h(z)-\\min_z h(z)\\le B\\).",
    "free_symbols": [
      "h",
      "B",
      "\\mathcal S"
    ],
    "standard": {
      "name": "bounded Poisson bias span",
      "cite": "SayedanaCainesMahajan2025"
    }
  }
}