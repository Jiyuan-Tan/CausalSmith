  "definitions": [
    {
      "id": "def:risk-game",
      "name": "Unrestricted labeled-schedule minimax game",
      "construction": "\\[R_n(c)=\\inf_{\\mathcal D_n,\\widehat\\tau}\\max_{z\\in\\{0,1\\}^{n\\times K}}\\mathbb E_{\\mathcal D_n}\\!\\left[\\{\\widehat\\tau((A_i,Y_i^{\\mathrm{obs}})_{i=1}^n)-\\tau_c(z)\\}^2\\right].\\]",
      "free_symbols": [
        "R_n(c)",
        "n",
        "c",
        "K",
        "\\mathcal D_n",
        "\\widehat\\tau",
        "z",
        "A",
        "i",
        "Y_i^{\\mathrm{obs}}",
        "\\tau_c(z)"
      ],
      "inputs": [
        "n",
        "K",
        "c",
        "z",
        "\\mathcal D_n",
        "\\widehat\\tau"
      ]
    },
    {
      "id": "def:response-cost",
      "name": "Finite response-alphabet cost",
      "construction": "For every \\(x\\in\\mathbb R^{S_c}\\), set \\[V_c(x)=\\min\\left\\{\\sum_{t\\in\\mathcal T_c}\\lambda_t\\theta_t^2:\\lambda_t\\ge0,\\ \\sum_{t\\in\\mathcal T_c}\\lambda_tb_t=x\\right\\},\\qquad \\kappa(c)=V_c(v).\\]",
      "free_symbols": [
        "V_c",
        "S_c",
        "x",
        "t",
        "\\mathcal T_c",
        "\\theta_t",
        "b_t",
        "\\kappa(c)",
        "c",
        "v"
      ],
      "inputs": [
        "c",
        "v",
        "\\mathcal T_c",
        "b_t",
        "\\theta_t"
      ]
    },
    {
      "id": "def:dual-score",
      "name": "Certified full-label dual score",
      "construction": "Choose the lexicographically least solution \\(\\ell^\\star\\) of \\[\\max_{\\ell\\in\\mathbb R^{S_c}}\\ell^\\top v\\quad\\text{subject to}\\quad |\\ell^\\top b_t|\\le\\theta_t^2\\ \\text{for every }t\\in\\mathcal T_c,\\] and put \\(g^\\star=\\ell^\\star/\\kappa(c)\\).",
      "free_symbols": [
        "\\ell^\\star",
        "S_c",
        "v",
        "b_t",
        "\\theta_t",
        "t",
        "\\mathcal T_c",
        "g^\\star",
        "\\kappa(c)"
      ],
      "inputs": [
        "v",
        "b_t",
        "\\theta_t",
        "\\mathcal T_c",
        "\\kappa(c)"
      ]
    },
    {
      "id": "def:airy-benchmark",
      "name": "Airy feedback benchmark",
      "construction": "Let \\(\\phi_c\\) be the positive even ground state of \\(-4d^2/dx^2+\\kappa(c)|x|\\) with unit \\(L^2\\) norm; set \\(h_c=-2\\phi_c'/\\phi_c\\) and \\(\\Lambda_c=C_A\\kappa(c)^{2/3}\\).",
      "free_symbols": [
        "\\phi_c",
        "\\kappa(c)",
        "h_c",
        "\\Lambda_c",
        "C_A"
      ],
      "inputs": [
        "\\kappa(c)",
        "C_A"
      ]
    },
    {
      "id": "def:qstar-procedure",
      "name": "Total full-label Airy procedure under contrast-weighted independence",
      "construction": "Draw the \\(A_i\\) independently with probabilities \\(q^\\star\\). On positive-probability observations define \\[T_i=\\frac{c_{A_i}(Y_i^{\\mathrm{obs}}-1/2)}{q_{A_i}^\\star},\\qquad U_i=\\frac{g_{A_i}^\\star(Y_i^{\\mathrm{obs}}-1/2)}{q_{A_i}^\\star},\\] and \\[\\delta_n^\\star=\\operatorname{proj}_{[-1,1]}\\!\\left\\{\\frac1n\\sum_{i=1}^nT_i-n^{-2/3}h_c\\!\\left(n^{-2/3}\\sum_{i=1}^nU_i\\right)\\right\\}.\\] Return zero on null observations containing an inactive-arm label.",
      "free_symbols": [
        "A",
        "i",
        "q^\\star",
        "c",
        "Y_i^{\\mathrm{obs}}",
        "g^\\star",
        "n",
        "h_c",
        "T_i",
        "U_i",
        "\\delta_n^{\\star}"
      ],
      "inputs": [
        "n",
        "c",
        "q^\\star",
        "g^\\star",
        "h_c",
        "A",
        "Y_i^{\\mathrm{obs}}"
      ]
    },
    {
