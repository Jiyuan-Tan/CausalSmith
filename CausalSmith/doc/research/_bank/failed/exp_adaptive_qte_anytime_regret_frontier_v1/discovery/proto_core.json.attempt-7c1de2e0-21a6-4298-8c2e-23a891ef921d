  "assumptions": [
    {
      "id": "ass:fixed-potential-outcomes",
      "kind": "design-based finite population",
      "condition": "\\(\\operatorname{Var}_{A}(Y_{n,i}(a))=0\\quad\\forall n,i,a\\).",
      "free_symbols": ["Y_{n,i}(a)", "n", "i", "a"],
      "standard": {
