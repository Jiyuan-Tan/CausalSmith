    }
  ],
  "definitions": [
    {
      "id": "def:finite-population-qte",
      "name": "Finite-population QTE curve",
      "construction": "\\(F_{a,n}(y)=n^{-1}\\sum_{i=1}^n\\mathbf 1\\{Y_{n,i}(a)\\le y\\}\\), \\(q_{a,n}(u)=\\inf\\{y:F_{a,n}(y)\\ge u\\}\\), and \\(\\tau_n(u)=q_{1,n}(u)-q_{0,n}(u)\\).",
      "free_symbols": ["F_{a,n}", "a", "n", "i", "Y_{n,i}(a)", "q_{a,n}", "u", "\\tau_n"],
      "inputs": ["Y_{n,i}(a)", "\\mathcal U"]
    },
    {
      "id": "def:score-energy",
      "name": "Finite-population QTE score energies",
      "construction": "\\(z_{a,n,i}(u)=\\mathbf 1\\{Y_{n,i}(a)\\le q_{a,n}(u)\\}\\), \\(G_a(u)=u/f_a(q_a(u))^2\\), and \\(H(u)=\\lim_{n\\to\\infty}n^{-1}\\sum_{i=1}^n z_{1,n,i}(u)z_{0,n,i}(u)/(f_1(q_1(u))f_0(q_0(u)))\\).",
      "free_symbols": ["z_{a,n,i}", "a", "n", "i", "u", "Y_{n,i}(a)", "q_{a,n}", "F_{a,n}", "G_a", "f_a", "q_a", "H"],
      "inputs": ["F_{a,n}", "q_{a,n}", "F_a", "f_a"]
    },
    {
      "id": "def:marginal-coupling-class",
      "name": "Compatible marginal coupling class",
      "construction": "\\(\\mathcal C(F_0,F_1)=\\{((Y_{n,i}(0),Y_{n,i}(1)))_{1\\le i\\le n,n\\ge1}:F_{0,n}\\to F_0\\text{ and }F_{1,n}\\to F_1\\text{ uniformly}\\}\\).",
      "free_symbols": ["\\mathcal C(F_0,F_1)", "Y_{n,i}(a)", "n", "i", "F_{a,n}", "F_a"],
      "by_member_properties": ["ass:fixed-potential-outcomes", "ass:uniform-cdf-limit"]
    },
    {
      "id": "def:variance-kernel",
      "name": "Design-based QTE variance kernel",
      "construction": "\\(\\Omega(u,p)=((1-p)/p)G_1(u)+(p/(1-p))G_0(u)+2H(u)\\).",
      "free_symbols": ["\\Omega", "u", "p", "G_a", "H"],
      "inputs": ["G_a", "H", "p"]
    },
    {
      "id": "def:robust-width-kernel",
      "name": "Coupling-robust LIL-width kernel",
      "construction": "\\(K(u,p)=\\sqrt{(1-p)G_1(u)/p}+\\sqrt{pG_0(u)/(1-p)}\\).",
      "free_symbols": ["K", "u", "p", "G_a"],
      "inputs": ["G_a", "p"]
    },
    {
      "id": "def:stabilizing-design-class",
      "name": "Predictable stabilizing design class",
      "construction": "\\(\\mathfrak D^{\\mathrm{stab}}_{\\varepsilon}=\\{(\\pi_{n,i})_{1\\le i\\le n,n\\ge1}:\\pi_{n,i}\\text{ is }\\mathcal F_{n,i-1}\\text{-measurable},\\ \\varepsilon\\le\\pi_{n,i}\\le1-\\varepsilon,\\ \\max_{1\\le i\\le n}|\\pi_{n,i}-p|\\to0\\text{ in probability for some }p\\in[\\varepsilon,1-\\varepsilon]\\}\\).",
      "free_symbols": ["\\mathfrak D^{\\mathrm{stab}}_{\\varepsilon}", "\\pi_{n,i}", "n", "i", "\\mathcal F_{n,i}", "\\varepsilon", "p"],
      "by_member_properties": ["ass:predictability", "ass:overlap"]
    },
    {
      "id": "def:ht-cdf",
      "name": "Adaptive Horvitz--Thompson CDF process",
      "construction": "\\(\\widehat F_{a,n}(y)=n^{-1}\\sum_{i=1}^n\\mathbf 1\\{A_{n,i}=a\\}\\mathbf 1\\{Y^{\\mathrm{obs}}_{n,i}\\le y\\}/p_{n,i,a}\\).",
      "free_symbols": ["\\widehat F_{a,n}", "a", "n", "i", "A_{n,i}", "Y^{\\mathrm{obs}}_{n,i}", "p_{n,i,a}"],
      "inputs": ["A_{n,i}", "Y^{\\mathrm{obs}}_{n,i}", "p_{n,i,a}"]
    },
    {
      "id": "def:realized-variance",
      "name": "Observable thresholdwise variance proxy",
      "construction": "\\(\\widehat V_{a,n}(y)=\\sum_{i=1}^n\\mathbf 1\\{A_{n,i}=a\\}(1-p_{n,i,a})\\mathbf 1\\{Y^{\\mathrm{obs}}_{n,i}\\le y\\}/p_{n,i,a}^2\\).",
      "free_symbols": ["\\widehat V_{a,n}", "a", "n", "i", "A_{n,i}", "p_{n,i,a}", "Y^{\\mathrm{obs}}_{n,i}"],
      "inputs": ["A_{n,i}", "Y^{\\mathrm{obs}}_{n,i}", "p_{n,i,a}"]
    },
    {
      "id": "def:stitched-boundary",
      "name": "Stitched empirical-Bernstein boundary",
      "construction": "\\(b_{\\alpha}(v,c)=\\sqrt{2(v+c^2)[\\log\\log(e^2+v/c^2)+\\log(8/\\alpha)]}+c[\\log\\log(e^2+v/c^2)+\\log(8/\\alpha)]\\).",
      "free_symbols": ["b_{\\alpha}", "\\alpha"],
      "inputs": ["\\widehat V_{a,n}", "\\alpha"]
    },
    {
      "id": "def:qte-band",
      "name": "Observed-kernel anytime QTE band",
      "construction": "For each arm, form monotone envelopes \\(L_{a,n}(y)=[\\widehat F_{a,n}(y)-b_{\\alpha/4}(\\widehat V_{a,n}(y),\\varepsilon^{-1})/n]_0^1\\) and \\(U_{a,n}(y)=[\\widehat F_{a,n}(y)+b_{\\alpha/4}(\\widehat V_{a,n}(y),\\varepsilon^{-1})/n]_0^1\\); then set \\(\\mathsf B_n(u)=[U_{1,n}^{\\leftarrow}(u)-L_{0,n}^{\\leftarrow}(u),\\ L_{1,n}^{\\leftarrow}(u)-U_{0,n}^{\\leftarrow}(u)]\\).",
      "free_symbols": ["\\mathsf B_n", "n", "u", "a", "\\widehat F_{a,n}", "b_{\\alpha}", "\\alpha", "\\widehat V_{a,n}", "\\varepsilon", "L_{a,n}", "U_{a,n}"],
      "inputs": ["\\widehat F_{a,n}", "\\widehat V_{a,n}", "b_{\\alpha}"]
    },
    {
      "id": "def:frontier-criteria",
      "name": "Allocation-regret and LIL-width criteria",
      "construction": "\\(r(p)=\\int_{\\mathcal U}\\Omega(u,p)\\,d\\omega(u)-\\min_{s\\in[\\varepsilon,1-\\varepsilon]}\\int_{\\mathcal U}\\Omega(u,s)\\,d\\omega(u)\\) and \\(w(p)=\\sup_{u\\in\\mathcal U}K(u,p)\\).",
      "free_symbols": ["r", "p", "\\mathcal U", "\\Omega", "u", "\\omega", "\\varepsilon", "w", "K"],
      "inputs": ["\\Omega", "K", "\\omega", "\\mathcal U", "\\varepsilon"]
    },
    {
