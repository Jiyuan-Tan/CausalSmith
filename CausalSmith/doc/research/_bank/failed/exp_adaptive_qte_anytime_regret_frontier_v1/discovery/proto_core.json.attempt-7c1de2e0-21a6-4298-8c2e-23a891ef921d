        "cite": "NoarovFogliatoBertranRoth2025"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
    },
    {
      "id": "ass:predictability",
      "kind": "design measurability",
      "condition": "\\(\\pi_{n,i}\\) is \\(\\mathcal F_{n,i-1}\\)-measurable.",
      "free_symbols": ["\\pi_{n,i}", "\\mathcal F_{n,i}", "n", "i"],
      "standard": {
