      "kind": "known assignment law",
      "condition": "\\(A_{n,i}\\mid\\mathcal F_{n,i-1}\\sim\\operatorname{Bernoulli}(\\pi_{n,i})\\).",
      "free_symbols": ["A_{n,i}", "\\mathcal F_{n,i}", "\\pi_{n,i}", "n", "i"],
      "standard": {
        "name": "sequential Bernoulli randomization",
        "cite": "NoarovFogliatoBertranRoth2025"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
    },
    {
      "id": "ass:overlap",
      "kind": "allocation positivity",
      "condition": "\\(\\varepsilon\\le\\pi_{n,i}\\le1-\\varepsilon\\).",
      "free_symbols": ["\\varepsilon", "\\pi_{n,i}", "n", "i"],
      "constants": ["\\varepsilon"],
      "standard": {
        "name": "clipped adaptive overlap",
        "cite": "DaiGraduHarshaw2023"
      },
      "used_by": ["def:stabilizing-design-class", "thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
    },
    {
      "id": "ass:uniform-cdf-limit",
      "kind": "finite-population regularity",
      "condition": "\\(\\max_{a\\in\\{0,1\\}}\\sup_{y\\in\\mathbb R}|F_{a,n}(y)-F_a(y)|\\to0\\).",
      "free_symbols": ["a", "F_{a,n}", "F_a", "n"],
      "standard": {
        "name": "uniform finite-population distributional stabilization",
        "cite": "ZhangZheng2020"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "cor:single-quantile-reduction"]
    },
    {
      "id": "ass:density-lower",
      "kind": "quantile regularity",
      "condition": "\\(\\inf_{a\\in\\{0,1\\},u\\in\\mathcal U}f_a(q_a(u))\\ge c_f>0\\).",
      "free_symbols": ["a", "u", "\\mathcal U", "f_a", "q_a", "c_f"],
      "constants": ["c_f"],
      "standard": {
        "name": "uniform positive quantile density",
        "cite": "LiLuoWangFeng2025"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
    },
    {
      "id": "ass:density-upper",
      "kind": "quantile regularity",
      "condition": "\\(\\sup_{a\\in\\{0,1\\},u\\in\\mathcal U}f_a(q_a(u))\\le C_f<\\infty\\).",
      "free_symbols": ["a", "u", "\\mathcal U", "f_a", "q_a", "C_f"],
      "constants": ["C_f"],
      "standard": {
        "name": "uniform bounded quantile density",
        "cite": "ZhangZheng2020"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
    },
    {
      "id": "ass:density-continuity",
      "kind": "quantile regularity",
      "condition": "\\(\\lim_{\\delta\\downarrow0}\\sup_{a\\in\\{0,1\\},u\\in\\mathcal U,|y-q_a(u)|\\le\\delta}|f_a(y)-f_a(q_a(u))|=0\\).",
      "free_symbols": ["f_a", "a", "q_a", "u", "\\mathcal U"],
      "standard": {
        "name": "uniform Bahadur quantile smoothness",
        "cite": "ZhangZheng2020"
      },
      "used_by": ["thm:anytime-band", "thm:sharp-pareto-frontier", "oeq:adaptive-attainment"]
