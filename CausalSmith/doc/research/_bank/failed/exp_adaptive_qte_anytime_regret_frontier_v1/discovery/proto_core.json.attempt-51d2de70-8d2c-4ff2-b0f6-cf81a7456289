  "definitions": [
    {
      "id": "def:design-class",
      "name": "Regular design-based QTE arrays",
      "construction": "\\(\\mathcal M=\\{(\\{Y_{n,t}(a):a\\in\\mathcal A,1\\le t\\le n\\}_{n\\ge1},\\{p_{n,t}:1\\le t\\le n\\}_{n\\ge1}):\\text{ass:bounded-fixed-outcomes, ass:predictable-clipping, ass:uniform-finite-population-limit, ass:regular-quantile-spacing, ass:block-score-stability, and ass:score-energy-continuity hold}\\}\\).",
      "free_symbols": ["Y", "n", "t", "Aset", "p"],
      "by_member_properties": ["ass:bounded-fixed-outcomes", "ass:predictable-clipping", "ass:uniform-finite-population-limit", "ass:regular-quantile-spacing", "ass:block-score-stability", "ass:score-energy-continuity"]
    },
    {
      "id": "def:pareto-frontier",
      "name": "Allocation-regret and LIL-width frontier",
      "construction": "Compute \\(J\\), \\(p_N\\), \\(\\Delta\\), and \\(b\\) from the score-energy curves, form \\(\\{(\\Delta(r),b(r)):r\\in[\\varepsilon,1-\\varepsilon]\\}\\), and retain its coordinatewise nondominated points to obtain \\(\\mathfrak F\\).",
      "free_symbols": ["J", "pN", "Delta", "b", "eps", "Frontier"],
      "inputs": ["d", "mu", "eps"]
    },
    {
      "id": "def:frontier-adaptive-design",
      "name": "Doubling-batch frontier design",
      "construction": "At epochs \\(m_k=2^k\\), form armwise inverse-probability AIPW empirical distribution functions from \\(\\{A_{n,t},O_{n,t},p_{n,t}:t\\le m_k\\}\\), monotonize them, and let \\(\\widehat Q_{a,k}\\) be their generalized inverses. With \\(h_k=m_k^{-1/5}\\), set \\(\\widehat d_{a,k}(u)=u(1-u)\\{[\\widehat Q_{a,k}(u+h_k)-\\widehat Q_{a,k}(u-h_k)]/(2h_k)\\}^2\\), using endpoint truncation inside \\(I\\). Replace \\(d\\) by \\(\\widehat d_k\\) in \\(\\Delta(r)+\\lambda b(r)^2\\), choose its smallest minimizer over \\([\\varepsilon,1-\\varepsilon]\\), and use that probability throughout \\(m_k<t\\le m_{k+1}\\); initialize at \\(1/2\\).",
      "free_symbols": ["AdaptiveDesign", "A", "O", "p", "t", "I", "eps", "d", "Delta", "lambda", "b"],
      "inputs": ["lambda", "I", "eps", "A", "O", "p"]
    },
    {
      "id": "def:anytime-qte-band",
      "name": "AIPW inversion QTE confidence sequence",
      "construction": "Set \\(m_{a,n,0}(y)=1/2\\) and thereafter use the lagged monotonized AIPW distribution estimate. For each arm, apply a self-normalized empirical-Bernstein mixture to \\(\\sum_{t\\le n}\\{H_{a,n,t}(y)-\\mathbf 1(Y_{n,t}(a)\\le y)\\}\\), stitch intrinsic-time epochs, and use the threshold-ordering argument to obtain \\([L_{a,n},U_{a,n}]\\) simultaneously in \\(n\\) and \\(y\\). Return \\(\\mathcal C_n(u)=[U_{1,n}^{-1}(u)-L_{0,n}^{-1}(u),L_{1,n}^{-1}(u)-U_{0,n}^{-1}(u)]\\).",
      "free_symbols": ["m", "Aset", "n", "t", "H", "Y", "CDFBand", "QTEBand", "I", "alpha"],
      "inputs": ["A", "O", "p", "alpha"]
    },
    {
      "id": "def:unrestricted-lower-bound-handle",
      "name": "Permutation-coupling lower-bound handle",
      "construction": "Use the quantile-score permutation and sequential change-of-measure strategy named by \\(\\text{LowerBoundHandle}\\) to compare any predictable allocation and anytime band with finite populations having identical revealed armwise marginals but least-favorable cross-arm pairing near one quantile in \\(I\\).",
      "free_symbols": ["LowerBoundHandle", "p", "QTEBand", "Y", "I", "d"],
      "inputs": ["LowerBoundHandle", "d", "I"]
    }
  ],
  "statements": [
    {
      "id": "thm:oracle-frontier",
      "kind": "theorem",
      "statement": "On \\(\\mathcal M\\), consider any predictable design for which the Cesaro limits of \\(n^{-1}\\sum_{t\\le n}(1-p_{n,t})/p_{n,t}\\) and \\(n^{-1}\\sum_{t\\le n}p_{n,t}/(1-p_{n,t})\\) exist, and let \\(\\bar p=\\lim_n n^{-1}\\sum_{t\\le n}p_{n,t}\\). Its limiting regret density and marginal-inversion LIL-width constant are coordinatewise no smaller than \\(\\Delta(\\bar p)\\) and \\(b(\\bar p)\\). Every pair \\( (\\Delta(r),b(r))\\) is attained by the constant Bernoulli design \\(p_{n,t}=r\\). Hence the sharp nondominated set is exactly \\(\\mathfrak F\\), and every exposed point is indexed by a minimizer \\(p_\\lambda\\) of \\(\\Delta(r)+\\lambda b(r)^2\\).",
      "free_symbols": ["p", "n", "t", "Delta", "b", "Frontier", "pLambda", "lambda"],
      "depends_on": ["def:design-class", "def:pareto-frontier"],
      "status": "to-prove",
      "justification": "This turns an infinite-dimensional adaptive-design comparison into an explicit one-dimensional frontier with a convexity certificate.",
      "gap": "Li, Luo, Wang, and Feng optimize one quantile at a fixed horizon, while Noarov, Fogliato, Bertran, and Roth optimize a scalar mean loss; neither characterizes the continuum-QTE regret-width set.",
      "consumer": "Trial designers can select a treatment fraction from an auditable tolerance on average QTE precision and read off the smallest achievable maximal sequential-band width."
    },
    {
      "id": "thm:adaptive-attainment",
      "kind": "theorem",
      "statement": "For each \\(\\lambda\\ge0\\), the doubling-batch design \\(\\pi^\\lambda\\) is predictable, satisfies \\(p_{n,t}^\\lambda\\in[\\varepsilon,1-\\varepsilon]\\), and obeys \\(p_{n,t}^\\lambda\\to p_\\lambda\\) in randomization probability uniformly away from batch boundaries. Moreover, \\(n^{-1}\\operatorname{Reg}_n(\\pi^\\lambda)\\to\\Delta(p_\\lambda)\\), and its scalarized excess relative to \\(p_\\lambda\\) is \\(o_{\\Pr}(1)\\).",
      "free_symbols": ["lambda", "AdaptiveDesign", "p", "n", "t", "eps", "pLambda", "Reg", "Delta"],
      "depends_on": ["def:design-class", "def:frontier-adaptive-design", "thm:oracle-frontier"],
      "status": "to-prove",
      "justification": "The oracle curve depends on two unknown quantile-spacing functions, so attainment requires learning the design target on the same adaptive path.",
      "gap": "Noarov, Fogliato, Bertran, and Roth use unbiased scalar loss gradients, and Li, Luo, Wang, and Feng learn a pointwise QTE allocation; the proposed rule learns a nonsmooth supremum functional over a continuum.",
      "consumer": "A platform can preselect \\(\\lambda\\) and run one response-adaptive experiment whose long-run operating point is certified on the frontier."
    },
    {
      "id": "thm:anytime-band",
      "kind": "theorem",
      "statement": "Under \\(\\pi^\\lambda\\), the band \\(\\mathcal C_n\\) satisfies \\(\\Pr_A\\{\\tau_n(u)\\in\\mathcal C_n(u)\\text{ for every }n\\ge1\\text{ and }u\\in I\\}\\ge1-\\alpha\\). Its maximal half-width has the design-based LIL expansion \\(\\limsup_{n\\to\\infty}\\sqrt{n/(2\\log\\log n)}\\sup_{u\\in I}\\operatorname{rad}\\{\\mathcal C_n(u)\\}\\le b(p_\\lambda)\\) in randomization probability, with equality for a least-favorable cross-arm ordering in the marginal-inversion band class.",
      "free_symbols": ["AdaptiveDesign", "lambda", "QTEBand", "n", "tau", "I", "alpha", "b", "pLambda"],
      "depends_on": ["def:design-class", "def:frontier-adaptive-design", "def:anytime-qte-band", "thm:adaptive-attainment"],
      "status": "to-prove",
      "justification": "Frontier optimality has operational meaning only if a band is valid after arbitrary monitoring and realizes the width coordinate.",
      "gap": "Howard and Ramdas obtain the sharp time-and-quantile LIL rate for i.i.d. samples, and Mineiro and Howard cover adaptive counterfactual distributions without the local augmented QTE constant; neither couples width to a learned allocation.",
      "consumer": "Online experiments at streaming platforms can stop on any whole-distribution treatment-effect feature while retaining a design-specific precision certificate."
    },
    {
      "id": "prop:strict-conflict",
      "kind": "proposition",
      "statement": "If \\(p_N\\ne p_W\\), then no predictable design in \\(\\mathcal M\\) simultaneously has zero limiting regret density and LIL-width constant \\(b(p_W)\\). More precisely, compactness and strict convexity yield a positive separation \\(\\inf_{r:\\,b(r)\\le b(p_W)+\\eta}\\Delta(r)>0\\) for every sufficiently small \\(\\eta>0\\).",
      "free_symbols": ["pN", "pW", "p", "b", "Delta"],
      "depends_on": ["def:design-class", "def:pareto-frontier", "thm:oracle-frontier"],
      "status": "to-prove",
