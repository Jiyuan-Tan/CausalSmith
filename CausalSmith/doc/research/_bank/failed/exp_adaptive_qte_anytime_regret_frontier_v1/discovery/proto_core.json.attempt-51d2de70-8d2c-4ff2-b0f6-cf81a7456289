      "condition": "For each \\(a\\in\\mathcal A\\), \\(\\sup_y|F_{a,n}(y)-F_a(y)|\\to0\\).",
      "free_symbols": ["Aset", "n", "Ffinite", "Flimit"],
      "standard": {"name": "uniform finite-population distribution convergence", "cite": "ZhangZheng2020"},
      "used_by": ["thm:oracle-frontier", "thm:adaptive-attainment", "thm:anytime-band", "prop:published-endpoints"]
    },
    {
      "id": "ass:regular-quantile-spacing",
      "kind": "quantile regularity",
      "condition": "For each \\(a\\in\\mathcal A\\), \\(F_a\\) is continuously differentiable on a neighborhood of \\(Q_a(I)\\) and \\(0<c_f\\le f_a(Q_a(u))\\le C_f<\\infty\\) uniformly over \\(u\\in I\\).",
