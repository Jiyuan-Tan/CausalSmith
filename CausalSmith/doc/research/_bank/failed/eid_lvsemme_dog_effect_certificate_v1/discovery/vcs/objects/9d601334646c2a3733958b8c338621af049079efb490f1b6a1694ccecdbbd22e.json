  "body": {
    "id": "def:normalized-reconstruction",
    "name": "NormalizedReconstruction",
    "construction": "For \\(\\omega\\in\\Omega\\), set \\(\\Delta_{\\omega}=\\operatorname{diag}(W_{r_gc_g})\\), \\(Q_{\\omega}=W[R(\\omega),C(\\omega)]\\Delta_{\\omega}^{-1}\\), \\(A_{\\omega}=I-Q_{\\omega}^{-1}\\), \\(B^{C}_{\\omega}=Q_{\\omega}^{-1}W[R(\\omega),H(\\omega)]\\), \\(D_{\\omega}=W[L(\\omega),C(\\omega)]\\Delta_{\\omega}^{-1}Q_{\\omega}^{-1}\\), and \\(B^{L}_{\\omega}=W[L(\\omega),H(\\omega)]-D_{\\omega}Q_{\\omega}B^{C}_{\\omega}\\).",
    "free_symbols": [
      "omega",
      "Omega",
      "W",
      "Romega",
      "Comega",
      "Lomega",
      "Homega",
      "Deltaomega",
      "Qomega",
      "Aomega",
      "Bcomega",
      "Domega",
      "Blomega"
    ],
    "inputs": [
      "W",
      "Ggrp",
      "ell",
      "omega"
    ]
  }
}