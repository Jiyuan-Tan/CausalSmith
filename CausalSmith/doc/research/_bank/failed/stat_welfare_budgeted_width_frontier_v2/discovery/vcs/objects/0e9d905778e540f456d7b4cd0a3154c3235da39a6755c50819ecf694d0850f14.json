{
  "node_type": "assumption",
  "body": {
    "id": "ass:context-density",
    "kind": "sampling",
    "condition": "The contexts are independent across rounds with common law \\(P_X\\), and \\(P_X\\) has a density \\(p_X\\) on \\(\\mathcal X\\) satisfying \\(c_X\\le p_X(x)\\le C_X\\) almost everywhere.",
    "free_symbols": [
      "\\(X_t\\)",
      "\\(P_X\\)",
      "\\(p_X\\)",
      "\\(\\mathcal X\\)",
      "\\(c_X\\)",
      "\\(C_X\\)"
    ],
    "constants": [
      "\\(c_X\\)",
      "\\(C_X\\)"
    ],
    "standard": {
      "name": "strong-density contextual-bandit condition",
      "cite": "PerchetRigollet2013CovariateBandits"
    }
  }
}