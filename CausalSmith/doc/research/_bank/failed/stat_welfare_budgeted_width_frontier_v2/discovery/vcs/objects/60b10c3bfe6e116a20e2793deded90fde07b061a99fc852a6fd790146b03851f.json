{
  "node_type": "assumption",
  "body": {
    "id": "ass:bounded-means",
    "kind": "regularity",
    "condition": "For each \\(a\\in\\mathcal A\\), \\(\\sup_{x\\in\\mathcal X}|\\mu_a(x)|\\le M\\).",
    "free_symbols": [
      "\\(a\\)",
      "\\(\\mathcal A\\)",
      "\\(\\mu_a\\)",
      "\\(\\mathcal X\\)",
      "\\(M\\)"
    ],
    "constants": [
      "\\(M\\)"
    ],
    "standard": {
      "name": "uniformly bounded reward-mean condition",
      "cite": "PerchetRigollet2013CovariateBandits"
    }
  }
}