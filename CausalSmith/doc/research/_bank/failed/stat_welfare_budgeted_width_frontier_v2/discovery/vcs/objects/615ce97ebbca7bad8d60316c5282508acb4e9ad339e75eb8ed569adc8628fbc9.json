    "kind": "smoothness",
    "condition": "For each \\(a\\in\\mathcal A\\), the regression satisfies \\(|\\mu_a(x)-\\mu_a(x')|\\le L\\|x-x'\\|_2^\\beta\\) for all \\(x,x'\\in\\mathcal X\\).",
    "free_symbols": [
      "\\(a\\)",
      "\\(\\mathcal A\\)",
      "\\(\\mu_a\\)",
      "\\(L\\)",
      "\\(\\beta\\)",
      "\\(\\mathcal X\\)"
    ],
    "constants": [
      "\\(L\\)"
    ],
    "standard": {
      "name": "Hölder reward-regression condition",
      "cite": "PerchetRigollet2013CovariateBandits"
    }
  }
}