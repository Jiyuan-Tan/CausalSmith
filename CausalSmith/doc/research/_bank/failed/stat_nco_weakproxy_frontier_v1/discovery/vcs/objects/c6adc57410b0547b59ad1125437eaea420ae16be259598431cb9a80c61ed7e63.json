{
  "node_type": "assumption",
  "body": {
    "id": "ass:link-lower",
    "kind": "ill-posedness",
    "condition": "\\(\\|Ag\\|_{L^2_X}\\ge c_{\\rm link}\\|L^{-a}g\\|_{\\ell^2_{K,W}}\\) for every \\(g\\in\\ell^2_{K,W}\\) satisfying \\(E_P\\{g(W)\\}=0\\).",
    "free_symbols": [
      "A",
      "g",
      "L2_X",
      "c_link",
      "L",
      "a",
      "ell2_W",
      "P"
    ],
    "standard": {
      "name": "two-sided polynomial sieve-link lower inequality",
      "cite": "BreunigChen2024"
    }
  }
}