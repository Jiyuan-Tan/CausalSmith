{
  "node_type": "assumption",
  "body": {
    "id": "ass:fixed-predictor-kernel",
    "kind": "regularity",
    "condition": "\\[k(x,x')=e^{-(x-x')^2/(2\\sigma_K^2)}.\\]",
    "free_symbols": [
      "k",
      "sigmaK"
    ],
    "standard": {
      "name": "bounded characteristic Gaussian predictor kernel",
      "cite": "GrettonBSS05"
    }
  }
}