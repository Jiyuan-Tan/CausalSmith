{
  "node_type": "assumption",
  "body": {
    "id": "ass:independent-environment-samples",
    "kind": "sampling",
    "condition": "Conditional on \\(\\theta\\), the observations \\(Y_{ei}\\sim N(0,\\Sigma_e)\\) are independent over all \\(e\\in\\mathcal E\\) and \\(1\\le i\\le n_e\\).",
    "free_symbols": [
      "theta",
      "Ye",
      "Sigma",
      "Env",
      "n"
    ],
    "standard": {
      "name": "Independent multi-sample Gaussian covariance experiment",
      "cite": "Lewis2022RobustHeteroskedasticity"
    }
  }
}