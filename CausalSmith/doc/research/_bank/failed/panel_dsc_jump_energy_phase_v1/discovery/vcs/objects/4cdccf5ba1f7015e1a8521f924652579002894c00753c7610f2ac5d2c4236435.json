  "body": {
    "name": "\\(\\mathcal C_\\ell(R_\\ell)\\)",
    "type": "simultaneous product \\(L^2\\) confidence ball",
    "space": "subsets of \\(L^2([0,1])^{T_1}\\)",
    "def": "\\(\\mathcal C_\\ell(R_\\ell)=\\{(f_t)_{t>T_0}:\\max_{t>T_0}\\|f_t-\\widehat\\tau_{t,\\ell}\\|_{L^2}\\leq R_\\ell\\}\\).",
    "role": "confidence set",
    "refs": [
      "\\(T_0\\)",
      "\\(T_1\\)",
      "\\(\\widehat\\tau_{t,\\ell}\\)",
      "\\(R_\\ell\\)"
    ]
  }
