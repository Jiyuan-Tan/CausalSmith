  "body": {
    "id": "lem:law-fiber-response-rank",
    "kind": "lemma",
    "statement": "For every \\(\\widetilde{\\mathcal M}\\in\\mathfrak F_x^{\\mathrm{law}}(P_X)\\), one has \\(m_{\\widetilde{\\mathcal M}}=n\\), the aligned source \\(j=\\bar s_{\\widetilde{\\mathcal M}}(x)\\) belongs to \\(J_x(C)\\), and\n\\[\n \\rho_x(\\widetilde{\\mathcal M})\n =\\left(\\frac{C_{ij}}{C_{xj}}\\right)_{i\\in\\mathsf O\\setminus\\{x\\}}\n \\in\\mathcal V_x(C).\n\\]\nIn particular, \\(C_{xj}\\ne0\\) and \\(\\operatorname{rank}(C_{-x,-j})=p-1\\).",
    "free_symbols": [
      "Mlaw",
      "Flaw",
      "PX",
      "mMlaw",
      "n",
      "salign",
      "x",
      "Jx",
      "C",
      "rhoLaw",
      "Obs",
      "Vfront",
      "p"
    ],
    "depends_on": [
      "ass:nonzero-columns",
      "ass:distinct-directions",
      "ass:independent-sources",
      "ass:nondegenerate-sources",
      "ass:nongaussian-sources",
      "def:law-completion-fiber",
      "def:law-aligned-source",
      "def:observed-response-vector",
      "def:response-vector-frontier",
      "def:admissible-source-set",
