{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "sampling",
    "condition": "\\(O_1,\\ldots,O_n\\) are independent and identically distributed according to \\(P_{\\mathrm{obs}}\\).",
    "free_symbols": [
      "O_i",
      "n",
      "P_{\\mathrm{obs}}"
    ],
    "standard": {
      "name": "Independent and identically distributed sampling",
      "cite": "vanDerVaart1998"
    }
  }
}