{
  "node_type": "assumption",
  "body": {
    "id": "ass:primal-slack-margin",
    "kind": "regularity",
    "condition": "\\(v_x(p_x)-G_{s,\\cdot}(p_x)q_x^*(p_x)\\geq\\kappa\\) for every \\(s\\notin\\mathcal I_x(p_x)\\) and every \\(x\\in\\mathcal X\\).",
    "free_symbols": [
      "v_x(p_x)",
      "G_x(p_x)",
      "q_x^*(p_x)",
      "\\mathcal I_x(p_x)",
      "p_x",
      "\\kappa",
      "\\mathcal X"
    ],
    "constants": [
      "\\kappa"
    ],
    "standard": {
      "name": "Uniform strict primal slackness",
      "cite": "BonnansShapiro2000Perturbation"
    }
  }
}