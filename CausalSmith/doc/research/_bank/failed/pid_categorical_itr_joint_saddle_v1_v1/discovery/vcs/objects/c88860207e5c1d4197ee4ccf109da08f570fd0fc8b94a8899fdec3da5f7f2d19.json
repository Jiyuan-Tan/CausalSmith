{
  "node_type": "definition",
  "body": {
    "id": "def:three-action-witness",
    "name": "three-action categorical-instrument witness",
    "construction": "Take one stratum, \\(\\mathcal Z=\\{0,1\\}\\), \\(\\mathcal A=\\{0,1,2\\}\\), and order each row by \\((a,y)=(0,0),(0,1),(1,0),(1,1),(2,0),(2,1)\\). Set \\(p^\\dagger_0=(1/4,0,0,1/4,0,1/2)\\) and \\(p^\\dagger_1=(1/4,0,1/4,0,0,1/2)\\). Set \\(w^\\dagger\\) to mass \\(1/4\\) on each response type \\((A(0),A(1);Y(0),Y(1),Y(2))\\) equal to \\((0,0;0,0,0)\\), \\((1,2;0,1,1)\\), \\((2,1;0,0,1)\\), and \\((2,2;0,0,1)\\), and zero elsewhere.",
    "free_symbols": [
      "p^\\dagger",
      "\\mathcal Z",
      "\\mathcal A",
      "w^\\dagger",
      "A(z)",
      "Y(a)"
    ],
    "inputs": [
      "def:response-fiber"
    ]
  }
}