{
  "node_type": "assumption",
  "body": {
    "id": "ass:active-weight-margin",
    "kind": "regularity",
    "condition": "\\(\\min\\{q_{x,a}^*(p_x):a\\in\\mathcal J_x(p_x)\\}\\wedge\\min\\{\\lambda_s:s\\in\\mathcal I_x(p_x)\\}\\geq\\kappa\\) for every \\(x\\in\\mathcal X\\).",
    "free_symbols": [
      "q_x^*(p_x)",
      "p_x",
      "\\mathcal J_x(p_x)",
      "\\lambda",
      "\\mathcal I_x(p_x)",
      "\\kappa",
      "\\mathcal X"
    ],
    "constants": [
      "\\kappa"
    ],
    "standard": {
      "name": "Uniform strict complementarity of active variables",
      "cite": "BonnansShapiro2000Perturbation"
    }
  }
}