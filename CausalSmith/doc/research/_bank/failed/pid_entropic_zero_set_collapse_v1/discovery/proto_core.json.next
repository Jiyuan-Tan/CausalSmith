{
  "qid": "pid_entropic_zero_set_collapse",
  "specialization": "v1",
  "cluster": "partialid",
  "symbols": [
    {
      "name": "I",
      "type": "fixed positive integer",
      "role": "cardinality of the first alphabet"
    },
    {
      "name": "J",
      "type": "fixed positive integer",
      "role": "cardinality of the second alphabet"
    },
    {
      "name": "d",
      "type": "fixed positive integer",
      "role": "dimension of the moment vector"
    },
    {
      "name": "k",
      "type": "fixed positive integer",
      "role": "dimension of the parameter"
    },
    {
      "name": "X",
      "type": "finite alphabet",
      "space": "\\(\\mathcal X=\\{1,\\ldots,I\\}\\)",
      "role": "first outcome alphabet",
      "refs": [
        "I"
      ]
    },
    {
      "name": "Y",
      "type": "finite alphabet",
      "space": "\\(\\mathcal Y=\\{1,\\ldots,J\\}\\)",
      "role": "second outcome alphabet",
      "refs": [
        "J"
      ]
    },
    {
      "name": "p",
      "type": "probability vector",
      "space": "\\(p\\in\\Delta_I\\)",
      "role": "first observed population marginal",
      "refs": [
        "I"
      ]
    },
    {
      "name": "q",
      "type": "probability vector",
      "space": "\\(q\\in\\Delta_J\\)",
      "role": "second observed population marginal",
      "refs": [
        "J"
      ]
    },
    {
      "name": "ptilde",
      "type": "probability vector",
      "space": "\\(\\widetilde p\\in\\Delta_I\\)",
      "role": "comparison first marginal",
      "refs": [
        "I"
      ]
    },
    {
      "name": "qtilde",
      "type": "probability vector",
      "space": "\\(\\widetilde q\\in\\Delta_J\\)",
      "role": "comparison second marginal",
      "refs": [
        "J"
      ]
    },
    {
      "name": "r",
      "type": "probability table",
      "space": "\\(r\\in\\Delta_{IJ}\\)",
      "def": "\\(r_{ij}=p_iq_j\\)",
      "role": "product coupling and KL reference",
      "refs": [
        "I",
        "J",
        "p",
        "q"
      ]
    },
    {
      "name": "Pi",
      "type": "transport polytope",
      "space": "\\(\\Pi(p,q)\\subset\\mathbb R_+^{I\\times J}\\)",
      "def": "\\(\\Pi(p,q)=\\{\\pi\\ge0:\\pi\\mathbf 1_J=p,\\ \\pi^{\\mathsf T}\\mathbf 1_I=q\\}\\)",
      "role": "compatible joint laws",
      "refs": [
        "I",
        "J",
        "p",
        "q"
      ]
    },
    {
      "name": "pi",
      "type": "coupling",
      "space": "\\(\\pi\\in\\Pi(p,q)\\)",
      "role": "generic compatible joint law",
      "refs": [
        "Pi",
        "p",
        "q"
      ]
    },
    {
      "name": "Theta",
      "type": "nonempty compact parameter set",
      "space": "\\(\\Theta\\subset\\mathbb R^k\\)",
      "role": "parameter domain",
      "refs": [
        "k"
      ]
    },
    {
      "name": "theta",
      "type": "parameter",
      "space": "\\(\\theta\\in\\Theta\\)",
      "role": "candidate structural parameter",
      "refs": [
        "Theta"
      ]
    },
    {
      "name": "thetaprime",
      "type": "parameter",
      "space": "\\(\\theta'\\in\\Theta\\)",
      "role": "comparison parameter",
      "refs": [
        "Theta"
      ]
    },
    {
      "name": "M",
      "type": "known positive real",
      "space": "\\(M<\\infty\\)",
      "role": "uniform moment bound"
    },
    {
      "name": "omega",
      "type": "known computable modulus",
      "space": "\\(\\omega:[0,\\infty)\\to[0,\\infty)\\)",
      "def": "\\(\\omega\\) is nondecreasing, \\(\\omega(0)=0\\), and \\(\\omega(t)\\downarrow0\\) as \\(t\\downarrow0\\)",
      "role": "parameter discretization control"
    },
    {
      "name": "phi",
      "type": "known vector moment table",
      "sig": "\\(\\phi:\\mathcal X\\times\\mathcal Y\\times\\Theta\\to\\mathbb R^d\\)",
      "role": "structural moment restriction",
      "refs": [
        "X",
        "Y",
        "Theta",
        "d"
      ]
    },
    {
      "name": "Cover",
      "type": "certified cover and evaluation interface",
      "sig": "\\(\\operatorname{Cover}(\\Theta,s)=\\{(\\theta_h,K_h)\\}_{h=1}^{N_s}\\)",
      "def": "\\(\\theta_h\\in\\Theta\\), \\(K_h\\subseteq\\{\\vartheta\\in\\Theta:\\|\\vartheta-\\theta_h\\|_2\\le s\\}\\), and \\(\\Theta=\\bigcup_{h=1}^{N_s}K_h\\); the interface also returns outward rational enclosures of \\(\\phi_{ij}(\\theta_h)\\) and \\(\\omega(s)\\) with finite evaluation costs",
      "role": "finite parameter covering and computable-evaluation input",
      "refs": [
        "Theta",
        "phi",
        "omega",
        "I",
        "J"
      ]
    },
    {
      "name": "moment",
      "type": "moment map",
      "sig": "\\(m_\\theta:\\Pi(p,q)\\to\\mathbb R^d\\)",
      "def": "\\(m_\\theta(\\pi)=\\sum_{i=1}^{I}\\sum_{j=1}^{J}\\pi_{ij}\\phi_{ij}(\\theta)\\)",
      "role": "coupling-indexed moment",
      "refs": [
        "theta",
        "Pi",
        "pi",
        "I",
        "J",
        "phi",
        "d"
      ]
    },
    {
      "name": "Ball",
      "type": "compact convex set",
      "space": "\\(B_d=\\{u\\in\\mathbb R^d:\\|u\\|_2\\le1\\}\\)",
      "role": "dual norm ball",
      "refs": [
        "d"
      ]
    },
    {
      "name": "u",
      "type": "direction",
      "space": "\\(u\\in B_d\\)",
      "role": "support-function direction",
      "refs": [
        "Ball"
      ]
    },
    {
      "name": "c0",
      "type": "directional unregularized value",
      "sig": "\\(c_0:B_d\\times\\Theta\\times\\Delta_I\\times\\Delta_J\\to\\mathbb R\\)",
      "def": "\\(c_0(u,\\theta;p,q)=\\min_{\\pi\\in\\Pi(p,q)}u^{\\mathsf T}m_\\theta(\\pi)\\)",
      "role": "directional OT criterion",
      "refs": [
        "u",
        "theta",
        "Pi",
        "pi",
        "moment",
        "p",
        "q"
      ]
    },
    {
      "name": "D0",
      "type": "unregularized criterion",
      "sig": "\\(D_0:\\Theta\\times\\Delta_I\\times\\Delta_J\\to[0,\\infty)\\)",
      "def": "\\(D_0(\\theta;p,q)=\\max_{u\\in B_d}c_0(u,\\theta;p,q)\\)",
      "role": "distance of the feasible moment set from zero",
      "refs": [
        "theta",
        "Ball",
        "c0",
        "p",
        "q"
      ]
    },
    {
      "name": "Theta0",
      "type": "compact identified set",
      "space": "\\(\\Theta_0(p,q)\\subseteq\\Theta\\)",
      "def": "\\(\\Theta_0(p,q)=\\{\\theta\\in\\Theta:D_0(\\theta;p,q)=0\\}\\)",
      "role": "sharp causal target",
      "refs": [
        "Theta",
        "D0",
        "p",
        "q"
      ]
    },
    {
      "name": "csep",
      "type": "known positive real",
      "space": "\\(c_{\\mathrm{sep}}>0\\)",
      "role": "separation constant"
    },
    {
      "name": "kappa",
      "type": "known positive real",
      "space": "\\(\\kappa>0\\)",
      "role": "separation exponent"
    },
    {
      "name": "epsilon",
      "type": "entropy level",
      "space": "\\(\\varepsilon\\ge0\\)",
      "role": "regularization parameter"
    },
    {
      "name": "H",
      "type": "product-relative entropy",
      "sig": "\\(H_{p,q}:\\Delta_{IJ}\\to[0,\\infty]\\)",
      "def": "\\(H_{p,q}(\\pi)=\\operatorname{KL}(\\pi\\|p\\otimes q)=\\sum_{i=1}^{I}\\sum_{j=1}^{J}\\pi_{ij}\\log(\\pi_{ij}/p_iq_j)\\), with the extended-real cell convention that a summand is zero when \\(\\pi_{ij}=p_iq_j=0\\), is \\(+\\infty\\) when \\(\\pi_{ij}>0=p_iq_j\\), and is zero when \\(\\pi_{ij}=0<p_iq_j\\). If \\(\\pi\\in\\Pi(p,q)\\) and \\(p_iq_j=0\\), transport feasibility forces \\(\\pi_{ij}=0\\), so \\(H_{p,q}\\) is finite on \\(\\Pi(p,q)\\) even when a marginal lies on the simplex boundary.",
      "role": "entropy penalty",
      "refs": [
        "I",
        "J",
        "Pi",
        "pi",
        "p",
        "q",
        "r"
      ]
    },
    {
      "name": "Depsilon",
      "type": "regularized criterion",
      "sig": "\\(D_\\varepsilon:\\Theta\\times\\Delta_I\\times\\Delta_J\\to[0,\\infty)\\)",
      "def": "\\(D_\\varepsilon(\\theta;p,q)=\\max_{u\\in B_d}\\min_{\\pi\\in\\Pi(p,q)}\\{u^{\\mathsf T}m_\\theta(\\pi)+\\varepsilon H_{p,q}(\\pi)\\}\\)",
      "role": "positive-temperature population criterion",
      "refs": [
        "epsilon",
        "theta",
        "Ball",
        "u",
        "Pi",
        "pi",
        "moment",
        "H",
        "p",
        "q"
      ]
    },
    {
      "name": "Atheta",
      "type": "compact convex coupling set",
      "space": "\\(A_\\theta(p,q)\\subseteq\\Pi(p,q)\\)",
      "def": "\\(A_\\theta(p,q)=\\operatorname*{argmin}_{\\pi\\in\\Pi(p,q)}\\|m_\\theta(\\pi)\\|_2\\)",
      "role": "unregularized minimizing set",
      "refs": [
        "theta",
        "Pi",
        "pi",
        "moment",
        "p",
        "q"
      ]
    },
    {
      "name": "Jtheta",
      "type": "nonnegative scalar functional",
      "def": "\\(J(\\theta;p,q)=\\min_{\\pi\\in A_\\theta(p,q)}H_{p,q}(\\pi)\\)",
      "role": "first-order KL selection penalty",
      "refs": [
        "theta",
        "Atheta",
        "H",
        "p",
        "q"
      ]
    },
    {
      "name": "a",
      "type": "requested certificate width",
      "space": "\\(a\\in(0,1)\\)",
      "role": "numerical tolerance"
    },
    {
      "name": "pc",
      "type": "rational probability vector",
      "space": "\\(p^{\\mathrm c}\\in\\Delta_I\\cap\\mathbb Q^I\\)",
      "role": "first computational marginal",
      "refs": [
        "I"
      ]
    },
    {
      "name": "qc",
      "type": "rational probability vector",
      "space": "\\(q^{\\mathrm c}\\in\\Delta_J\\cap\\mathbb Q^J\\)",
      "role": "second computational marginal",
      "refs": [
        "J"
      ]
    },
    {
      "name": "Pic",
      "type": "rational-marginal transport polytope",
      "space": "\\(\\Pi(p^{\\mathrm c},q^{\\mathrm c})\\)",
      "def": "\\(\\Pi(p^{\\mathrm c},q^{\\mathrm c})=\\{\\pi\\ge0:\\pi\\mathbf1_J=p^{\\mathrm c},\\ \\pi^{\\mathsf T}\\mathbf1_I=q^{\\mathrm c}\\}\\)",
      "role": "computational feasible set",
      "refs": [
        "pc",
        "qc",
        "I",
        "J"
      ]
    },
    {
      "name": "C",
      "type": "rational cost table",
      "space": "\\(C\\in\\mathbb Q^{I\\times J}\\)",
      "role": "directional finite OT input",
      "refs": [
        "I",
        "J"
      ]
    },
    {
      "name": "Rmax",
      "type": "fixed positive real",
      "space": "\\(R_{\\max}<\\infty\\)",
      "role": "uniform computational cost-oscillation bound"
    },
    {
      "name": "vC",
      "type": "unregularized rational OT value",
      "def": "\\(v_0(C;p^{\\mathrm c},q^{\\mathrm c})=\\min_{\\pi\\in\\Pi(p^{\\mathrm c},q^{\\mathrm c})}\\langle C,\\pi\\rangle\\)",
      "role": "value to be certified",
      "refs": [
        "C",
        "Pic",
        "pc",
        "qc"
      ]
    },
    {
      "name": "g",
      "type": "dual potential vector",
      "space": "\\(g\\in\\mathbb R^I\\)",
      "role": "row dual input",
      "refs": [
        "I"
      ]
    },
    {
      "name": "h",
      "type": "dual potential vector",
      "space": "\\(h\\in\\mathbb R^J\\)",
      "role": "column dual input",
      "refs": [
        "J"
      ]
    },
    {
      "name": "barpi",
      "type": "rational coupling",
      "space": "\\(\\bar\\pi\\in\\Pi(p^{\\mathrm c},q^{\\mathrm c})\\cap\\mathbb Q^{I\\times J}\\)",
      "role": "exactly repaired primal output",
      "refs": [
        "Pic",
        "pc",
        "qc",
        "I",
        "J"
      ]
    },
    {
      "name": "Bent",
      "type": "entropy envelope",
      "def": "\\(B(p^{\\mathrm c},q^{\\mathrm c})=\\min\\{\\operatorname{Ent}(p^{\\mathrm c}),\\operatorname{Ent}(q^{\\mathrm c})\\}\\)",
      "role": "uniform regularization-bias bound",
      "refs": [
        "pc",
        "qc"
      ]
    },
    {
      "name": "Qdual",
      "type": "generalized-KL dual value",
      "def": "\\(Q_\\varepsilon(g,h)=\\langle p^{\\mathrm c},g\\rangle+\\langle q^{\\mathrm c},h\\rangle-\\varepsilon\\sum_{i,j}p_i^{\\mathrm c}q_j^{\\mathrm c}\\{\\exp[(g_i+h_j-C_{ij})/\\varepsilon]-1\\}\\)",
      "role": "lower-certificate precursor",
      "refs": [
        "epsilon",
        "g",
        "h",
        "pc",
        "qc",
        "C",
        "I",
        "J"
      ]
    },
    {
      "name": "Pprimal",
      "type": "regularized primal value",
      "def": "\\(P_\\varepsilon(\\bar\\pi)=\\langle C,\\bar\\pi\\rangle+\\varepsilon\\operatorname{KL}(\\bar\\pi\\|p^{\\mathrm c}\\otimes q^{\\mathrm c})\\)",
      "role": "upper-certificate precursor",
      "refs": [
        "epsilon",
        "barpi",
        "C",
        "pc",
        "qc"
      ]
    },
    {
      "name": "ellbit",
      "type": "nonnegative integer",
      "def": "\\(\\ell_{\\mathrm{in}}\\) is the total binary encoding length of \\((p^{\\mathrm c},q^{\\mathrm c},C,a)\\)",
      "role": "input-size measure",
      "refs": [
        "pc",
        "qc",
        "C",
        "a"
      ]
    },
    {
      "name": "Lcert",
      "type": "rational scalar",
      "space": "\\(L\\in\\mathbb Q\\)",
      "role": "outward certificate lower endpoint"
    },
    {
      "name": "Ucert",
      "type": "rational scalar",
      "space": "\\(U\\in\\mathbb Q\\)",
      "role": "outward certificate upper endpoint"
    },
    {
      "name": "Transcript",
      "type": "finite rational proof object",
      "space": "\\(\\mathcal T\\)",
      "role": "independently checkable directed-arithmetic transcript"
    },
    {
      "name": "Cert",
      "type": "certificate map to be constructed",
      "sig": "\\(\\mathsf{CertSinkhorn}(p^{\\mathrm c},q^{\\mathrm c},C,a)=(L,U,\\bar\\pi,\\mathcal T)\\)",
      "role": "finite-precision outward certificate and transcript",
      "refs": [
        "pc",
        "qc",
        "C",
        "a",
        "Lcert",
        "Ucert",
        "barpi",
        "Transcript"
      ]
    },
    {
      "name": "La",
      "type": "lower bracket function",
      "sig": "\\(L_a:\\Theta\\times\\Delta_I\\times\\Delta_J\\to\\mathbb R\\)",
      "role": "outward lower criterion bracket",
      "refs": [
        "a",
        "Theta",
        "I",
        "J"
      ]
    },
    {
      "name": "Ua",
      "type": "upper bracket function",
      "sig": "\\(U_a:\\Theta\\times\\Delta_I\\times\\Delta_J\\to\\mathbb R\\)",
      "role": "outward upper criterion bracket",
      "refs": [
        "a",
        "Theta",
        "I",
        "J"
      ]
    },
    {
      "name": "Nsample",
      "type": "positive integer",
      "space": "\\(n\\ge1\\)",
      "role": "first marginal sample size"
    },
    {
      "name": "Msample",
      "type": "positive integer",
      "space": "\\(m\\ge1\\)",
      "role": "second marginal sample size"
    },
    {
      "name": "hatp",
      "type": "empirical probability vector",
      "space": "\\(\\widehat p\\in\\Delta_I\\cap\\mathbb Q^I\\)",
      "role": "first empirical marginal",
      "refs": [
        "I",
        "Nsample"
      ]
    },
    {
      "name": "hatq",
      "type": "empirical probability vector",
      "space": "\\(\\widehat q\\in\\Delta_J\\cap\\mathbb Q^J\\)",
      "role": "second empirical marginal",
      "refs": [
        "J",
        "Msample"
      ]
    },
    {
      "name": "alpha",
      "type": "confidence error probability",
      "space": "\\(\\alpha\\in(0,1)\\)",
      "role": "nominal error level"
    },
    {
      "name": "rhoalpha",
      "type": "deterministic marginal radius",
      "def": "\\(\\rho_\\alpha=I\\sqrt{\\log(2(I+J)/\\alpha)/(2n)}+J\\sqrt{\\log(2(I+J)/\\alpha)/(2m)}\\)",
      "role": "simultaneous multinomial \\(\\ell_1\\) radius",
      "refs": [
        "alpha",
        "I",
        "J",
        "Nsample",
        "Msample"
      ]
    },
    {
      "name": "Ealpha",
      "type": "sampling event",
      "def": "\\(E_\\alpha=\\{\\|\\widehat p-p\\|_1+\\|\\widehat q-q\\|_1\\le\\rho_\\alpha\\}\\)",
      "role": "common finite-sample event",
      "refs": [
        "alpha",
        "hatp",
        "p",
        "hatq",
        "q",
        "rhoalpha"
      ]
    },
    {
      "name": "scover",
      "type": "positive cover radius",
      "space": "\\(s>0\\)",
      "role": "parameter-cell radius"
    },
    {
      "name": "Kcell",
      "type": "finite family of closed cells",
      "def": "\\(\\{(\\theta_h,K_h)\\}_{h=1}^{N_s}=\\operatorname{Cover}(\\Theta,s)\\)",
      "role": "certified parameter cover",
      "refs": [
        "Cover",
        "Theta",
        "scover"
      ]
    },
    {
      "name": "Thatout",
      "type": "random closed set",
      "space": "\\(\\widehat\\Theta_{\\mathrm{out}}\\subseteq\\Theta\\)",
      "def": "\\(\\widehat\\Theta_{\\mathrm{out}}=\\bigcup\\{K_h:L_a(\\theta_h;\\widehat p,\\widehat q)\\le M\\rho_\\alpha+\\omega(s)\\}\\)",
      "role": "finite-sample outer confidence set",
      "refs": [
        "Kcell",
        "La",
        "hatp",
        "hatq",
        "M",
        "rhoalpha",
        "omega",
        "scover",
        "Theta"
      ]
    },
    {
      "name": "dH",
      "type": "Hausdorff distance",
      "sig": "\\(d_H:\\mathcal K(\\Theta)\\times\\mathcal K(\\Theta)\\to[0,\\infty)\\)",
      "role": "set-recovery loss",
      "refs": [
        "Theta"
      ]
    }
  ],
  "assumptions": [
    {
      "id": "ass:bounded-moment-table",
      "kind": "boundedness",
      "condition": "\\(\\max_{1\\le i\\le I,\\,1\\le j\\le J}\\sup_{\\theta\\in\\Theta}\\|\\phi_{ij}(\\theta)\\|_2\\le M\\)",
      "free_symbols": [
        "I",
        "J",
        "Theta",
        "theta",
        "phi",
        "M"
      ],
      "standard": {
        "name": "Uniform boundedness of a finite moment class",
        "cite": "FranguridiLiu2026"
      },
      "used_by": [
        "def:finite-moment-class",
        "thm:marginal-stability",
        "thm:finite-sample-outer-coverage"
      ]
    },
    {
      "id": "ass:effective-modulus",
      "kind": "effective-continuity",
      "condition": "\\(\\max_{1\\le i\\le I,\\,1\\le j\\le J}\\|\\phi_{ij}(\\theta)-\\phi_{ij}(\\theta')\\|_2\\le\\omega(\\|\\theta-\\theta'\\|_2)\\) for all \\(\\theta,\\theta'\\in\\Theta\\).",
      "free_symbols": [
        "I",
        "J",
        "phi",
        "theta",
        "thetaprime",
        "Theta",
        "omega"
      ],
      "novel": {
        "flag": true,
        "justification": "This effective formulation is satisfied by finite-alphabet moments built from rational polynomials, splines with certified coefficients, and elementary analytic links on rational boxes; it exposes the numerical information that empirical implementations already possess but ordinary continuity assumptions leave implicit."
      },
      "used_by": [
        "def:finite-moment-class",
        "thm:global-certified-brackets",
        "thm:finite-sample-outer-coverage"
      ]
    },
    {
      "id": "ass:nonempty-sharp-set",
      "kind": "model-correctness",
      "condition": "\\(\\Theta_0(p,q)\\ne\\varnothing\\)",
      "free_symbols": [
        "Theta0",
        "p",
        "q"
      ],
      "standard": {
        "name": "Nonempty identified set",
        "cite": "FranguridiLiu2026"
      },
      "used_by": [
        "def:finite-moment-class",
        "thm:common-event-hausdorff"
      ]
    },
    {
      "id": "ass:polynomial-separation",
      "kind": "identification-strength",
      "condition": "\\(D_0(\\theta;p,q)\\ge c_{\\mathrm{sep}}\\min\\{\\operatorname{dist}(\\theta,\\Theta_0(p,q))^\\kappa,1\\}\\) for every \\(\\theta\\in\\Theta\\).",
      "free_symbols": [
        "D0",
        "theta",
        "p",
        "q",
        "csep",
        "Theta0",
        "kappa",
        "Theta"
      ],
      "constants": [
        "csep",
        "kappa"
      ],
      "standard": {
        "name": "Polynomial minorant for a criterion-identified set",
        "cite": "ChernozhukovHongTamer2007"
      },
      "used_by": [
        "def:finite-moment-class",
        "thm:common-event-hausdorff"
      ]
    },
    {
      "id": "ass:rational-certificate-input",
      "kind": "computational-encoding",
      "condition": "\\(\\min\\{\\min_{1\\le i\\le I}p_i^{\\mathrm c},\\min_{1\\le j\\le J}q_j^{\\mathrm c}\\}>0\\).",
      "free_symbols": [
        "pc",
        "qc",
        "I",
        "J"
      ],
      "standard": {
        "name": "Positive rational matrix-scaling input",
        "cite": "vanApeldoornEtAl2021"
      },
      "used_by": [
        "oeq:finite-precision-certificate"
      ]
    },
    {
      "id": "ass:bounded-computational-cost",
      "kind": "boundedness",
      "condition": "\\(\\max_{i,j}C_{ij}-\\min_{i,j}C_{ij}\\le R_{\\max}\\).",
      "free_symbols": [
        "C",
        "I",
        "J",
        "Rmax"
      ],
      "constants": [
        "Rmax"
      ],
      "standard": {
        "name": "Bounded discrete transport cost",
        "cite": "AltschulerWeedRigollet2017"
      },
      "used_by": [
        "oeq:finite-precision-certificate"
      ]
    },
    {
      "id": "ass:multinomial-sampling",
      "kind": "sampling",
      "condition": "\\((n\\widehat p,m\\widehat q)\\sim\\operatorname{Mult}_I(n,p)\\otimes\\operatorname{Mult}_J(m,q)\\)",
