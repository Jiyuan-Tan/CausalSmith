    {
      "id": "thm:minimax-primal",
      "kind": "theorem",
      "statement": "For every \\(\\theta\\in\\Theta\\) and \\(\\varepsilon\\ge0\\), \\[D_\\varepsilon(\\theta;p,q)=\\min_{\\pi\\in\\Pi(p,q)}\\{\\|m_\\theta(\\pi)\\|_2+\\varepsilon H_{p,q}(\\pi)\\}.\\] In particular, \\(D_0(\\theta;p,q)=\\min_{\\pi\\in\\Pi(p,q)}\\|m_\\theta(\\pi)\\|_2\\).",
      "free_symbols": [
        "theta",
        "Theta",
        "epsilon",
        "Depsilon",
        "p",
        "q",
        "Pi",
        "pi",
        "moment",
        "H",
        "D0"
      ],
      "depends_on": [
        "def:moment-criterion",
        "def:regularized-criterion"
      ],
      "status": "to-prove",
      "justification": "The identity identifies the actual population criterion computed after regularizing every directional transport problem.",
      "gap": "Franguridi--Liu regularize directional support values; the displayed norm-plus-KL primal identity for their vector-moment distance is not stated there.",
      "consumer": "It lets an analyst distinguish the original sharp moment set from the population target of a positive-temperature computation."
    },
    {
      "id": "thm:zero-set-collapse",
      "kind": "theorem",
      "statement": "For every \\(p\\in\\Delta_I\\), \\(q\\in\\Delta_J\\), \\(\\theta\\in\\Theta\\), and \\(\\varepsilon>0\\), including simplex-boundary marginals, \\[D_\\varepsilon(\\theta;p,q)=0\\quad\\Longleftrightarrow\\quad m_\\theta(p\\otimes q)=0.\\] Hence \\(\\{\\theta\\in\\Theta:D_\\varepsilon(\\theta;p,q)=0\\}=\\{\\theta\\in\\Theta:m_\\theta(p\\otimes q)=0\\}\\subseteq\\Theta_0(p,q)\\), and the left-hand set is invariant over all positive entropy levels.",
      "free_symbols": [
        "epsilon",
        "Depsilon",
        "theta",
        "I",
        "J",
        "p",
        "q",
        "moment",
        "Theta",
        "Theta0"
