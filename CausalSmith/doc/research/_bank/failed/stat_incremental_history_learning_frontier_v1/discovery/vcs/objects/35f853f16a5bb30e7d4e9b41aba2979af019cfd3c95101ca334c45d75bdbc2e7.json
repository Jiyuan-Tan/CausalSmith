      "\\(\\mathcal A\\)",
      "\\(Y^{\\bar a_T}\\)",
      "\\(A_t\\)",
      "\\(T\\)"
    ],
    "standard": {
      "name": "Longitudinal consistency",
      "cite": "KimKennedyNaimi2021"
    }
  }
}