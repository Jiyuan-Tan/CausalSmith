{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-rows",
    "kind": "sampling",
    "condition": "For every \\(n\\), \\(O_{n1},\\ldots,O_{nn}\\) are independent and identically distributed with law \\(P_n\\).",
    "free_symbols": [
      "n",
      "Oni",
      "Pn"
    ],
    "standard": {
      "name": "Triangular-array i.i.d. sampling",
      "cite": "ChernozhukovChetverikovKato2014GaussianSuprema"
    }
  }
}