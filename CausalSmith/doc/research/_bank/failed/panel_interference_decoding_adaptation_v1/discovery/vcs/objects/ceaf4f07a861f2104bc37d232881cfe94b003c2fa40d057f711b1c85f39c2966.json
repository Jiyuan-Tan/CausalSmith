{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-errors",
    "kind": "empirical-process",
    "condition": "\\(\\operatorname{vec}(E_0,E_1)\\sim\\mathcal N(0,\\sigma^2I_{N(T_0+T_1)})\\).",
    "free_symbols": [
      "N",
      "T0",
      "T1",
      "sigma",
      "E0",
      "E1"
    ],
    "standard": {
      "name": "independent homoskedastic Gaussian errors",
      "cite": "NaumovSpokoinyUlyanov2017"
    }
  }
}