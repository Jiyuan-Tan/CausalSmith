    "id": "thm:honest-upper-band",
    "kind": "theorem",
    "statement": "There exists \\(C<\\infty\\) such that the exact profiled band \\((L_n,U_n)\\) belongs to \\(\\mathfrak B_{n,\\alpha}\\) and satisfies \\(\\sup_{P\\in\\mathcal M}E_{P_{\\mathrm{obs}}^{\\otimes n}}[W_n]\\le C r_n\\) for all sufficiently large \\(n\\).",
    "free_symbols": [
      "\\(L_n\\)",
      "\\(U_n\\)",
      "\\(n\\)",
      "\\(\\mathfrak B_{n,\\alpha}\\)",
      "\\(P\\)",
      "\\(\\mathcal M\\)",
      "\\(P_{\\mathrm{obs}}\\)",
      "\\(W_n\\)",
      "\\(r_n\\)"
    ],
    "depends_on": [
      "def:profiled-band",
      "def:honest-band-class",
      "def:continuous-protected-profile",
      "prop:continuous-channel-concentration",
