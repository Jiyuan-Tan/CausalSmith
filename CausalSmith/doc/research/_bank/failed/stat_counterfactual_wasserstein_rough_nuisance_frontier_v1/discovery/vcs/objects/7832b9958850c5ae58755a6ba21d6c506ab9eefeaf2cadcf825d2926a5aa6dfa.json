{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "regularity",
    "condition": "The observations \\(O_i=(X_i,A_i,Y_i)\\), \\(i=1,\\ldots,n\\), are independent and identically distributed according to \\(P\\).",
    "free_symbols": [
      "n",
      "O_i",
      "X",
      "A",
      "Y",
      "P"
    ],
    "standard": {
      "name": "Independent and identically distributed sampling",
      "cite": "KennedyBalakrishnanWasserman2023"
    }
  }
}