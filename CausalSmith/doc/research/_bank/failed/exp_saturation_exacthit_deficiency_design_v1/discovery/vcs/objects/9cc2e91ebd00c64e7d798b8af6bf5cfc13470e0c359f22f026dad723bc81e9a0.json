{
  "node_type": "assumption",
  "body": {
    "id": "ass:nondegenerate-active-slices",
    "kind": "regularity",
    "condition": "\\(\\min_{k\\in A}\\tau_k^2(P_0)\\geq\\underline\\tau^2\\).",
    "free_symbols": [
      "A",
      "\\tau_k^2",
      "P_0",
      "\\underline\\tau"
    ],
    "standard": {
      "name": "Uniform nondegeneracy of limiting contrast variances",
      "cite": "vanDerVaart1998"
    }
  }
}