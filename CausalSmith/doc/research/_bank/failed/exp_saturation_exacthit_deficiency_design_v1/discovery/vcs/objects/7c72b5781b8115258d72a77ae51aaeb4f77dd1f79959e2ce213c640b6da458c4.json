{
  "node_type": "assumption",
  "body": {
    "id": "ass:nondegenerate-all-slices",
    "kind": "regularity",
    "condition": "\\(\\min_{k\\in\\mathcal K}\\tau_k^2(P)\\geq\\underline\\tau^2\\).",
    "free_symbols": [
      "\\mathcal K",
      "\\tau_k^2",
      "P",
      "\\underline\\tau"
    ],
    "standard": {
      "name": "Uniform nondegeneracy of all reported contrast variances",
      "cite": "vanDerVaart1998"
    }
  }
}