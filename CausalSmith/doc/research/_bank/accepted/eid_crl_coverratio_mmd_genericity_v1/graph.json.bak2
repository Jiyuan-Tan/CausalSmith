      "nl": {
        "statement": "For every \\(i\\in[n]\\), \\(s_i\\,\\partial_{v_i}\\log\\{q_i(v_i)/p_i(v_i\\mid v_{\\operatorname{pa}_G(i)})\\}>0\\) throughout the closed cube.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "For every \\(i\\in[n]\\),\n\\[\ns_i\\,\\partial_{v_i}\\log\\{q_i(v_i)/p_i(v_i\\mid v_{\\operatorname{pa}_G(i)})\\}>0\n\\]\nthroughout the closed cube.",
        "frozen_title": "Fixed derivative sign"
      },
      "lean": {
        "decl_name": "CausalSmith.ExactID.EID_CrlCoverratioMmdGenericity.FixedOwnDerivativeSign",
        "file": "Basic.lean"
      },
      "review": {
        "status": "matched",
        "passed_hash": "485cb45f165f9268923718f08ebe6dbb907d10ec",
        "note": "Unfolding ownLogRatioDerivative gives exactly the within-cube own-coordinate derivative of log(q_i/p_i), multiplied by the prescribed sign and required to be strictly positive at every cube point."
      },
      "proof": {
        "state": "complete",
        "sorry_count": 0
      },
      "standard": {
        "name": "fixed-sign compact-support variant of the everywhere-change condition",
        "cite": "vonKugelgenEtAl2023UnknownInterventions",
        "citation": "J. von Kugelgen, M. Besserve, L. Wendong, L. Gresele, A. Keki\\'c, E. Bareinboim, D. M. Blei, and B. Scholkopf (2023), ``Nonparametric Identifiability of Causal Representations from Unknown Interventions,'' Advances in Neural Information Processing Systems 36."
      }
