    {
      "id": "ass:common-interior-domain",
      "obj_id": "A-10",
      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "The evaluation domain satisfies \\(\\operatorname{dist}(f^{-1}(K),\\partial[0,1]^n)\\ge\\rho\\).",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "The common interior-domain condition for \\(K\\) and radius \\(\\rho\\) is the conjunction:\n\\begin{itemize}\n\\item \\textbf{(Radius.)} \\(0<\\rho<1/2\\).\n\\item \\textbf{(Compactness.)} \\(K\\) is compact.\n\\item \\textbf{(Observed interior.)} \\(K\\subseteq \\operatorname{int}(\\mathcal X)\\), where \\(\\mathcal X=f([0,1]^n)\\).\n\\item \\textbf{(Latent boundary margin.)} For every \\(v\\in f^{-1}(K)\\),\n\\[\n\\rho\\le \\operatorname{dist}\\bigl(v,\\partial[0,1]^n\\bigr).\n\\]\n\\end{itemize}",
        "frozen_title": "Common interior domain"
