    {
      "id": "ass:one-perfect-intervention-per-node",
      "obj_id": "A-4",
      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "Besides the known observational law \\(P^0\\), the laws \\(P^1,\\ldots,P^n\\) arise from distinct unknown targets and replace exactly one \\(p_i\\) by the corresponding parent-independent density \\(q_i\\).",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "For the mechanism \\(\\theta\\), the shared mixing map \\(f\\), the observed laws \\(P^0,\\ldots,P^n\\), the target permutation \\(\\pi\\), and the supplied likelihood ratios \\(R_1,\\ldots,R_n\\), the following conditions hold:\n\\begin{itemize}\n\\item \\textbf{(Observational pushforward.)} The observational law satisfies\n\\[\nP^0\n=\nf_\\#\\bigl(p^0(v)\\,dv\\bigr),\n\\qquad\np^0(v)=\\prod_{i=1}^n p_i(v_i\\mid v_{\\operatorname{pa}_G(i)}),\n\\]\nwith \\(v\\in[0,1]^n\\).\n\\item \\textbf{(Single-target pushforwards.)} For every environment \\(e\\in[n]\\),\n\\[\nP^e\n=\nf_\\#\\bigl(p^{\\pi(e)}(v)\\,dv\\bigr),\n\\qquad\np^{\\pi(e)}(v)\n=\nq_{\\pi(e)}(v_{\\pi(e)})\n\\prod_{\\ell\\ne \\pi(e)}\np_\\ell(v_\\ell\\mid v_{\\operatorname{pa}_G(\\ell)}).\n\\]\n\\item \\textbf{(Radon--Nikodym ratios.)} For every \\(e\\in[n]\\),\n\\[\nR_e(X)=\\frac{dP^e}{dP^0}(X)\n\\quad\\text{\\(P^0\\)-almost surely.}\n\\]\n\\item \\textbf{(Latent ratio formula.)} For every \\(e\\in[n]\\) and every \\(v\\in[0,1]^n\\),\n\\[\nR_e(f(v))\n=\n\\frac{q_{\\pi(e)}(v_{\\pi(e)})}\n{p_{\\pi(e)}(v_{\\pi(e)}\\mid v_{\\operatorname{pa}_G(\\pi(e))})}.\n\\]\n\\end{itemize}",
        "frozen_title": "Perfect intervention laws"
      },
      "lean": {
        "decl_name": "CausalSmith.ExactID.EID_CrlCoverratioMmdGenericity.OnePerfectInterventionPerNode",
        "file": "Basic.lean"
      },
      "review": {
        "status": "matched",
        "passed_hash": "b7b650ae5ec08150cfbb4a76e19bb55a97d72501",
        "note": "The target permutation gives distinct unknown targets and the pushed-forward interventional laws replace exactly one p_i by q_i; the ratio conjuncts faithfully pin the globally defined R_i=dP^i/dP^0 and its latent q_i/p_i representation."
      },
      "proof": {
        "state": "complete",
        "sorry_count": 0
      },
      "standard": {
        "name": "unknown-target stochastic perfect intervention coverage",
        "cite": "vonKugelgenEtAl2023UnknownInterventions",
        "citation": "J. von Kugelgen, M. Besserve, L. Wendong, L. Gresele, A. Keki\\'c, E. Bareinboim, D. M. Blei, and B. Scholkopf (2023), ``Nonparametric Identifiability of Causal Representations from Unknown Interventions,'' Advances in Neural Information Processing Systems 36."
      }
    },
    {
