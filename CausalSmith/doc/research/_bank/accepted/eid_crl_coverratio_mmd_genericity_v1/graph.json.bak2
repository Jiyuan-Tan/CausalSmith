      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "The same map \\(f\\) is a \\(C^2\\) diffeomorphism of \\([0,1]^n\\) onto \\(\\mathcal X\\) in every environment.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "The same map \\(f\\) is a \\(C^2\\) diffeomorphism from \\([0,1]^n\\) onto \\(\\mathcal X\\) in every environment.",
