    {
      "id": "def:model-stratum",
      "obj_id": "P-1",
      "kind": "definition",
      "provenance": "from-note",
      "nl": {
        "statement": "\\(\\Theta_{G,s}=\\{((p_i,q_i))_{i=1}^{n}:\\text{ass:positive-normalized-smooth-mechanisms, ass:causal-minimality, and ass:fixed-own-derivative-sign hold for }G,s\\}\\), equipped with the relative product \\(C^2\\) topology.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "\\[\n\\Theta_{G,s}\n=\n\\left\\{\n((p_i,q_i))_{i=1}^{n}:\n\\cref{obj:ass:positive-normalized-smooth-mechanisms,obj:ass:causal-minimality,obj:ass:fixed-own-derivative-sign}\n\\text{ hold for }G\\text{ and }s\n\\right\\}.\n\\]\nThe set \\(\\Theta_{G,s}\\) is equipped with the relative product \\(C^2\\) topology.",
        "frozen_title": "Model stratum \\(\\Theta_{G,s}\\)"
