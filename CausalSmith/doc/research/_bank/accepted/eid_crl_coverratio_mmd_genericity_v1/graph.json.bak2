      "obj_id": "P-4",
      "kind": "definition",
      "provenance": "from-note",
      "nl": {
        "statement": "On \\(1\\to2\\) with node \\(3\\) isolated, set \\(h(z)=2z-1\\), \\(q_i(z)=4\\exp(4z)/(\\exp(4)-1)\\), \\(p_2(y\\mid x)=1+0.1h(x)h(y)\\), and \\(p_1=p_3=1\\); obtain other sign vectors by reflecting each coordinate \\(z\\mapsto1-z\\) when its prescribed sign is negative.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "On the graph \\(1\\to2\\) with node \\(3\\) isolated, define \\(\\theta^{\\mathrm{sp}}\\) by\n\\[\nh(z)=2z-1,\n\\]\n\\[\nq_i(z)=\\frac{4\\exp(4z)}{\\exp(4)-1},\n\\]\n\\[\np_2(y\\mid x)=1+0.1h(x)h(y),\n\\]\nand\n\\[\np_1=p_3=1.\n\\]\nFor a sign vector with a negative prescribed sign in coordinate \\(i\\), the corresponding coordinate is reflected by the map \\(z\\mapsto1-z\\).",
        "frozen_title": "Sparse witness \\(\\theta^{\\mathrm{sp}}\\)"
      },
      "lean": {
        "decl_name": "CausalSmith.ExactID.EID_CrlCoverratioMmdGenericity.sparseWitness",
