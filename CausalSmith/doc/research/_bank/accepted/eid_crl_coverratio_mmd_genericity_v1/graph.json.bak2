    {
      "id": "ass:independent-environment-sampling",
      "obj_id": "A-6",
      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "Within each environment \\(e\\), the \\(N_e\\) observations are independent draws from \\(P^e\\), and the training and evaluation folds are independent.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "The sample-split experiment is carried by a probability law, and each environment law \\(P^e\\) is a probability measure. It satisfies:\n\\begin{itemize}\n\\item \\textbf{(Training fold.)} For each environment \\(e\\), the training observations are measurable, independent within that environment, and each training observation in environment \\(e\\) has law \\(P^e\\).\n\\item \\textbf{(Evaluation fold.)} For each environment \\(e\\), the evaluation observations are measurable, independent within that environment, and each evaluation observation in environment \\(e\\) has law \\(P^e\\).\n\\item \\textbf{(Fold independence.)} The complete training fold is independent of the complete array of evaluation observations across all environments.\n\\item \\textbf{(First-stage measurability.)} For each latent coordinate \\(i\\in[n]\\) and latent state \\(x\\), the ratio estimate \\(\\widehat R_i(x)\\) is measurable with respect to the training fold, and the same estimate is jointly measurable in the training fold and \\(x\\). The training-fold event\n\\[\n\\left\\{\\omega:\\ \\forall i\\in[n],\\ \\forall e,\\ \n\\int \\left|\\widehat R_i(x)-R_i(x)\\right|\\,dP^e(x)\\le a_N(\\eta)\n\\ \\text{with finite integral}\\right\\}\n\\]\nis measurable with respect to the training fold.\n\\end{itemize}",
        "frozen_title": "Independent environment sampling"
      },
      "lean": {
        "decl_name": "CausalSmith.ExactID.EID_CrlCoverratioMmdGenericity.IndependentEnvironmentSampling",
        "file": "Helpers/Inference.lean"
      },
      "review": {
        "status": "matched",
        "passed_hash": "77309160baedccf90c5e312065ff974c0d07d73f",
        "note": "The training and evaluation arrays are independently distributed P^e draws within each environment and the complete folds are independent; the probability and measurability conjuncts make intrinsic law/measurability requirements explicit, with the fitted-ratio clauses following from the SampleSplitWorld joint-measurability contract."
      },
      "proof": {
        "state": "complete",
        "sorry_count": 0
      },
      "standard": {
        "name": "independent multi-sample sampling with sample splitting",
        "cite": "GrettonEtAl2012KernelTwoSample",
        "citation": "A. Gretton, K. M. Borgwardt, M. J. Rasch, B. Scholkopf, and A. Smola (2012), ``A Kernel Two-Sample Test,'' Journal of Machine Learning Research 13, 723--773."
      }
    },
    {
      "id": "ass:bounded-holder-radius",
      "obj_id": "A-7",
      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "Every \\(p_i\\), \\(q_i\\), and latent-coordinate log-ratio \\(L_i\\circ f\\) has Holder norm of order \\(\\beta\\) at most \\(M\\).",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "Let \\(k=\\lfloor \\beta\\rfloor\\). The parameters satisfy \\(2<\\beta\\) and \\(1<M\\). For every \\(i\\in[n]\\), the three functions\n\\[\np_i,\\qquad q_i,\\qquad v\\mapsto L_i(f(v))\n\\]\nsatisfy the common Hölder bound of order \\(\\beta\\) and radius \\(M\\) on their respective domains: \\(p_i\\) and \\(v\\mapsto L_i(f(v))\\) on \\([0,1]^n\\), and \\(q_i\\) on \\([0,1]\\). That is, for each such function \\(r\\) with domain \\(K\\), \\(r\\) is \\(C^k\\) on \\(K\\),\n\\[\n\\|D^m r(z)\\|\\le M\n\\]\nfor every \\(m\\le k\\) and every \\(z\\in K\\), and\n\\[\n\\|D^k r(z)-D^k r(z')\\|\\le M\\|z-z'\\|^{\\beta-k}\n\\]\nfor every \\(z,z'\\in K\\).",
        "frozen_title": "Bounded Hölder radius"
      },
      "lean": {
        "decl_name": "CausalSmith.ExactID.EID_CrlCoverratioMmdGenericity.BoundedHolderRadius",
        "file": "Helpers/BoundedSubclass.lean"
      },
      "review": {
        "status": "unreviewed",
        "passed_hash": null
      },
      "proof": {
        "state": "complete",
        "sorry_count": 0
      },
      "standard": {
        "name": "bounded Holder ball",
        "cite": "Xie2023UniformConditionalCDF",
        "citation": "H. Xie (2023), ``Uniform Convergence Results for the Local Linear Regression Estimation of the Conditional Distribution,'' Statistics and Probability Letters 201, 109886."
      }
    },
    {
      "id": "ass:density-lower-envelope",
      "obj_id": "A-8",
      "kind": "assumption",
      "provenance": "from-note",
      "nl": {
        "statement": "Every \\(p_i\\) and \\(q_i\\) is bounded below by \\(c\\) on its closed cube.",
        "tex_anchor": "",
        "frozen": true,
        "frozen_body": "For the bounded regime under consideration, the lower-envelope constant \\(c\\) satisfies:\n\\begin{itemize}\n\\item \\textbf{(Range.)} \\(0<c<1\\).\n\\item \\textbf{(Observational densities.)} For every \\(i\\in[n]\\) and every latent state \\(v\\in[0,1]^n\\),\n\\[\nc\\le p_i(v_i\\mid v_{\\operatorname{pa}_G(i)}).\n\\]\n\\item \\textbf{(Intervention densities.)} For every \\(i\\in[n]\\) and every \\(z\\in[0,1]\\),\n\\[\nc\\le q_i(z).\n\\]\n\\end{itemize}",
