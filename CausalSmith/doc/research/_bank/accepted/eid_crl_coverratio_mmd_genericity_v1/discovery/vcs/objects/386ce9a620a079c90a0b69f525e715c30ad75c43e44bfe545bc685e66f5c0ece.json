{
  "node_type": "assumption",
  "body": {
    "id": "ass:bounded-holder-radius",
    "kind": "smoothness",
    "condition": "Every \\(p_i\\), \\(q_i\\), and latent-coordinate log-ratio \\(L_i\\circ f\\) has Holder norm of order \\(\\beta\\) at most \\(M\\).",
    "free_symbols": [
      "\\(p_i\\)",
      "\\(q_i\\)",
      "f",
      "\\(L_i\\)",
      "\\(\\beta\\)",
      "M"
    ],
    "standard": {
      "name": "bounded Holder ball",
      "cite": "Xie2023UniformConditionalCDF"
    }
  }
}