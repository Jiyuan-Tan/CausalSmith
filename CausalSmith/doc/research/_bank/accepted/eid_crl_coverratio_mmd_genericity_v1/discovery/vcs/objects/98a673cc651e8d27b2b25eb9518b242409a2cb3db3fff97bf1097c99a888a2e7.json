{
  "node_type": "assumption",
  "body": {
    "id": "ass:observed-log-ratio-regularity",
    "kind": "smoothness",
    "condition": "The observed log-ratios obey \\(\\max_{i\\in[n]}\\|L_i\\|_{C^2(K)}\\le M\\).",
    "free_symbols": [
      "\\([n]\\)",
      "\\(L_i\\)",
      "\\(K\\)",
      "M"
    ],
    "standard": {
      "name": "uniformly bounded smooth generated regressors on an interior compactum",
      "cite": "MammenRotheSchienle2012GeneratedCovariates"
    }
  }
}