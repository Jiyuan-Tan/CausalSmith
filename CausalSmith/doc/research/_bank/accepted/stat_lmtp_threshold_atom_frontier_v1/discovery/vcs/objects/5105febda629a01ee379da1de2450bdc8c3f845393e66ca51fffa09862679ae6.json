    "id": "def:continuity-clamp-functional",
    "name": "Continuity-only observed clamp functional",
    "construction": "For \\(P\\in\\mathcal M_{\\mathrm{cont}}\\) and \\(0\\leq\\delta\\leq\\bar\\delta\\), define\n\\[\n \\theta_{\\delta,\\mathrm{cont}}(P)\n =\\mathbb E_P[Y\\mathbf 1\\{A>\\delta\\}]\n +\\sum_{x\\in\\mathcal X}p_xq_x(\\delta)\\mu_{x,\\mathrm{cont}}^P(\\delta).\n\\]",
    "free_symbols": [
      "P",
      "mathcal_M_cont",
      "delta_bar",
      "theta_delta_cont",
      "Y",
      "A",
      "mathcal_X",
      "p_x",
      "q_x",
      "mu_x_cont_P"
    ],
    "inputs": [
      "P",
      "delta_n"
    ]
  }
}