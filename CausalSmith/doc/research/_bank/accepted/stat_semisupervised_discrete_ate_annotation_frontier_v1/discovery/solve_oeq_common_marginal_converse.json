    {
      "id": "def:frontier-rate-handle",
      "proposed": {
        "tex_ref": "rate-definition"
      },
      "reason": "The upper and common-marginal lower proofs optimize the unequal information budgets and give this closed rate; no optimization over a law remains.",
      "direction": "correct"
    },
    {
      "id": "def:mixed-estimator-handle",
      "proposed": {
        "tex_ref": "estimator-definition"
      },
      "reason": "This replaces the construction handle by the total finite-sample estimator used in the proved upper bound, including its pilot buffer and derandomized Poisson prefixes.",
      "direction": "correct"
    },
    {
      "id": "def:common-marginal-prior-handle",
      "proposed": {
        "tex_ref": "prior-definition"
      },
      "reason": "This replaces the prior handle by the normalized finite-atom priors whose full random treatment--covariate table is identical under both hypotheses and whose raw Poisson channel admits label-gated cancellation.",
      "direction": "correct"
    }
  ],
