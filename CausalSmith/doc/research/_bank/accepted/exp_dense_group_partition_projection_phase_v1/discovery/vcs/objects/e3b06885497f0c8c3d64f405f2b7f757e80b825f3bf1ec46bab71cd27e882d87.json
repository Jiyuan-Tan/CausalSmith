{
  "node_type": "assumption",
  "body": {
    "id": "ass:scaled-variance-nondegeneracy",
    "kind": "regularity",
    "condition": "\\(\\liminf_{n\\to\\infty}G_n\\sigma_n^2\\ge c_\\sigma\\).",
    "free_symbols": [
      "n",
      "G_n",
      "\\sigma_n^2",
      "c_\\sigma"
    ],
    "standard": {
      "name": "Nondegenerate scaled design variance",
      "cite": "LiDing2017"
    }
  }
}