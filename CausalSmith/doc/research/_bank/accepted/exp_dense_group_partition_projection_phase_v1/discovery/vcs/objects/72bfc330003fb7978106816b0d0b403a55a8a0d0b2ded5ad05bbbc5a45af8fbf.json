{
  "node_type": "symbol",
  "body": {
    "name": "s_{z,n}^2",
    "type": "within-arm sample variance of observed group means",
    "space": "\\([0,\\infty)\\)",
    "def": "\\(s_{z,n}^2=(G_{zn}-1)^{-1}\\sum_{g:Z_{ng}=z}(H^{\\mathrm{obs}}_{ng}-\\bar H_{z,n})^2\\), where \\(G_{zn}=G_{1n}\\) for \\(z=1\\), \\(G_{zn}=G_{0n}\\) for \\(z=0\\), and \\(\\bar H_{z,n}=G_{zn}^{-1}\\sum_{g:Z_{ng}=z}H^{\\mathrm{obs}}_{ng}\\).",
    "role": "arm dispersion statistic",
    "refs": [
      "G_n",
      "G_{1n}",
      "G_{0n}",
      "\\mathbf Z_n",
      "H^{\\mathrm{obs}}_{ng}",
      "\\mathcal Z"
    ]
  }
}