    "name": "I_{n,\\alpha}^{\\mathrm{CR2}}",
    "type": "normal CR2 Wald interval",
    "space": "\\(2^{\\mathbb R}\\)",
    "def": "\\(I_{n,\\alpha}^{\\mathrm{CR2}}=[\\widehat\\tau_n-z_{1-\\alpha/2}\\sqrt{\\widehat V_{\\mathrm{CR2},n}},\\widehat\\tau_n+z_{1-\\alpha/2}\\sqrt{\\widehat V_{\\mathrm{CR2},n}}]\\).",
    "role": "confidence interval",
    "refs": [
      "\\alpha",
      "\\widehat\\tau_n",
      "\\widehat V_{\\mathrm{CR2},n}"
