{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "sampling",
    "condition": "For each \\(\\mathbb P\\in\\mathcal D_{d,\\epsilon}^{\\mathrm{obs}}\\), \\(O_1,\\ldots,O_n\\) are independent and have common law \\(\\mathbb P\\).",
    "free_symbols": [
      "\\(\\mathbb P\\)",
      "\\(\\mathcal D_{d,\\epsilon}^{\\mathrm{obs}}\\)",
      "\\(O_i\\)",
      "\\(n\\)"
    ],
    "standard": {
      "name": "independent and identically distributed sampling",
      "cite": "ZengBalakrishnanHanKennedy2024Discrete"
    }
  }
}