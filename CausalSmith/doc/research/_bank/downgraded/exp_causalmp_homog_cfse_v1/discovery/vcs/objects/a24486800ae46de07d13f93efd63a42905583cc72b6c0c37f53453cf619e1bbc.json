{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-residual-margin",
    "kind": "uniform Schur-residual margin",
    "condition": "\\(\\inf_{Q\\in\\mathcal K}\\min_{0\\le t<T}[\\rho_t]_Q\\ge2\\underline\\rho\\).",
    "free_symbols": [
      "Q",
      "\\mathcal K",
      "t",
      "T",
      "\\rho_t",
      "[\\cdot]_Q",
      "\\underline\\rho"
    ],
    "standard": {
      "name": "Uniform interior-pivot separation",
      "cite": "NeweyMcFadden1994LargeSample"
    }
  }
}