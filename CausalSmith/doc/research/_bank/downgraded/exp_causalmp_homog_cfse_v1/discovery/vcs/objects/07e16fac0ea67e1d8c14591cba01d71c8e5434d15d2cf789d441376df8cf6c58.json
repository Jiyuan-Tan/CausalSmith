{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-gram-margin",
    "kind": "uniform Gram margin",
    "condition": "\\(\\inf_{Q\\in\\mathcal K}\\min_{1\\le t<T}\\lambda_{\\min}([K_{D_t^{\\star}D_t^{\\star}}]_Q)\\ge2\\underline\\kappa\\).",
    "free_symbols": [
      "Q",
      "\\mathcal K",
      "t",
      "T",
      "K",
      "D_t^{\\star}",
      "[\\cdot]_Q",
      "\\underline\\kappa"
    ],
    "standard": {
      "name": "Uniform nonsingularity of finite Gram blocks",
      "cite": "NeweyMcFadden1994LargeSample"
    }
  }
}