{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-envelope-moment",
    "kind": "uniform envelope moment",
    "condition": "\\(\\sup_{Q\\in\\mathcal K}P_{\\xi,Q}[\\mathcal E_T^{2+\\delta_{\\mathrm{mom}}}]\\le B_{\\mathcal E}\\).",
    "free_symbols": [
      "Q",
      "\\mathcal K",
      "P_{\\xi,Q}",
      "\\mathcal E_T",
      "\\delta_{\\mathrm{mom}}",
      "B_{\\mathcal E}"
    ],
    "standard": {
      "name": "Uniform integrable-envelope moment condition",
      "cite": "VanDerVaartWellner1996WeakConvergence"
    }
  }
}