{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-identification",
    "kind": "uniform identification separation",
    "condition": "\\(\\inf_{Q\\in\\mathcal K}\\inf_{\\beta\\in\\mathcal B:\\|\\beta-\\beta_{0,Q}\\|\\ge\\varepsilon_{\\mathrm{id}}}\\|\\mathfrak r_Q(\\beta)\\|\\ge c_{\\mathrm{id}}\\).",
    "free_symbols": [
      "Q",
      "\\mathcal K",
      "\\mathcal B",
      "\\beta",
      "\\beta_{0,Q}",
      "\\varepsilon_{\\mathrm{id}}",
      "\\mathfrak r_Q(\\beta)",
      "c_{\\mathrm{id}}"
    ],
    "standard": {
      "name": "Uniformly separated minimum-distance zero",
      "cite": "NeweyMcFadden1994LargeSample"
    }
  }
}