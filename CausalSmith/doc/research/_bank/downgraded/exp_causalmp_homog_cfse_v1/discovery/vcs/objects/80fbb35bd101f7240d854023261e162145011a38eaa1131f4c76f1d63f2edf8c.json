{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-chart-interior",
    "kind": "uniform parameter interior",
    "condition": "\\(\\inf_{Q\\in\\mathcal K}\\operatorname{dist}(\\beta_{0,Q},\\partial\\mathcal B)\\ge\\varepsilon_{\\mathcal B}\\).",
    "free_symbols": [
      "Q",
      "\\mathcal K",
      "\\beta_{0,Q}",
      "\\mathcal B",
      "\\varepsilon_{\\mathcal B}"
    ],
    "standard": {
      "name": "Uniform interiority of a finite-dimensional parameter",
      "cite": "NeweyMcFadden1994LargeSample"
    }
  }
}