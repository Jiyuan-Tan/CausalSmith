{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-blocks",
    "kind": "sampling",
    "condition": "\\(\\operatorname{vec}(E,e,f)\\sim\\mathcal N(0,\\sigma^2 I_{n^2+2n})\\)",
    "free_symbols": [
      "E",
      "e",
      "f",
      "sigma",
      "n"
    ],
    "standard": {
      "name": "independent homoskedastic Gaussian block noise",
      "cite": "YanWainwright2024"
    }
  }
}