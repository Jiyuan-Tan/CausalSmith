{
  "node_type": "definition",
  "body": {
    "id": "def:local-neighborhood",
    "name": "Interior local Kullback--Leibler neighborhood",
    "construction": "For \\(P=P_{A,u,v}\\) and \\(Q=P_{A_Q,u_Q,v_Q}\\), \\(\\operatorname{KL}(P,Q)=[\\|A-A_Q\\|_{\\mathrm F}^2+\\|u-u_Q\\|_2^2+\\|v-v_Q\\|_2^2]/(2\\sigma^2)\\) and \\(\\mathcal N_n(P)=\\{Q\\in\\mathcal P_n:\\operatorname{KL}(P,Q)\\le1\\}\\)",
    "free_symbols": [
      "P",
      "Q",
      "A",
      "u",
      "v",
      "KL",
      "sigma",
      "Nloc",
      "calP",
      "n"
    ],
    "inputs": [
      "calP",
      "sigma"
    ]
  }
}