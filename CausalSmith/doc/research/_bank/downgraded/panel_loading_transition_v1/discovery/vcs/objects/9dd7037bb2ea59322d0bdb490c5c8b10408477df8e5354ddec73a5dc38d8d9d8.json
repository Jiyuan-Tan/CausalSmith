  "body": {
    "id": "def:analytic-halfwidth",
    "name": "Analytic Gaussian outer half-width \\(W_n\\)",
    "construction": "\\(\\widehat\\theta_n=\\sigma^2Z_{p,n}^{\\top}D_nZ_{q,n}\\), \\(h_n=\\|D_n\\|_{\\mathrm{op}}\\), \\(s_{Z,n}=\\sqrt{\\|D_nZ_{q,n}\\|_2^2+\\|D_n^{\\top}Z_{p,n}\\|_2^2}\\), \\(t_{Z,n}=s_{Z,n}/h_n\\), \\(R_{0,n}=\\sqrt{C_{r,\\alpha}\\log(e+2t_{Z,n}+A_{r,\\alpha})}\\), \\(t_{-,n}=\\max\\{0,t_{Z,n}-R_{0,n}\\}\\), \\(t_{+,n}=t_{Z,n}+R_{0,n}\\), and \\(W_n=h_n[\\zeta_\\alpha(t_{-,n})t_{+,n}+C_{r,\\alpha}\\log(e+t_{+,n})/2]\\)",
    "free_symbols": [
      "n",
      "thetahat",
      "sigma",
