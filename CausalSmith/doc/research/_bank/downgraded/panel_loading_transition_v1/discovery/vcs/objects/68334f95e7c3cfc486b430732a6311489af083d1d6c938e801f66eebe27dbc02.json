    "id": "def:donor-allowance",
    "name": "Observable donor allowance \\(d_n\\)",
    "construction": "Let \\(A_\\xi=\\sqrt{r_0}+\\sqrt{12}\\), \\(A_\\gamma=\\sigma(r_0+\\sqrt{12})\\), \\(C_T=3A_\\gamma/(2c^2)+54\\sigma^2/c^3\\), \\(K_0=9A_\\xi^2C_T/8\\), and \\(\\ell_n=\\log(e+n)\\); then \\(d_n=K_0\\sigma^2\\ell_n n^{-2}(\\|Z_{p,n}\\|_2+\\sqrt{\\ell_n})(\\|Z_{q,n}\\|_2+\\sqrt{\\ell_n})\\)",
    "free_symbols": [
      "Axi",
      "r0",
      "Agamma",
      "sigma",
      "CT",
      "c",
      "K0",
      "ell",
      "n",
      "d",
      "Zp",
      "Zq"
    ],
