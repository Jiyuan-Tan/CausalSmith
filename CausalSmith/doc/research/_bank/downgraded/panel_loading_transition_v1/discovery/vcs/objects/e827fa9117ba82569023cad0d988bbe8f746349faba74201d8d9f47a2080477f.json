  "body": {
    "id": "def:calibration",
    "name": "Localized Gaussian calibration",
    "construction": "For \\(t\\ge0\\), \\(\\beta_\\alpha(t)=\\alpha/[4(1+t)]\\), \\(\\rho_\\alpha(t)=\\sqrt{F^{-1}_{\\chi^2_{2r}}(1-\\beta_\\alpha(t))}\\), \\(\\zeta_\\alpha(t)=\\Phi^{-1}(1-[\\alpha-\\beta_\\alpha(t)]/2)\\), \\(C_{r,\\alpha}=4r+3\\log(4/\\alpha)+3\\), and \\(A_{r,\\alpha}=\\max\\{2,4C_{r,\\alpha}\\}\\)",
    "free_symbols": [
      "beta",
      "alpha",
      "rho",
      "Fchi",
      "r",
      "zeta",
      "Phi",
      "Cr",
      "Ar"
    ],
    "inputs": [
      "alpha",
      "r"
    ]
  }
}