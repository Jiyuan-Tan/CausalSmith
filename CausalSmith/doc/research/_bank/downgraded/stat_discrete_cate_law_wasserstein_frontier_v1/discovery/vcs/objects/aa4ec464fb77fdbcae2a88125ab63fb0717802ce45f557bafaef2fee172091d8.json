{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "sampling",
    "condition": "The observations \\(O_1,\\ldots,O_n\\) are independent with common law equal to the observed margin of \\(P\\).",
    "free_symbols": [
      "\\(O_i\\)",
      "\\(n\\)",
      "\\(P\\)"
    ],
    "standard": {
      "name": "Independent and identically distributed sampling",
      "cite": "vanDerVaart1998"
    }
  }
}