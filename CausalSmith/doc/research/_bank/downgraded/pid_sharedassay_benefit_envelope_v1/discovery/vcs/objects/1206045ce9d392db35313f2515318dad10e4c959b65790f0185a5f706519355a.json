  "body": {
    "id": "lem:hoeffding-binomial-deviation",
    "kind": "lemma",
    "statement": "If \\(X\\sim\\operatorname{Bin}(N,p)\\), \\(N\\geq1\\), and \\(t>0\\), then\n\\[\n \\Pr_p\\{X/N-p\\geq t\\}\\leq \\exp(-2Nt^2),\n \\qquad\n \\Pr_p\\{p-X/N\\geq t\\}\\leq \\exp(-2Nt^2).\n\\]",
    "free_symbols": [],
    "depends_on": [],
    "source": {
      "cite": "Hoeffding1963",
      "locator": "Theorem 2, equation (2.3), specialized to independent Bernoulli summands",
      "carrier": "logical-claim",
