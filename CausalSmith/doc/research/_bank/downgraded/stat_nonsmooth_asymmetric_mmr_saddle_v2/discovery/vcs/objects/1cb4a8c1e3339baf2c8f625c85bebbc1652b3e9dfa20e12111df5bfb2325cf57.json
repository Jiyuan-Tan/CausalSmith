    "id": "def:coexistence-witness",
    "name": "Two-dimensional coexistence witness",
    "construction": "Take \\(H_0=\\operatorname{conv}\\{(-1,-1),(1,-1),(0,1)\\}\\), \\(\\Sigma=I_2\\), \\(\\ell_0(h)=-4/3+\\lVert h\\rVert_{\\infty}\\), \\(u_0(h)=4/3-\\lVert h\\rVert_{\\infty}\\), \\(\\delta_0(z)=1/2\\), and \\(\\delta_{\\eta}(z)=1/2+\\eta\\tanh(z_1)\\tanh(z_2)\\) for \\(0<\\eta\\le1/2\\).",
    "free_symbols": [
      "\\(H_0\\)",
      "\\(\\Sigma\\)",
      "\\(\\ell_0\\)",
      "\\(u_0\\)",
      "\\(\\delta_0\\)",
      "\\(\\delta_{\\eta}\\)",
      "\\(\\eta\\)"
    ]
  }
