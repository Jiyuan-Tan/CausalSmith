{
  "node_type": "assumption",
  "body": {
    "id": "ass:treatment-odds-upper",
    "kind": "sensitivity",
    "condition": "For every \\(x\\in\\mathcal X\\), \\(\\zeta_{1,1,x}\\zeta_{0,0,x}\\leq\\Gamma_A\\zeta_{1,0,x}\\zeta_{0,1,x}\\).",
    "free_symbols": [
      "x",
      "Xspace",
      "zeta",
      "GammaA"
    ],
    "standard": {
      "name": "Upper side of the two-sided Rosenbaum--Rubin treatment log-odds bound",
      "cite": "RosenbaumRubin1983Sensitivity"
    }
  }
}