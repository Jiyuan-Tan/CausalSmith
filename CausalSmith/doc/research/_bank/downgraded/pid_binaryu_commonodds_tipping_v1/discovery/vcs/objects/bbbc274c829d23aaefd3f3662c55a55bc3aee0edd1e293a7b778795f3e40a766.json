{
  "node_type": "assumption",
  "body": {
    "id": "ass:outcome-odds-lower",
    "kind": "sensitivity",
    "condition": "For every \\(a\\in\\{0,1\\}\\) and \\(x\\in\\mathcal X\\), \\(\\eta_{a,1,0,x}\\eta_{a,0,1,x}\\leq\\Gamma_a\\eta_{a,1,1,x}\\eta_{a,0,0,x}\\).",
    "free_symbols": [
      "a",
      "x",
      "Xspace",
      "eta",
      "GammaOutcome"
    ],
    "standard": {
      "name": "Lower side of a treatment-specific Rosenbaum--Rubin outcome log-odds bound",
      "cite": "RosenbaumRubin1983Sensitivity"
    }
  }
}