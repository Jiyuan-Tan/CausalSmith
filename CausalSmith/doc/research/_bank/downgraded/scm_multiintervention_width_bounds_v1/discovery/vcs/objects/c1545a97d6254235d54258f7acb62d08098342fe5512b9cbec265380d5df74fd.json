  "body": {
    "id": "prop:low-component-reductions",
    "kind": "proposition",
    "statement": "For every \\(I\\in\\mathfrak J_{q,k}\\), exact substitution of the observational component kernels for every intervention-untouched original block produces an equivalent canonical program. If the intervention touches exactly one original block, the reduced objective is linear and reproduces the one-component linear program of Shridharan--Iyengar. If it touches exactly two original blocks, the reduced objective is block-bilinear, hence quadratic after scalar expansion, and reproduces their two-component quadratic program. The headline domain is exactly \\(\\mathfrak I_{q,k}^{\\ge3}=\\{I\\in\\mathfrak J_{q,k}:a\\text{ touches at least three blocks in }C\\}\\).",
    "free_symbols": [
      "I",
      "InputClassAll",
      "InputClass",
      "q",
      "k",
      "a",
      "C",
      "g",
      "bc",
      "SIPrograms"
    ],
    "depends_on": [
      "ass:block-affine-query",
      "def:canonical-input-superclass",
