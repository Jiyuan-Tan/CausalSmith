  "node_type": "assumption",
  "body": {
    "id": "ass:cell-margin-convergence",
    "kind": "regularity",
    "condition": "The finite assignment-cell marginal table satisfies \\(\\max_{z\\in Zspace,w\\in Wgrid}|f_{C,z,w}-f_{z,w}|\\to0\\) as \\(C\\to\\infty\\).",
    "free_symbols": [
      "C",
      "Zspace",
      "Wgrid",
      "fC",
      "f"
    ],
    "standard": {
      "name": "Finite-population marginal convergence",
      "cite": "AronowGreenLee2014"
    }
  }
}