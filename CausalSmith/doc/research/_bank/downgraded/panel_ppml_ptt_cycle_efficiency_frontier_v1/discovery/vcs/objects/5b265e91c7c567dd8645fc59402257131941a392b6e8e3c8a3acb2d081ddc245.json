    "name": "xiHatMK",
    "type": "Moreau--Kastler untreated individual fixed-effects PPML fit",
    "space": "\\(\\mathbb R^{\\sum_{g\\in C}n_g+T-1}\\)",
    "def": "\\(\\widehat\\xi_{\\mathrm{MK}}=((\\widehat\\alpha^{\\mathrm{MK}}_{gi})_{g\\in C,1\\le i\\le n_g},(\\widehat\\lambda^{\\mathrm{MK}}_t)_{t=2}^T)\\) maximizes \\(\\sum_{g\\in C}\\sum_{i=1}^{n_g}\\sum_{t<g}[Y_{git}(\\alpha_{gi}+\\lambda_t)-\\exp(\\alpha_{gi}+\\lambda_t)]\\) with \\(\\lambda_1=0\\)",
    "refs": [
      "Y",
      "U",
      "C",
      "ng",
      "T"
    ]
  }
