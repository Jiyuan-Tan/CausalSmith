{
  "node_type": "assumption",
  "body": {
    "id": "ass:bounded-support",
    "kind": "support",
    "condition": "\\(\\max_{g\\in C,1\\le t\\le T}Y_{gt}\\le M_0<\\infty\\) almost surely",
    "free_symbols": [
      "Y",
      "C",
      "T"
    ],
    "constants": [
      "\\(M_0\\in(0,\\infty)\\)"
    ],
    "standard": {
      "name": "common bounded support",
      "cite": "Newey1990"
    }
  }
}