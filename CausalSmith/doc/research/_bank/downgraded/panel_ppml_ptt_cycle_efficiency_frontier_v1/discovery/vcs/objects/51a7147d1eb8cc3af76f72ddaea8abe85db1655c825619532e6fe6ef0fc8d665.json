  "body": {
    "id": "thm:efficient-attainment",
    "kind": "theorem",
    "statement": "The covariance-weighted cycle estimator satisfies \\(\\sqrt N(\\widehat\\theta_{\\mathrm{eff}}-\\theta_{\\mathrm{PTT}})=N^{-1/2}\\sum_{i=1}^N\\phi_i^{\\star}+o_P(1)\\) and attains \\(V^{\\star}\\) pointwise over \\(\\mathcal M_4\\).",
    "free_symbols": [
      "N",
      "thetaHatEff",
      "theta",
      "phistar",
      "Vstar",
      "M4"
    ],
    "depends_on": [
      "def:efficient-estimator",
      "def:canonical-gradient",
      "ass:finite-fourth-moments",
      "ass:covariance-interior",
      "thm:canonical-gradient",
      "lem:cohort-mean-ppml-linearization",
      "lem:fixed-strata-central-limit",
