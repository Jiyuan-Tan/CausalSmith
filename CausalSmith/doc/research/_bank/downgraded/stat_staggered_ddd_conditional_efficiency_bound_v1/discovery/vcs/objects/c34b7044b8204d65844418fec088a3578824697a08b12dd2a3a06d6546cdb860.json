{
  "node_type": "assumption",
  "body": {
    "id": "ass:cell-overlap",
    "kind": "regularity",
    "condition": "\\(p_{a,s}(X)\\ge\\varepsilon\\) almost surely for every cohort--eligibility cell \\((a,s)\\) used by at least one coordinate in \\(\\mathcal I\\).",
    "free_symbols": [
      "p",
      "X",
      "calI"
    ],
    "constants": [
      "\\(\\varepsilon\\in(0,1)\\) is fixed"
    ],
    "standard": {
      "name": "Uniform retained-cell overlap",
      "cite": "OrtizVillavicencioSantAnna2025"
    }
  }
}