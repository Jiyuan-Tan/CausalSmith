{
  "node_type": "assumption",
  "body": {
    "id": "ass:conditional-fourth-envelope",
    "kind": "regularity",
    "condition": "For every retained cohort--eligibility cell \\((a,s)\\) and every \\(u\\in\\{2,\\ldots,T\\}\\), \\(E_P[|\\Delta Y_u|^4\\mid G=a,S=s,X]\\le C_{4,c}\\) almost surely.",
    "free_symbols": [
      "P",
      "DeltaY",
      "X",
      "G",
      "S",
      "T",
      "calI"
    ],
    "constants": [
      "\\(C_{4,c}<\\infty\\) is fixed"
    ],
    "standard": {
      "name": "Uniform conditional fourth-moment envelope",
      "cite": "ChernozhukovEtAl2018DML"
    }
  }
}