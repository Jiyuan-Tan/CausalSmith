{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-fixed-panel",
    "kind": "sampling",
    "condition": "\\((O_i)_{i=1}^n\\) are independent and identically distributed from \\(P\\), while \\(T\\) is fixed as \\(n\\to\\infty\\).",
    "free_symbols": [
      "On",
      "O",
      "n",
      "P",
      "T"
    ],
    "standard": {
      "name": "Large-\\(n\\), fixed-\\(T\\) panel sampling",
      "cite": "OrtizVillavicencioSantAnna2025"
    }
  }
}