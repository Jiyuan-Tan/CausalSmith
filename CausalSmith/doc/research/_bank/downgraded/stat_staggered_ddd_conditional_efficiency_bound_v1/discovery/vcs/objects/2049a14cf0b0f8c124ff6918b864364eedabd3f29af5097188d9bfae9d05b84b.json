{
  "node_type": "assumption",
  "body": {
    "id": "ass:fixed-contrast-rank",
    "kind": "operator regularity",
    "condition": "\\(\\operatorname{rank}H(X)=r_0\\) almost surely.",
    "free_symbols": [
      "H",
      "X"
    ],
    "constants": [
      "\\(r_0\\) is a fixed nonnegative integer"
    ],
