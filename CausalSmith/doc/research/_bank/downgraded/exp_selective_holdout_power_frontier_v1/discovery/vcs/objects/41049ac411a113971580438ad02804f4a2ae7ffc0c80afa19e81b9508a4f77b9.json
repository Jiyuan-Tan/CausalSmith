{
  "node_type": "assumption",
  "body": {
    "id": "ass:positive-shares",
    "kind": "asymptotic-design",
    "condition": "For every \\((k,s)\\in K\\times S\\), \\(N_{nks}/n\\to r_{ks}\\) uniformly with \\(\\min_{k,s}r_{ks}>0\\).",
    "free_symbols": [
      "N",
      "n",
      "rshare",
      "K",
      "S"
    ],
    "standard": {
      "name": "stable treatment-group proportions",
      "cite": "LiDing2017FinitePopulationCLT"
    }
  }
}