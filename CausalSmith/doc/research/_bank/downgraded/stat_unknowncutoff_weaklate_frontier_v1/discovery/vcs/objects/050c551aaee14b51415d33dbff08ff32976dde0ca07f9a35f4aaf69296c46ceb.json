{
  "node_type": "assumption",
  "body": {
    "id": "ass:observable-outcome-variance-floor",
    "kind": "variance",
    "condition": "For each \\(\\ell\\in\\{-,+\\}\\) and every \\(x\\) on side \\(\\ell\\) of \\(c_P\\), \\(\\operatorname{Var}_P(Y\\mid X=x,\\ell)\\ge v\\).",
    "free_symbols": [
      "P",
      "Y",
      "X",
      "c_P",
      "v"
    ],
    "standard": {
      "name": "Uniform conditional outcome-variance floor",
      "cite": "NoackRothe2024"
    }
  }
}