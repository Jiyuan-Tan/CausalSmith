{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-clusters",
    "kind": "sampling",
    "condition": "The cluster records \\(\\{(B_i,\\{Y_{ij}(a),M_{ij}(a):j\\le N_i,a\\in\\{0,1\\}\\}) : i=1,\\ldots,G\\}\\) are independent and identically distributed.",
    "free_symbols": [
      "B_i",
      "Y_{ij}(a)",
      "M_{ij}(a)",
      "a",
      "j",
      "N_i",
      "i",
      "G"
    ],
    "standard": {
      "name": "Independent superpopulation sampling of clusters",
      "cite": "WangParkSmallLi2024"
    }
  }
}