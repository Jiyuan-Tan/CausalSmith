  "body": {
    "id": "ass:block-independence",
    "kind": "design",
    "condition": "The pairs \\(\\{(X_{Bj},G_{Bj}):1\\le j\\le B\\}\\) are independent across \\(j\\) under the row \\(B\\) randomization law.",
    "free_symbols": [
      "X_{Bj}",
      "G_{Bj}",
      "j",
      "B"
    ],
    "standard": {
      "name": "independent randomized blocks",
      "cite": "LiDing2017FPCLT"
    }
  }
}