{
  "node_type": "assumption",
  "body": {
    "id": "ass:variance-nondegeneracy",
    "kind": "regularity",
    "condition": "There is a constant \\(\\underline v>0\\) such that \\(\\min_{j\\in I}\\operatorname{Var}_P(V_j)\\ge\\underline v\\).",
    "free_symbols": [
      "I",
      "P",
      "V"
    ],
    "constants": [
      "\\(\\underline v\\)"
    ],
    "standard": {
      "name": "uniform variance nondegeneracy",
      "cite": "buehlmann2014cam"
    }
  }
}