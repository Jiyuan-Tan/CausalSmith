  "body": {
    "id": "ass:source-sampling",
    "kind": "sampling",
    "condition": "\\((O_{si})_{i=1}^{n_s}\\stackrel{\\mathrm{iid}}{\\sim}P_s\\) for every \\(s\\), with \\(\\{(O_{si})_{i=1}^{n_s}:s=1,\\ldots,K\\}\\) mutually independent.",
    "free_symbols": [
      "Osi",
      "ns",
      "Ps",
      "S",
      "K"
    ],
    "standard": {
      "name": "Independent stratified superpopulation sampling",
      "cite": "DahabrehRobertsonPetitoHernanSteingrimsson2023"
    }
  }
}