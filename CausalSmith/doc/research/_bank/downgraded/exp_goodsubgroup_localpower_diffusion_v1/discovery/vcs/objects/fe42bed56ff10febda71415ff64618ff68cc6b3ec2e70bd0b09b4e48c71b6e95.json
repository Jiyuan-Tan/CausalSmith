{
  "node_type": "assumption",
  "body": {
    "id": "ass:local-scenario-scaling",
    "kind": "local asymptotic regime",
    "condition": "Under scenario \\(m\\), \\(\\mu_j=h_j^m/\\sqrt n\\) for every \\(j\\in\\mathcal J\\).",
    "free_symbols": [
      "m",
      "\\mu",
      "j",
      "h^m",
      "n",
      "\\mathcal J"
    ],
    "standard": {
      "name": "Weak-signal local scaling",
      "cite": "wagerxu2021diffusion"
    }
  }
}