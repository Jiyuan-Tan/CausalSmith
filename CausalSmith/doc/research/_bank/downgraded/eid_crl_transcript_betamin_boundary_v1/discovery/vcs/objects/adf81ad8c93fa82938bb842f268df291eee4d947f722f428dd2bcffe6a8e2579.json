{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-disturbances",
    "kind": "model",
    "condition": "For every \\(m\\in\\mathcal E\\), \\(\\varepsilon^{(m)}\\sim N(0,\\Omega_m)\\).",
    "free_symbols": [
      "\\mathcal E",
      "\\varepsilon^{(m)}",
      "\\Omega_m"
    ],
    "standard": {
      "name": "independent Gaussian structural disturbances",
      "cite": "squires2023linear"
    }
  }
}