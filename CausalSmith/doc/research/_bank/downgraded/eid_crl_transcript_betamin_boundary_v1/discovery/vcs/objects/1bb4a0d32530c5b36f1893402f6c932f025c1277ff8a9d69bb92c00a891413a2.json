{
  "node_type": "assumption",
  "body": {
    "id": "ass:variance-reset",
    "kind": "intervention",
    "condition": "For every \\(m\\in[n]\\), \\((\\Omega_m)_{jj}=(\\Omega_0)_{jj}\\) for \\(j\\ne I(m)\\) and \\((\\Omega_m)_{I(m),I(m)}\\ne(\\Omega_0)_{I(m),I(m)}\\).",
    "free_symbols": [
      "[n]",
      "I",
      "\\Omega_m"
    ],
    "standard": {
      "name": "single-target intervention variance reset",
      "cite": "squires2023linear"
    }
  }
}