{
  "node_type": "assumption",
  "body": {
    "id": "ass:dag-compatibility",
    "kind": "model",
    "condition": "For distinct \\(i,j\\in[n]\\), \\(B^{(0)}_{ij}\\ne0\\) if and only if \\(j\\to i\\) is an edge of \\(\\mathcal G\\).",
    "free_symbols": [
      "[n]",
      "B^{(m)}",
      "\\mathcal G"
    ],
    "standard": {
      "name": "linear SEM graph compatibility",
      "cite": "squires2023linear"
    }
  }
}