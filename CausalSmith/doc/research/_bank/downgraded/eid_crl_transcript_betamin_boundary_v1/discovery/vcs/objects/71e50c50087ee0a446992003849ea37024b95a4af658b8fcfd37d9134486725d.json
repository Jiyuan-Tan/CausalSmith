{
  "node_type": "assumption",
  "body": {
    "id": "ass:perfect-single-target",
    "kind": "intervention",
    "condition": "For every \\(m\\in[n]\\), \\(B^{(m)}_{j,:}=B^{(0)}_{j,:}\\) for \\(j\\ne I(m)\\) and \\(B^{(m)}_{I(m),:}=0\\).",
    "free_symbols": [
      "[n]",
      "I",
      "B^{(m)}"
    ],
    "standard": {
      "name": "one stochastic perfect intervention per latent node",
      "cite": "squires2023linear"
    }
  }
}