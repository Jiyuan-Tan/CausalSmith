  "body": {
    "id": "ass:one-sided-forced-exploration",
    "kind": "design",
    "condition": "For every \\(t\\leq T\\), \\(\\pi_t(1)\\geq ct^{-\\alpha}\\) almost surely.",
    "free_symbols": [
      "pi",
      "c",
      "alpha",
      "T"
    ],
    "standard": {
      "name": "polynomial forced-exploration lower bound",
      "cite": "ShiWangWu2023DelayedInference"
    }
  }
}