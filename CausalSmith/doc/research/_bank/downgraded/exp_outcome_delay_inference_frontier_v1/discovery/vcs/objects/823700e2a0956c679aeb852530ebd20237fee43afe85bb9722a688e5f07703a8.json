{
  "node_type": "assumption",
  "body": {
    "id": "ass:polynomial-delay-envelope",
    "kind": "tail",
    "condition": "For every \\(t\\), \\(a\\in\\mathcal A\\), and integer \\(u\\geq0\\), \\(P\\{D_t(a)>u\\}\\leq\\min\\{1,L(1+u)^{-\\beta}\\}\\).",
    "free_symbols": [
      "P",
      "D",
      "A",
      "L",
      "beta"
    ],
    "standard": {
      "name": "armwise polynomial delay-tail envelope",
      "cite": "GaelVernadeCarpentierValko2020"
    }
  }
}