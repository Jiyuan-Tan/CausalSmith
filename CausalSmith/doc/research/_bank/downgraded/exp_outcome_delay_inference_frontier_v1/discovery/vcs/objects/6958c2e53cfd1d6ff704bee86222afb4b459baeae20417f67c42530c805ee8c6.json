{
  "node_type": "assumption",
  "body": {
    "id": "ass:regular-variance",
    "kind": "regularity",
    "condition": "If \\(\\alpha>0\\), then \\(\\operatorname{Var}_P\\{Y_t(1)\\}\\geq\\kappa\\); if \\(\\alpha=0\\), then \\(\\operatorname{Var}_P\\{Y_t(1)\\}+\\operatorname{Var}_P\\{Y_t(0)\\}\\geq\\kappa\\).",
    "free_symbols": [
      "alpha",
      "P",
      "Y",
      "kappa"
    ],
    "standard": {
      "name": "nondegenerate asymptotic variance",
      "cite": "HadadHirshbergZhanWagerAthey2021"
    }
  }
}