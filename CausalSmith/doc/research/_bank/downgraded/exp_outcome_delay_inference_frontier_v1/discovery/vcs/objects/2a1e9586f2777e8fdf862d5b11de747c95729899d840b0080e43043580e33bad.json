  "body": {
    "id": "prop:one-sided-exploration-achievability",
    "kind": "proposition",
    "statement": "Uniformly over \\(\\mathfrak M_T^{\\mathrm{low}}(\\alpha,\\beta,L,c,\\varepsilon)\\), the deterministic lower-envelope quotas and the interval \\(I_{T,\\Delta}\\) remain uniformly honest and have expected length at most a constant multiple of \\(r_{T,\\Delta}\\). This is the achievability reduction under the one-sided polynomial forced-exploration condition used by Shi, Wang, and Wu. No matching \\(T^{-(1-\\alpha)/2}\\) converse is asserted on this enlarged class because policies may allocate the designated arm more often than order \\(t^{-\\alpha}\\).",
    "free_symbols": [
      "Mlower",
      "T",
      "Delta",
      "alpha",
      "beta",
      "L",
      "c",
      "eps",
      "K",
      "I",
      "r"
    ],
    "depends_on": [
