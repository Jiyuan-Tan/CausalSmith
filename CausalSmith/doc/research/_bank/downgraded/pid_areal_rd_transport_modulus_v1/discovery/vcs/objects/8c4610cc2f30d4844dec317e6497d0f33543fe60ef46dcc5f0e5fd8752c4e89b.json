  "node_type": "symbol",
  "body": {
    "name": "A_ell",
    "type": "minimal rectangle mean envelope",
    "space": "maps \\([0,1]\\) to \\([0,1]\\)",
    "def": "\\(A_0(t)=t\\), and for \\(\\ell_d>0\\), \\(A_{\\ell_d}(t)=[t^2-(t-\\ell_d)_+^2]/(2\\ell_d)\\).",
    "role": "Inverts the complete uniform-rectangle endpoint, including the zero-radius case.",
    "refs": [
      "ell_d",
      "t"
    ]
  }
}