  "node_type": "symbol",
  "body": {
    "name": "Q_n",
    "type": "cell-mean confidence box",
    "space": "subsets of \\([0,1]^N\\)",
    "def": "\\(Q_n=\\prod_{d,j}[\\max\\{0,\\widehat m_{dj}-e_{dj}\\},\\min\\{1,\\widehat m_{dj}+e_{dj}\\}]\\).",
    "role": "Finite-sample simultaneous region for all areal means.",
    "refs": [
      "N",
      "d",
      "J_d",
      "mhat_dj",
      "e_dj"
    ]
  }
}