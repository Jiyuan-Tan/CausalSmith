  "body": {
    "id": "def:cumulant-contrasts",
    "name": "environmental cumulant contrasts",
    "construction": "For every \\(k\\ge2\\), set \\(u_k=(\\kappa_k(\\epsilon_{u,e})-\\kappa_k(\\epsilon_{u,0}))_{e=1}^{E-1}\\), \\(c_k=(\\kappa_k(T_e)-\\kappa_k(T_0))_{e=1}^{E-1}\\), and \\(m_k=(\\kappa_k(Y_e,T_e,\\ldots,T_e)-\\kappa_k(Y_0,T_0,\\ldots,T_0))_{e=1}^{E-1}\\).",
    "free_symbols": [
      "k",
      "u_k",
      "c_k",
      "m_k",
      "\\kappa_k",
      "\\epsilon_{u,e}",
      "T_e",
      "Y_e",
      "E"
    ],
    "inputs": [
      "P_e"
    ]
  }
}