{
  "node_type": "assumption",
  "body": {
    "id": "ass:calendar-memory-mean",
    "kind": "outcome mean structure",
    "condition": "\\(\\mu_t(s,x)=m_t(x)+\\sum_{\\ell=0}^{p}\\tau_{t,\\ell}(x)(D_s)_{t,\\ell}\\) for every \\(s\\in\\mathcal S\\), \\(x\\in\\mathcal X\\), and \\(t\\in\\{1,\\ldots,T\\}\\).",
    "free_symbols": [
      "mu",
      "m",
      "tau",
      "D",
      "S",
      "X",
      "T",
      "p"
    ],
    "standard": {
      "name": "Calendar-varying finite-memory linear distributed-lag conditional mean",
      "cite": "AiligengLuWang2023"
    }
  }
}