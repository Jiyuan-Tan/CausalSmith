{
  "node_type": "assumption",
  "body": {
    "id": "ass:hessian-ellipticity",
    "kind": "shape-restriction",
    "condition": "For every \\(p\\in\\mathcal A\\) and \\(u\\in\\Omega\\), the Hessian satisfies \\(mI_d\\preceq H_p(u)\\preceq MI_d\\).",
    "free_symbols": [
      "p",
      "\\mathcal A",
      "u",
      "\\Omega",
      "H_p",
      "m",
      "M",
      "d"
    ],
    "standard": {
      "name": "Uniformly strongly convex Brenier potentials",
      "cite": "HutterRigollet2021MinimaxOT"
    }
  }
}