{
  "node_type": "assumption",
  "body": {
    "id": "ass:domain-smoothness",
    "kind": "smoothness",
    "condition": "For every \\(p\\in\\mathcal A\\), the boundary \\(\\partial D_p\\) is of class \\(C^{s+2}\\) with chart norm at most \\(L\\).",
    "free_symbols": [
      "p",
      "\\mathcal A",
      "D_p",
      "s",
      "L"
    ],
    "standard": {
      "name": "Smooth second-boundary-value domains",
      "cite": "CajaLopezDelgadinoKitagawa2026Stability"
    }
  }
}