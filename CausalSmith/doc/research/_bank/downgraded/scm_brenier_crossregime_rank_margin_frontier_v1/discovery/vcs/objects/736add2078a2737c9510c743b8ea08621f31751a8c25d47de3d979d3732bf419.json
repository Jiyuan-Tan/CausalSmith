{
  "node_type": "assumption",
  "body": {
    "id": "ass:sample-balance",
    "kind": "sampling",
    "condition": "The fixed constant \\(c_n\\in(0,1]\\) satisfies \\(n_p\\ge c_n\\max_{q\\in\\mathcal A}n_q\\) for every \\(p\\in\\mathcal A\\).",
    "free_symbols": [
      "p",
      "q",
      "\\mathcal A",
      "n_p",
      "c_n"
    ],
    "constants": [
      "c_n"
    ],
    "standard": {
      "name": "Comparable regime sample sizes",
      "cite": "ManoleBalakrishnanNilesWeedWasserman2024Plugin"
    }
  }
}