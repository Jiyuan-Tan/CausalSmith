{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-convexity",
    "kind": "support",
    "condition": "For every \\(p\\in\\mathcal A\\), the principal curvatures of \\(\\partial D_p\\) lie in \\([L^{-1},L]\\).",
    "free_symbols": [
      "p",
      "\\mathcal A",
      "D_p",
      "L"
    ],
    "standard": {
      "name": "Uniformly convex support",
      "cite": "HutterRigollet2021MinimaxOT"
    }
  }
}