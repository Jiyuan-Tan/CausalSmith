    "id": "def:cross-hessian-margin",
    "name": "Symmetric cross-Hessian field and Euclidean rank margin",
    "construction": "For \\(p,q\\in\\mathcal A\\), set \\(S_{pq}(u)=\\operatorname{sym}(H_q(u)H_p(u)^{-1})\\) and \\(\\gamma_{pq}=\\inf_{u\\in\\Omega}\\lambda_{\\min}(S_{pq}(u))\\).",
    "free_symbols": [
      "p",
      "q",
      "\\mathcal A",
      "S_{pq}",
      "u",
      "H_q",
      "H_p",
      "\\gamma_{pq}",
      "\\Omega"
    ],
    "inputs": [
      "ass:hessian-ellipticity"
    ]
  }
}