{
  "node_type": "assumption",
  "body": {
    "id": "ass:arm-specific-independent-censoring",
    "kind": "sampling",
    "condition": "For each \\(z\\in\\{0,1\\}\\), \\(C\\perp(D(z),R(z))\\mid(Z=z,X)\\).",
    "free_symbols": [
      "C",
      "D(z)",
      "R(z)",
      "Z",
      "X"
    ],
    "standard": {
      "name": "arm-specific conditional independent administrative censoring",
      "cite": "goldberg2019hoeffding"
    }
  }
}