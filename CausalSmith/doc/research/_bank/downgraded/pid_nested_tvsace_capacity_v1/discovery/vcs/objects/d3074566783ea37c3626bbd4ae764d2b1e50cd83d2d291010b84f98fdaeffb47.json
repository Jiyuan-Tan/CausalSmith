{
  "node_type": "assumption",
  "body": {
    "id": "ass:full-horizon-censoring-support",
    "kind": "support",
    "condition": "\\(\\inf_{z,x,u\\in[0,\\tau]}G_{zx}(u)\\ge\\gamma\\).",
    "free_symbols": [
