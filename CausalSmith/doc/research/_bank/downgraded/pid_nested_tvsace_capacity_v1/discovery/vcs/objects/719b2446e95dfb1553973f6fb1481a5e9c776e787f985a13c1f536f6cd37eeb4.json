{
  "node_type": "assumption",
  "body": {
    "id": "ass:lipschitz-density",
    "kind": "regularity",
    "condition": "Every finite-part coordinate density of \\(\\mu_{zx}\\) is \\(L_{\\mathrm{Lip}}\\)-Lipschitz.",
    "free_symbols": [
      "\\mu_{zx}",
      "L_{\\mathrm{Lip}}"
    ],
    "standard": {
      "name": "Lipschitz, or Hölder-one, density regularity",
      "cite": "tsybakov2009nonparametric"
    }
  }
}