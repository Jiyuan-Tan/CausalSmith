  "body": {
    "id": "ass:ray-upper-envelope",
    "kind": "Fourier regularity",
    "condition": "For every \\(u\\in\\mathcal R\\) and \\(|t|\\ge1\\), \\(|\\phi_U(tu)|\\le C(1+|t|)^{-q_u}\\).",
    "free_symbols": [
      "Rays",
      "phiU",
      "C",
      "qray"
    ],
    "standard": {
      "name": "Ordinary-smooth upper characteristic-function envelope",
      "cite": "Meister2006"
    }
  }
}