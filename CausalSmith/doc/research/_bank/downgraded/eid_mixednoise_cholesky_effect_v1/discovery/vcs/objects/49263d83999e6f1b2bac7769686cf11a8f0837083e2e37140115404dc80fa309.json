{
  "node_type": "assumption",
  "body": {
    "id": "ass:ray-lower-envelope",
    "kind": "Fourier regularity",
    "condition": "For every \\(u\\in\\mathcal R\\) and \\(|t|\\ge1\\), \\(|\\phi_U(tu)|\\ge c(1+|t|)^{-q_u}\\).",
    "free_symbols": [
      "Rays",
      "phiU",
      "c",
      "qray"
    ],
    "standard": {
      "name": "Ordinary-smooth lower characteristic-function envelope",
      "cite": "Meister2006"
    }
  }
}