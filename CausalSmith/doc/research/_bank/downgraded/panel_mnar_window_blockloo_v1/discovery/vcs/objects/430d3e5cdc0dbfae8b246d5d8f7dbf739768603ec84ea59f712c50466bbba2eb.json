{
  "node_type": "assumption",
  "body": {
    "id": "ass:subgaussian-noise",
    "kind": "moment",
    "condition": "The errors satisfy \\(\\|\\epsilon_{it}\\|_{\\psi_2}\\le K\\) uniformly over \\((i,t)\\).",
    "free_symbols": [
      "epsilon",
      "K"
    ],
    "constants": [
      "K"
    ],
    "standard": {
      "name": "uniform sub-Gaussian tails",
      "cite": "choiYuan2024MNAR"
    }
  }
}