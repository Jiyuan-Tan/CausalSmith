{
  "node_type": "assumption",
  "body": {
    "id": "ass:hessian-moment",
    "kind": "regularity",
    "condition": "On a fixed neighborhood \\(\\mathcal N(\\theta_n)\\), \\(\\sup_nE_{P_n}[\\sup_{\\theta\\in\\mathcal N(\\theta_n)}\\|\\nabla_\\theta^2L((X,Y);\\theta)\\|^{q/2}\\mid R=1,A=0]\\le C\\).",
    "free_symbols": [
      "\\(n\\)",
      "\\(P_n\\)",
      "\\(L\\)",
      "\\(X\\)",
      "\\(Y\\)",
      "\\(\\theta_n\\)",
      "\\(q\\)",
      "\\(R\\)",
      "\\(A\\)",
      "\\(C\\)"
    ],
    "standard": {
      "name": "Local Hessian envelope moment bound",
      "cite": "YangLiWuYang2026"
    }
  }
}