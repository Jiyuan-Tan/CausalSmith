{
  "node_type": "assumption",
  "body": {
    "id": "ass:heteroskedastic-subgaussian",
    "kind": "tail-rate",
    "condition": "For every \\(n\\), \\(\\|e_{it}\\|_{\\psi_2}\\le C_e\\sigma_{it}\\) for every \\((i,t)\\in\\mathcal Q_n^+\\), with the same \\(C_e\\).",
    "free_symbols": [
      "e",
      "i",
      "t",
      "Qplus",
      "sigma",
      "Ce",
      "n"
    ],
    "constants": [
      "\\(C_e\\)"
    ],
    "standard": {
      "name": "Uniformly sub-Gaussian heteroskedastic noise",
      "cite": "ChoiKwonLiao2024Completion"
    }
  }
}