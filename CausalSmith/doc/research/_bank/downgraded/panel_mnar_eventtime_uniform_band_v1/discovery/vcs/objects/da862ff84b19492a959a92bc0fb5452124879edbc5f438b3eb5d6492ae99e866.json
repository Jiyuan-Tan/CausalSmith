{
  "node_type": "assumption",
  "body": {
    "id": "ass:spectral-size-ratio",
    "kind": "rank",
    "condition": "For every \\(n\\), \\(\\max_{g\\in E_k,k\\in\\mathcal K_n}\\frac{\\kappa_{gk}^4\\mu_{gk}^2r^2\\max\\{N_{gk}\\log^3N_{gk},T_g\\log^3T_g\\}}{\\min\\{N_{gk}^2,T_g^2\\}}\\le\\varepsilon_n^{\\mathrm{spec}}\\).",
    "free_symbols": [
      "g",
      "E",
      "k",
      "K",
      "Kn",
      "kappa",
      "mu",
      "r",
      "Nb",
      "Tb",
      "n",
      "epsSpec"
    ],
    "standard": {
      "name": "Uniform version of the Choi--Yuan spectral dimension ratio",
      "cite": "ChoiYuan2024MNAR"
    }
  }
}