{
  "node_type": "assumption",
  "body": {
    "id": "ass:cell-leverage",
    "kind": "empirical-process",
    "condition": "For every \\(n\\), \\(L_n(K)^2\\log^7(2K|\\mathcal Q_n^{\\mathrm{IF}}|)\\le\\varepsilon_n^{\\mathrm{lev}}\\).",
    "free_symbols": [
      "L",
      "n",
      "K",
      "Q",
      "epsLev"
    ],
    "standard": {
      "name": "Sub-Gaussian high-dimensional maximum leverage condition",
      "cite": "ChernozhukovChetverikovKato2013Maxima"
    }
  }
}