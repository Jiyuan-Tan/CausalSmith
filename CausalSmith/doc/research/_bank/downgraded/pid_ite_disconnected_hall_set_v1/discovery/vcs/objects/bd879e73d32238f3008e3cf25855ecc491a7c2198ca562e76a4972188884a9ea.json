  "node_type": "definition",
  "body": {
    "id": "def:ternary-thresholds",
    "name": "Ternary disconnectedness thresholds",
    "construction": "For \\(L=3\\), \\(m_d=\\max_{0\\leq j\\leq2}\\mu_{d,j}\\), \\(b_2=\\max\\{m_1-\\min(\\mu_{0,0},\\mu_{0,2}),\\ m_0-\\min(\\mu_{1,0},\\mu_{1,2}),0\\}\\), \\(d_2=\\max\\{m_1-\\mu_{0,1},\\ m_0-\\mu_{1,1},0\\}\\), and \\(b_3=\\max\\{m_1,m_0,1-\\min(\\mu_{1,0},\\mu_{1,2})-\\min(\\mu_{0,0},\\mu_{0,2})\\}\\).",
    "free_symbols": [
      "L",
      "m0",
      "m1",
      "mu0",
      "mu1",
      "b2",
      "d2",
      "b3"
    ]
  }
}