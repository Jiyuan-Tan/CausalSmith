  "body": {
    "id": "prop:information-nesting",
    "kind": "proposition",
    "statement": "For every \\(2\\le p<q\\) and every DAG \\(G\\), \\(\\mathsf H_{\\mathrm{soft}}(G)\\subseteq\\mathsf{Cov}_p(G)\\) for the generic chamberwise covariance functional. The claim covers both signs of every true variance change, makes no pointwise assertion on \\(t_k=v_k\\), and allows candidate twins with \\(t'_k=v'_k\\).",
    "free_symbols": [
      "p",
      "q",
      "G",
      "Hsoft",
      "Cov",
      "t",
      "v",
      "vprime",
      "tprime"
    ],
    "depends_on": [
      "ass:finite-dimensions",
      "ass:dag",
      "ass:mixing-rank",
      "ass:mixing-nonzero",
      "ass:mixing-columns",
      "ass:baseline-variance",
      "ass:intervention-variance",
