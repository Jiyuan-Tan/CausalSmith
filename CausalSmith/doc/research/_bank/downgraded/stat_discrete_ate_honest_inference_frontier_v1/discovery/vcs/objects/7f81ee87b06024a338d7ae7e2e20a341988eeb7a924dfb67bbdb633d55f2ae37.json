{
  "node_type": "assumption",
  "body": {
    "id": "ass:efficient-variance-band",
    "kind": "local-regularity",
    "condition": "\\(v_0M^2\\le V_{\\mathrm{eff}}(P_n)\\le v_1M^2\\) for every row \\(n\\).",
    "free_symbols": [
      "\\(v_0\\)",
      "\\(v_1\\)",
      "\\(M\\)",
      "\\(V_{\\mathrm{eff}}(P)\\)",
      "\\(\\mathbf P=(P_n)\\)",
      "\\(n\\)"
    ],
    "standard": {
      "name": "nondegenerate semiparametric variance",
      "cite": "ChernozhukovEtAl2018DML"
    }
  }
}