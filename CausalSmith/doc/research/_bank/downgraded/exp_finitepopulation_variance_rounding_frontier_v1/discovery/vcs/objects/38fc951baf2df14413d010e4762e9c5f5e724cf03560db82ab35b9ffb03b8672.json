    "id": "def:lower-family",
    "name": "Padded four-row obstruction family",
    "construction": "For \\(N\\ge4\\), take \\(A_1=(-9,8,15,3)\\), \\(A_2=(-12,-6,14,-16)\\), and \\(A_3=(7,2,-3,-13)\\), append \\(N-4\\) copies of \\((100,100,-200)\\), and set \\(x^{(N)}_1=(A_1+9)/120\\), \\(x^{(N)}_2=(A_2+16)/120\\), and \\(x^{(N)}_3=(7-A_3)/240\\), applying the same affine formulas to the appended entries.",
    "free_symbols": [
      "N",
      "x^{(N)}"
    ],
    "inputs": [
      "N"
    ]
  }
}