{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-multiplier-law",
    "kind": "uniform conditional resampling",
    "condition": "\\(\\forall\\epsilon>0,\\quad\\sup_{\\mathbb P\\in\\mathfrak P_{\\kappa}^{0}}\\Pr_{\\mathbb P}\\!\\left\\{\\sup_{\\lVert f\\rVert_{\\mathrm{BL}}\\le1}\\left|E_{\\mathbb P}^{\\star}f(G_n^\\star)-E f(G_{\\mathbb P,n})\\right|>\\epsilon\\right\\}\\longrightarrow0.\\)",
    "free_symbols": [
      "\\mathbb P",
      "\\mathfrak P_{\\kappa}^{0}",
      "G_n^\\star",
      "G_{\\mathbb P,n}",
      "E_{\\mathbb P}^{\\star}"
    ],
    "novel": {
      "flag": true,
      "justification": "Multiplier resampling of bounded finite-dimensional influence vectors provides this approximation over multinomial arrays with uniformly controlled effective sample sizes."
    }
  }
}