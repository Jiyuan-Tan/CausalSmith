      "residualScale",
      "residualScore"
    ],
    "depends_on": [
      "def:regular-tail",
      "ass:centered-covariates",
      "ass:uniform-boundedness",
      "ass:second-moment-limit",
      "ass:covariate-nondegeneracy",
      "ass:residual-nondegeneracy",
