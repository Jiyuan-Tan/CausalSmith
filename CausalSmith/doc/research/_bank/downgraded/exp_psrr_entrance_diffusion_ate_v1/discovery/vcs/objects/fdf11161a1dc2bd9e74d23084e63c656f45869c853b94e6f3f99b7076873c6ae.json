{
  "node_type": "assumption",
  "body": {
    "id": "ass:uniform-boundedness",
    "kind": "maximal-term regularity",
    "condition": "There is a constant \\(K_0<\\infty\\), independent of \\(n\\), such that \\(\\max_{i\\in\\mathcal I_n}\\{\\|x_{ni}\\|+|Y_{ni}(0)|+|Y_{ni}(1)|\\}\\le K_0\\).",
    "free_symbols": [
      "sampleSize",
      "units",
      "covariates",
      "outcome0",
      "outcome1",
      "arrayBound"
    ],
    "constants": [
      "\\(K_0\\)"
    ],
    "standard": {
      "name": "Bounded finite-population maximal-term condition",
      "cite": "LiDing2017FPCLT"
    }
  }
}