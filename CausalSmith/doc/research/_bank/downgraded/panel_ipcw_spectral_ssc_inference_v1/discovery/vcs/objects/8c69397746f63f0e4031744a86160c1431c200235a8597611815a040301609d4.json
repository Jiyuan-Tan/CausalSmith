{
  "node_type": "assumption",
  "body": {
    "id": "ass:influence-moment",
    "kind": "regularity",
    "condition": "The centered true scores satisfy \\(\\sup_{c\\in\\mathcal C}E_{P_c}\\|\\phi_c(O_{ci})\\|_2^{2+\\nu}<\\infty\\).",
    "free_symbols": [
      "c",
      "\\mathcal C",
      "P_c",
      "\\phi_c",
      "O_{ci}",
      "\\nu"
    ],
    "constants": [
      "\\nu"
    ],
    "standard": {
      "name": "uniform Lyapunov moment condition for a fixed-dimensional triangular array",
      "cite": "ChernozhukovEtAl2018DML"
    }
  }
}