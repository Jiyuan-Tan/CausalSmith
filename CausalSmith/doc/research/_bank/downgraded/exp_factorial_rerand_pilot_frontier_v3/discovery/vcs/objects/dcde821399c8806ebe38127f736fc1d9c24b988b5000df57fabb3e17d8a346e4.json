{
  "node_type": "assumption",
  "body": {
    "id": "ass:qmd",
    "kind": "likelihood regularity",
    "condition": "\\(\\sup_{q\\in\\mathcal Q,\\beta\\in\\mathcal U}\\int\\left(\\sqrt{p_{q,\\beta+h}}-\\sqrt{p_{q,\\beta}}-\\tfrac12h^{\\mathsf T}s_{q,\\beta}\\sqrt{p_{q,\\beta}}\\right)^2d\\mu=o(\\lVert h\\rVert^2)\\).",
    "free_symbols": [
      "Qset",
      "beta",
      "U",
      "mu",
      "Pbeta",
      "score"
    ],
    "standard": {
      "name": "Uniform quadratic-mean differentiability",
      "cite": "VanDerVaart1998AsymptoticStatistics"
    }
  }
}