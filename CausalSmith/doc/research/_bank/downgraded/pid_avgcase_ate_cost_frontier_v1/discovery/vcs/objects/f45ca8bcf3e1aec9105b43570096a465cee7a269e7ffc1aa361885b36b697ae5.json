{
  "node_type": "assumption",
  "body": {
    "id": "ass:odds-cap",
    "kind": "sensitivity-model",
    "condition": "For every positive-mass response-type cell, \\(\\ell_x\\leq q_{xij}\\leq u_x\\).",
    "free_symbols": [
      "\\ell_x",
      "q_{xij}",
      "u_x",
      "\\Gamma"
    ],
    "constants": [
      "\\Gamma"
    ],
    "standard": {
      "name": "marginal sensitivity odds-ratio bound",
      "cite": "Tan2006Distributional"
    }
  }
}