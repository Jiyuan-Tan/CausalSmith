  "body": {
    "id": "ass:stationary-pairwise-orthogonality",
    "kind": "design",
    "condition": "\\(\\mathbb E_{P_{\\infty}}[X_0^{\\infty}X_h^{\\infty}]=0\\) for every nonzero integer \\(h\\).",
    "free_symbols": [
      "Pinf",
      "Xinf"
    ],
    "standard": {
      "name": "Balanced Rudin--Shapiro zero off-origin autocorrelation",
      "cite": "Mazac2024"
    }
  }
}