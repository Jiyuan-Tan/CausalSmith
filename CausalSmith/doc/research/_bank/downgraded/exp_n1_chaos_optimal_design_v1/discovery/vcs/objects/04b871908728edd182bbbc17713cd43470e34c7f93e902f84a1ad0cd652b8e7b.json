{
  "node_type": "assumption",
  "body": {
    "id": "ass:fixed-lti-response",
    "kind": "structural",
    "condition": "For every \\(t\\in\\{1,\\ldots,T\\}\\), \\(Y_t(X)=\\sum_{\\ell=0}^{K-1}g_{\\ell}X_{t-\\ell}+e_t\\).",
    "free_symbols": [
      "T",
      "K",
      "Y",
      "X",
      "g",
      "e"
    ],
    "standard": {
      "name": "Finite-order linear time-invariant impulse response",
      "cite": "LiangRecht2025"
    }
  }
}