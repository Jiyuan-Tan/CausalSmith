{
  "node_type": "assumption",
  "body": {
    "id": "ass:binary-logistic-outcome",
    "kind": "outcome model",
    "condition": "\\((Y_{ni})_{i=1}^{n}\\) are conditionally independent given \\((q_{ni},A_{ni})_{i=1}^{n}\\) and \\(Y_{ni}\\mid(q_{ni},A_{ni})\\sim\\operatorname{Bernoulli}(m_{ni})\\)",
    "free_symbols": [
      "Yseq",
      "n",
      "qseq",
      "Aseq",
      "mseq"
    ],
    "standard": {
      "name": "Correct logistic binary-response model",
      "cite": "SurCandes2019"
    }
  }
}