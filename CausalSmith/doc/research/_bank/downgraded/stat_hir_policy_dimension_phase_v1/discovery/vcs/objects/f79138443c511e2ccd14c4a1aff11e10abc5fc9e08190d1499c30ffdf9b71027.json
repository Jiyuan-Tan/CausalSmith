{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-features",
    "kind": "design distribution",
    "condition": "\\((q_{ni})_{i=1}^{n}\\) are independent with \\(q_{ni}\\sim\\mathcal N(0,I_{p_n})\\)",
    "free_symbols": [
      "qseq",
      "n",
      "pseq"
    ],
    "standard": {
      "name": "Isotropic Gaussian proportional design",
      "cite": "SurCandes2019"
    }
  }
}