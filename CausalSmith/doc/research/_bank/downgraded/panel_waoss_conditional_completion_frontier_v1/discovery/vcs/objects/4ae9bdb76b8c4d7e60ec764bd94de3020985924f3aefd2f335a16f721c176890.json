  "body": {
    "id": "ass:holder-regression",
    "kind": "smoothness",
    "condition": "\\(|g(x,z)-g(x',z')|\\le G\\|(x,z)-(x',z')\\|^\\beta\\quad\\text{within each connected component of }H\\)",
