{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "sampling",
    "condition": "\\(O_1,\\ldots,O_n\\) are independent and identically distributed with common observed-data margin induced by \\(P\\).",
    "free_symbols": [
      "\\(O_i\\)",
      "\\(n\\)",
      "\\(P\\)"
    ],
    "standard": {
      "name": "Independent and identically distributed sampling",
      "cite": "LuedtkeVanderLaan2016"
    }
  }
}