{
  "node_type": "assumption",
  "body": {
    "id": "ass:mean-lipschitz",
    "kind": "smoothness",
    "condition": "For every \\(x\\in\\mathcal X\\), \\(a\\in\\mathcal A\\setminus\\{a_0\\}\\), and \\(s,t\\in[0,1]\\), \\( |\\mu_{xa}(t)-\\mu_{xa}(s)|\\leq\\Gamma|t-s|\\).",
    "free_symbols": [
      "X",
      "A",
      "a0",
      "Gamma",
      "mu"
    ],
    "standard": {
      "name": "known Lipschitz conditional-mean class adapted to model score",
      "cite": "ArmstrongKolesar2021"
    }
  }
}