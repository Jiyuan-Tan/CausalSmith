      "aloose"
    ],
    "depends_on": [
      "def:predictable-class",
      "def:rowwise-loss",
      "def:frontier-rate",
      "def:observed-estimators",
      "def:hybrid-row-estimator",
      "thm:adaptive-minimax-lower",
