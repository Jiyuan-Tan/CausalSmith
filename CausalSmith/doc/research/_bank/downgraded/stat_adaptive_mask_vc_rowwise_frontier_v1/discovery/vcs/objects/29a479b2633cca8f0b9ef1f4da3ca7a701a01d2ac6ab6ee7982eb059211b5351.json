{
  "node_type": "assumption",
  "body": {
    "id": "ass:variance-nondegeneracy",
    "kind": "inference",
    "condition": "For every \\(g\\in\\mathcal G_n\\), \\(s_g^2=\\sum_{i\\in I,j\\in J}E_P[g_{ij}^2E_{ij}^2]\\ge c_sB^2/(nm)\\).",
    "free_symbols": [
      "g",
      "G",
      "i",
      "j",
      "I",
      "J",
      "P",
      "E",
      "soracle",
      "B",
      "n",
      "m"
    ],
    "constants": [
      "\\(c_s>0\\) is fixed"
    ],
    "standard": {
      "name": "Nondegenerate coordinate variance",
      "cite": "BelloniOliveira2018MartingaleCLT"
    }
  }
}