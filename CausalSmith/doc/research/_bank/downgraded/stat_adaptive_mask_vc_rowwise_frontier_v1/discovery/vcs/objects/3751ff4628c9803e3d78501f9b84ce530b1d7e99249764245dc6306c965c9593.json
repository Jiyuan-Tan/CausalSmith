{
  "node_type": "assumption",
  "body": {
    "id": "ass:predictable-covariance-tail",
    "kind": "inference",
    "condition": "With probability at least \\(1-(nm)^{-1/16}\\), \\(\\lVert\\Omega^{\\mathrm P}_{nm}-\\Omega_{nm}\\rVert_{\\max}\\le(nm)^{-1/16}/\\log^2(enm|\\mathcal G_n|)\\).",
    "free_symbols": [
      "P",
      "Omegap",
      "Omega",
      "n",
      "m",
      "G"
    ],
    "standard": {
      "name": "Belloni--Oliveira predictable-covariance high-probability control",
      "cite": "BelloniOliveira2018MartingaleCLT"
    }
  }
}