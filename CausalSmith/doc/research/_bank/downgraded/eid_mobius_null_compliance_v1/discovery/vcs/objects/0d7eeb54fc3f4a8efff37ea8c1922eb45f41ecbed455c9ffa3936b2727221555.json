{
  "node_type": "assumption",
  "body": {
    "id": "ass:fieller-nondegeneracy",
    "kind": "regularity",
    "condition": "For every \\(t\\in\\mathcal B\\) and fixed \\(u\\in\\mathbb R\\), \\(\\operatorname{Var}_P(\\phi_{m,t}-u\\phi_{p,t})>0\\).",
    "free_symbols": [
      "t",
      "\\mathcal B",
      "u",
      "P",
      "\\phi_{m,t}",
      "\\phi_{p,t}"
    ],
    "standard": {
      "name": "nondegenerate studentized Fieller moment",
      "cite": "KangPeckKeele2018RandomizationIV"
    }
  }
}