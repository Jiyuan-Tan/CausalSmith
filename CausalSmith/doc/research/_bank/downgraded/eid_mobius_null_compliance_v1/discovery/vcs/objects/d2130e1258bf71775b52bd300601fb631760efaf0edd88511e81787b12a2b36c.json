  "body": {
    "id": "thm:joint-inference",
    "kind": "theorem",
    "statement": "Under i.i.d. sampling, finite second moments, \\(p^\\star\\ge\\kappa>0\\), and positive definite \\(\\Omega\\), \\(\\sqrt n(\\widehat{\\boldsymbol\\theta}-\\boldsymbol\\theta)=n^{-1/2}\\sum_{i=1}^n\\phi_{\\theta}(O_i)+o_P(1)\\Rightarrow N(0,\\Omega)\\). The plug-in \\(\\widehat\\Omega\\) is consistent and \\(P(\\boldsymbol\\theta\\in\\mathcal C_{\\theta})\\to1-\\alpha_0\\).",
    "free_symbols": [
      "n",
      "\\widehat{\\boldsymbol\\theta}",
      "\\boldsymbol\\theta",
      "i",
      "\\phi_{\\theta}",
      "O_i",
      "P",
      "\\Omega",
      "\\widehat\\Omega",
      "\\mathcal C_{\\theta}",
      "\\alpha_0",
      "p^\\star"
    ],
    "depends_on": [
      "ass:full-support-randomization",
      "ass:iid-sampling",
      "ass:second-moment",
      "ass:strong-share",
      "ass:wald-nonsingularity",
