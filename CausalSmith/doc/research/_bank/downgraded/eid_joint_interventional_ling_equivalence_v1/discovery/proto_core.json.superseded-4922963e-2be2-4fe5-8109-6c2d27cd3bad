  "assumptions": [
    {
      "id": "ass:exact-support",
      "kind": "causal-structural",
      "condition": "\\(\\operatorname{supp}(B)=E(G)\\), including \\(B_{ii}=0\\) because \\(G\\) is loopless.",
      "free_symbols": [
        "B",
        "G"
      ],
      "novel": {
        "flag": true,
        "justification": "Exact support treats every declared arrow as an actual direct equilibrium effect. It is satisfied by sparse linear feedback systems whose reported graph omits zero coefficients, and the margin subclass below supplies a robust nonempty region rather than a generic closure convention."
      },
      "used_by": [
        "def:exact-support-model-class",
        "thm:exact-mixing-realization",
        "thm:coupled-equivalence"
      ]
    },
    {
      "id": "ass:regime-solvability",
      "kind": "regularity",
      "condition": "\\(\\det(Q_{V\\setminus S,V\\setminus S})\\ne0\\) for every \\(S\\in\\mathcal I\\).",
      "free_symbols": [
        "Qmat",
        "Vset",
        "S",
        "Ical"
      ],
      "standard": {
        "name": "Unique solvability under perfect interventions",
        "cite": "BongersForrePetersMooij2021"
      },
      "used_by": [
        "def:exact-support-model-class",
        "lem:intervention-pushforward"
      ]
    },
    {
      "id": "ass:source-independence",
      "kind": "causal-structural",
      "condition": "The coordinates \\(\\{\\varepsilon_i:i\\in V\\}\\) are mutually independent.",
      "free_symbols": [
        "epsilon",
        "Vset"
      ],
      "standard": {
        "name": "Independent-component exogeneity",
        "cite": "DaiAlbrechtSpirtesZhang2026"
      },
      "used_by": [
        "def:exact-support-model-class",
        "thm:source-partition-containment"
      ]
    },
    {
      "id": "ass:source-centering",
      "kind": "model-restriction",
      "condition": "\\(\\mathbb E[\\varepsilon_i]=0\\) for every \\(i\\in V\\).",
      "free_symbols": [
        "epsilon",
        "Vset"
      ],
      "novel": {
        "flag": true,
        "justification": "Centering is a deliberate location normalization for the intercept-free equilibrium model, not a claim about all linear non-Gaussian systems. It is natural after demeaning equilibrium measurements and makes the affine response intercept entirely attributable to the imposed intervention value."
      },
      "used_by": [
        "def:exact-support-model-class",
        "lem:intervention-pushforward"
      ]
    },
