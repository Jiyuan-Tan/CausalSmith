{
  "node_type": "assumption",
  "body": {
    "id": "ass:hist-lipschitz-outcomes",
    "kind": "smoothness",
    "condition": "For each \\(a\\in\\{0,1\\}\\), \\(|\\mu_a(x)-\\mu_a(x')|\\le L|x-x'|\\) for all \\(x,x'\\in[0,1]\\).",
    "free_symbols": [
      "mu_0",
      "mu_1",
      "L",
      "mathcal_X"
    ],
    "standard": {
      "name": "Hölder smoothness of order one for outcome nuisance functions",
      "cite": "SchmidtWikle2026"
    }
  }
}