{
  "node_type": "assumption",
  "body": {
    "id": "ass:confounding-cap",
    "kind": "sensitivity",
    "condition": "\\(\\sup_{x,t}\\left|1-\\mathbb E_Q\\{Y(t)\\mid X=x,S=0,T=1-t\\}/\\mathbb E_Q\\{Y(t)\\mid X=x,S=0,T=t\\}\\right|\\le\\rho=1/5\\).",
    "free_symbols": [
      "\\(x\\)",
      "\\(X\\)",
      "\\(t\\)",
      "\\(Y(t)\\)",
      "\\(S\\)",
      "\\(T\\)",
      "\\(Q\\)",
      "\\(\\rho\\)"
    ],
    "standard": {
      "name": "Relative no-unobserved-confounding sensitivity cap",
      "cite": "LannersRudinVolfovskyParikh2025"
    }
  }
}