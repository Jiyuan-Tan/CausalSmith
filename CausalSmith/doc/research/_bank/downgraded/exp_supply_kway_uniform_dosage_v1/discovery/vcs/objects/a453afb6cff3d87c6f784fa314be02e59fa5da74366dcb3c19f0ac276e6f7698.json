{
  "node_type": "assumption",
  "body": {
    "id": "ass:fixed-dimension",
    "kind": "asymptotic regime",
    "condition": "\\(p,k,L,B,\\sigma_{\\min},\\sigma_{\\max}\\) remain fixed as \\(n\\to\\infty\\).",
    "free_symbols": [
      "p",
      "k",
      "L",
      "B",
      "sigmaMin",
      "sigmaMax",
      "n"
    ],
    "standard": {
      "name": "fixed-dimensional random-design asymptotics",
      "cite": "HsuKakadeZhang2014"
    }
  }
}