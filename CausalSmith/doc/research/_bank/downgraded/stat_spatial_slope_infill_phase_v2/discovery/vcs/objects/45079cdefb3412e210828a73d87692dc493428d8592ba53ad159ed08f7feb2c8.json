{
  "node_type": "assumption",
  "body": {
    "id": "ass:determinant-margin",
    "kind": "sampling",
    "condition": "\\(f_X(\\omega)f_W(\\omega)-f_{XW}(\\omega)^2\\ge\\rho f_X(\\omega)f_W(\\omega)\\quad\\forall\\omega\\in\\mathbb R^d\\).",
    "free_symbols": [
      "d",
      "omega",
      "fX",
      "fW",
      "fC",
      "rho"
    ],
    "constants": [
      "rho"
    ],
    "standard": {
      "name": "uniform spectral-matrix positive-definiteness margin",
      "cite": "GneitingKleiberSchlather2010"
    }
  }
}