{
  "node_type": "assumption",
  "body": {
    "id": "ass:observation-law",
    "kind": "sampling",
    "condition": "\\((X(s_{i,N}),Y(s_{i,N}))_{i=1}^N=(X(s_{i,N}),\\beta X(s_{i,N})+W(s_{i,N}))_{i=1}^N\\).",
    "free_symbols": [
      "N",
      "sites",
      "X",
      "Y",
      "beta",
      "W"
    ],
    "standard": {
      "name": "homogeneous Gaussian spatial regression without nugget",
      "cite": "DattaStein2026"
    }
  }
}