  "body": {
    "id": "ass:convex-loss",
    "kind": "decision-theoretic",
    "condition": "For every target law \\(\\mu\\), the map \\(a\\mapsto\\ell(a,\\mu)\\) is convex on \\(\\mathcal A\\).",
    "free_symbols": [
      "loss",
      "Aspace"
    ],
    "standard": {
      "name": "Convex-loss randomized decision comparison",
      "cite": "Blackwell1953"
    }
  }
}