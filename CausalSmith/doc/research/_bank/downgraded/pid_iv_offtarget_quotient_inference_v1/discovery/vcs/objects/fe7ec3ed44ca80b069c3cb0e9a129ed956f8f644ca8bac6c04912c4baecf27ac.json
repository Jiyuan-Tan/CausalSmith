{
  "node_type": "assumption",
  "body": {
    "id": "ass:arm-proportions",
    "kind": "sampling",
    "condition": "\\(\\lim_{n\\to\\infty}n_z/n\\) exists and belongs to \\((0,1)\\) for every \\(z\\in\\mathcal Z\\).",
    "free_symbols": [
      "nz",
      "n",
      "Zset"
    ],
    "standard": {
      "name": "Stable positive randomized-arm proportions",
      "cite": "SongGuoChanRichardson2024"
    }
  }
}