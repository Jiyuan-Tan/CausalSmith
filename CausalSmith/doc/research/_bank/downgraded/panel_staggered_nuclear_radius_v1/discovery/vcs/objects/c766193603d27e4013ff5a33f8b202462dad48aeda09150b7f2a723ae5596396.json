{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-cells",
    "kind": "noise",
    "condition": "\\[\\{E_{n,it}/\\sigma:1\\le i\\le N_n,\\ 1\\le t\\le T_n\\}\\overset{\\mathrm{iid}}{\\sim}\\mathcal N(0,1).\\]",
    "free_symbols": [
      "n",
      "N_n",
      "T_n",
      "E_n",
      "sigma"
    ],
    "constants": [
      "sigma"
    ],
    "standard": {
      "name": "independent Gaussian cell noise",
      "cite": "YanWainwright2024"
    }
  }
}