  "node_type": "assumption",
  "body": {
    "id": "ass:overlap-grams",
    "kind": "identification",
    "condition": "\\[\\min_{b\\in\\mathcal B_n}\\min\\left\\{\\lambda_{\\min}\\!\\left(\\frac{N_n}{|C_b|}U_{n,C_b}^{\\top}U_{n,C_b}\\right),\\lambda_{\\min}\\!\\left(\\frac{T_n}{|P_b|}V_{n,P_b}^{\\top}V_{n,P_b}\\right)\\right\\}\\ge\\kappa.\\]",
    "free_symbols": [
      "n",
      "N_n",
      "T_n",
      "U_n",
      "V_n",
      "B_n",
      "b",
      "C_b",
      "P_b",
      "kappa"
    ],
    "constants": [
      "kappa"
    ],
    "standard": {
      "name": "quantitative observed-subblock factor condition",
      "cite": "YanWainwright2024"
    }
  }
}