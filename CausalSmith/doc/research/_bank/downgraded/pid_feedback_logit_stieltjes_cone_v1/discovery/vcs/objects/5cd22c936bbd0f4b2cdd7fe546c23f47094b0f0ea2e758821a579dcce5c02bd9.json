{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-units",
    "kind": "sampling",
    "condition": "The observed vectors \\((X_i,Y_i)\\), \\(i=1,\\ldots,n\\), are independent and identically distributed with cell law \\(P\\).",
    "free_symbols": [
      "X",
      "Y",
      "P",
      "Phat",
      "n"
    ],
    "standard": {
      "name": "Independent cross-sectional sampling",
      "cite": "chernozhukovHongTamer2007"
    }
  }
}