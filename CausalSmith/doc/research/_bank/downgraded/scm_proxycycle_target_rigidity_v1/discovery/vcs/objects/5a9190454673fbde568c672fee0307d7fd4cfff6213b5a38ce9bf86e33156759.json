{
  "node_type": "assumption",
  "body": {
    "id": "ass:margin-sample-scaling",
    "kind": "sampling",
    "condition": "When design-A margins are estimated, \\(n/n_m\\to\\lambda\\in(0,\\infty)\\).",
    "free_symbols": [
      "n",
      "n_m",
      "\\lambda"
    ],
    "standard": {
      "name": "Independent two-sample proportional asymptotics",
      "cite": "vanDerVaart1998"
    }
  }
}