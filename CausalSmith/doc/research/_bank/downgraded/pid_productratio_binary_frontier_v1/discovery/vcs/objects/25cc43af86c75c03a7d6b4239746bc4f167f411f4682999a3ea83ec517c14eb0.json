  "body": {
    "id": "lem:seven-cell-simplex-agreement",
    "kind": "lemma",
    "statement": "If \\(z\\) is induced by an observed law \\(P\\in\\mathcal M_\\eta\\), then \\(\\psi(z)=(a,q_0,q_1,e_0,e_1,p_0,p_1)\\), \\(\\widetilde f_\\beta^s(z)=f_\\beta^s(P)\\) for every \\(s\\in\\{-,+\\}\\) and \\(\\beta\\in\\{0,1\\}^6\\), and \\(\\widetilde F_s(z)=F_s(P)\\) for both signs. In particular, \\(\\widetilde F_+(z)=\\widetilde f_\\beta^+(z)\\) for every \\(\\beta\\in\\mathcal B_+(P)\\), and \\(\\widetilde F_-(z)=\\widetilde f_\\beta^-(z)\\) for every \\(\\beta\\in\\mathcal B_-(P)\\), including all active ties.",
    "free_symbols": [
      "z",
      "P",
      "eta",
      "psi",
      "a",
      "qvec",
      "evec",
      "pvec",
      "ftildeminus",
      "ftildeplus",
      "fminus",
      "fplus",
      "Ftildeminus",
      "Ftildeplus",
      "Fminus",
      "Fplus",
      "Bminus",
      "Bplus"
    ],
    "depends_on": [
      "def:eta-interior-product-class",
      "def:seven-cell-coordinate-map",
      "def:rational-branch-family",
      "def:seven-cell-simplex-extensions",
