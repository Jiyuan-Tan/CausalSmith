{
  "node_type": "definition",
  "body": {
    "id": "def:compatible-ratio-lift",
    "name": "Compatible ratio lift",
    "construction": "Given \\(s_\\ell\\in[D_G(p_\\ell),U_G(p_\\ell)]\\), \\(r_\\ell=e_\\ell p_\\ell+(1-e_\\ell)s_\\ell\\), \\(t_\\ell\\in[D_B(r_\\ell),U_B(r_\\ell)]\\), and \\(h\\in[D_C(q_0),U_C(q_0)]\\), set \\(\\lambda_1(\\ell,1)=s_\\ell/p_\\ell\\), \\(\\lambda_1(\\ell,0)=(1-s_\\ell)/(1-p_\\ell)\\), \\(\\lambda_{0Y}(\\ell,1)=t_\\ell/r_\\ell\\), \\(\\lambda_{0Y}(\\ell,0)=(1-t_\\ell)/(1-r_\\ell)\\), \\(\\lambda_{0L}(0)=h/q_0\\), and \\(\\lambda_{0L}(1)=(1-h)/q_1\\).",
    "free_symbols": [
      "DK",
      "UK",
      "G",
      "B",
      "C",
      "pvec",
      "evec",
      "qvec",
      "lambda1",
      "lambda0Y",
      "lambda0L"
    ]
  }
}