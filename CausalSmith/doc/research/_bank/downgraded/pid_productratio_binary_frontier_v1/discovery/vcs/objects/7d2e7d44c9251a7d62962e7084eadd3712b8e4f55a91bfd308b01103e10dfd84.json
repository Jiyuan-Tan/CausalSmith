    "id": "def:tan-binary-conservative-values",
    "name": "Binary Proposition 3 values",
    "construction": "Put \\(z_0(k)=(1-B^{-1})k\\), \\(z_1(k)=B-(B-1)k\\), \\(H_\\ell(x,c)=x+(1-e_\\ell)\\{T_G(x,c)-x\\}\\), \\(A_\\ell(c)=\\mathbb E_{W\\sim\\mathrm{Bern}(p_\\ell)}[H_\\ell(W,c)]\\), \\(D_\\ell(k,c)=\\mathbb E_{W\\sim\\mathrm{Bern}(p_\\ell)}[H_\\ell(T_B(W,k),c)]\\), and \\(R_C(v)=\\max_{h\\in[h^-,h^+]}\\{hv_0+(1-h)v_1\\}\\). Then \\(V_1^+=a\\sum_\\ell q_\\ell r_\\ell^+ +(1-a)\\min_{c,k_0,k_1\\in[0,1]}\\sum_\\ell q_\\ell\\{(1-r_\\ell^+)T_C(z_0(k_\\ell),c)+r_\\ell^+T_C(z_1(k_\\ell),c)\\}\\), \\(V_2^+=\\min_{k_0,k_1,c_0,c_1\\in[0,1]}[a\\sum_\\ell q_\\ell A_\\ell(c_\\ell)+(1-a)R_C((D_\\ell(k_\\ell,c_\\ell))_{\\ell=0}^1)]\\), and \\(V^+=\\min\\{V_1^+,V_2^+\\}\\). For \\(j\\in\\{1,2\\}\\), \\(V_j^-(p_0,p_1)=1-V_j^+(1-p_0,1-p_1)\\), and \\(V^-=\\max\\{V_1^-,V_2^-\\}\\).",
    "free_symbols": [
      "TK",
      "B",
      "G",
      "C",
      "evec",
      "pvec",
