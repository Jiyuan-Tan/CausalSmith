{
  "node_type": "assumption",
  "body": {
    "id": "ass:moment-envelope",
    "kind": "regularity",
    "condition": "\\(\\sup_{P_W\\in\\mathcal P_{\\kappa}}\\mathbb E_{P_W}\\|Z(W)\\|^{2+\\delta}\\le C_Z<\\infty\\).",
    "free_symbols": [
      "P_W",
      "\\mathcal P_{\\kappa}",
      "W",
      "Z",
      "\\delta"
    ],
    "constants": [
      "\\(C_Z\\)"
    ],
    "standard": {
      "name": "Lyapunov moment condition",
      "cite": "VanDerVaart1998Asymptotic"
    }
  }
}