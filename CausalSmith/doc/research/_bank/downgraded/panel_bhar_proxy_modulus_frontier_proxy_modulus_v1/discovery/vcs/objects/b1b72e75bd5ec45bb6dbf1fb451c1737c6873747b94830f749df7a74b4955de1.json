{
  "node_type": "assumption",
  "body": {
    "id": "ass:holder-regression",
    "kind": "smoothness",
    "condition": "For every cohort, \\(m_s\\) belongs to the isotropic Holder ball \\(\\mathcal H_d(\\lambda,L)\\) on \\([0,1]^d\\).",
    "free_symbols": [
      "m_s",
      "s",
      "d",
      "lambda",
      "L",
      "Holder_class"
    ],
    "standard": {
      "name": "isotropic Holder regression smoothness",
      "cite": "Stone1982"
    }
  }
}