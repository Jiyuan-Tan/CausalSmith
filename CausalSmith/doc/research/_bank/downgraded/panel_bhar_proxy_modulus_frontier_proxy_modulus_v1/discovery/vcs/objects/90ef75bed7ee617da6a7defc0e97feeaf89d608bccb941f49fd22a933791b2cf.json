{
  "node_type": "assumption",
  "body": {
    "id": "ass:donor-fourth-moment",
    "kind": "regularity",
    "condition": "Conditional on \\(z_0\\), \\(\\mathbb E[\\|\\Sigma^{-1/2}(Z_j-z_0)\\|_2^4\\mid z_0]\\le B^4\\).",
    "free_symbols": [
      "z_0",
      "Sigma",
      "Z_j",
      "j",
      "B"
    ],
    "standard": {
      "name": "bounded fourth moment for covariance estimation",
      "cite": "CattaneoFengTitiunik2021"
    }
  }
}