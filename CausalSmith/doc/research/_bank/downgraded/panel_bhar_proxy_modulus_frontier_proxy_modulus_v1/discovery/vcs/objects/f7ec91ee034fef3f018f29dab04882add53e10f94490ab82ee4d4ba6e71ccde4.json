      "t",
      "T",
      "B_si_obs",
      "s",
      "i",
      "X_st",
      "E_0"
    ],
    "constants": [],
    "standard": {
      "name": "Conditional cross-unit independence",
      "cite": "YanYao2023"
    }
  }
}