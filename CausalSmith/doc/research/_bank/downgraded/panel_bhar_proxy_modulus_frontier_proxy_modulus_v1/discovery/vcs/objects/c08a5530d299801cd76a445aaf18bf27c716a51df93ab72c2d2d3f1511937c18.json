{
  "node_type": "assumption",
  "body": {
    "id": "ass:donor-independence",
    "kind": "sampling",
    "condition": "Conditional on \\(z_0\\), the donor scores \\((Z_j)_{j=1}^{N}\\) are independent and identically distributed.",
    "free_symbols": [
      "z_0",
      "Z_j",
      "j",
      "N"
    ],
    "standard": {
      "name": "independent replicated proxy measurements",
      "cite": "DelaigleHallMeister2008"
    }
  }
}