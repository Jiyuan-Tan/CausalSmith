{
  "node_type": "assumption",
  "body": {
    "id": "ass:interior-event-path",
    "kind": "support",
    "condition": "\\(\\min_{s\\le S}\\operatorname{dist}(z_{0s},\\partial[0,1]^d)\\ge\\delta_0\\).",
    "free_symbols": [
      "s",
      "S",
      "z_0",
      "d",
      "delta_0"
    ],
    "constants": [
      "delta_0"
    ],
    "standard": {
      "name": "Interior point overlap",
      "cite": "Gaiffas2007"
    }
  }
}