{
  "node_type": "assumption",
  "body": {
    "id": "ass:moment-envelope-growth",
    "kind": "empirical process",
    "condition": "\\(\\max_{j\\le J_n}\\|D^0_{J_n,j}\\|_4\\vee\\|\\phi_0\\|_4\\le B_{J_n}\\) and \\(J_n^2B_{J_n}^4\\log(1+J_n)/n=o(\\kappa_{J_n}^2)\\).",
    "free_symbols": [
      "Jn",
      "Dpop",
      "phi0",
      "BJ",
      "n",
      "kappaJ"
    ],
    "standard": {
      "name": "Growing-dictionary fourth-moment condition",
      "cite": "AiChen2012SequentialMoments"
    }
  }
}