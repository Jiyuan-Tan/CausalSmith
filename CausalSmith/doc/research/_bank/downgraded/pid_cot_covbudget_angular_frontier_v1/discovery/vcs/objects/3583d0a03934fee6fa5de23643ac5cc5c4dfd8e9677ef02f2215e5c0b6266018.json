{
  "node_type": "assumption",
  "body": {
    "id": "ass:mean-envelope",
    "kind": "regularity",
    "condition": "\\(\\max\\{\\|\\mu_X\\|_\\infty,|\\mu_0|,|\\mu_1|\\}\\le G\\).",
    "free_symbols": [
      "muX",
      "mu0",
      "mu1",
      "G"
    ],
    "constants": [
      "G"
    ],
    "standard": {
      "name": "Compact mean-parameter envelope",
      "cite": "vandervaart1998asymptotic"
    }
  }
}