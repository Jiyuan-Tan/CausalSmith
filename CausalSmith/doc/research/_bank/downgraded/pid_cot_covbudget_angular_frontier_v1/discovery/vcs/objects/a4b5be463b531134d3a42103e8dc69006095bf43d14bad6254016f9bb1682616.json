{
  "node_type": "assumption",
  "body": {
    "id": "ass:sparse-spectrum",
    "kind": "regularity",
    "condition": "For every \\(U\\subseteq\\{1,\\ldots,p\\}\\) with \\(|U|\\le2k\\), \\(mI_{|U|}\\preceq\\Sigma_{UU}\\preceq MI_{|U|}\\).",
    "free_symbols": [
      "p",
      "k",
      "m",
      "M",
      "Sigma"
    ],
    "constants": [
      "m",
      "M"
    ],
    "standard": {
      "name": "Two-budget sparse eigenvalue condition",
      "cite": "das2011submodular"
    }
  }
}