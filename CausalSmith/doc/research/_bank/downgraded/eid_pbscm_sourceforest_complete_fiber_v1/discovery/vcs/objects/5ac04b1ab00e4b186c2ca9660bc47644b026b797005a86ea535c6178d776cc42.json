  "body": {
    "id": "def:count-cell-map",
    "name": "Finite rational count-cell map",
    "construction": "\\(I_4=\\{x\\in\\mathbb N_0^V:|x|\\le4\\},\\quad T_k(q)=\\sum_{\\ell=1}^{|k|}\\frac{(-1)^{\\ell+1}}{\\ell}\\sum_{x_1+\\cdots+x_\\ell=k,\\,x_a\\ne0}\\prod_{a=1}^{\\ell}\\frac{q_{x_a}}{q_0},\\quad1\\le|k|\\le4\\)",
    "free_symbols": [
      "\\(I_4\\)",
      "\\(V\\)",
      "\\(T(q)\\)"
    ],
    "inputs": [
      "\\(q_x:x\\in I_4\\)"
    ]
  }
}