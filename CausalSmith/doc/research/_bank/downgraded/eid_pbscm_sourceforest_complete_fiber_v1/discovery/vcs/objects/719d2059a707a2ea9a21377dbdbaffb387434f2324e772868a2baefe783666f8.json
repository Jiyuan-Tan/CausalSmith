  "node_type": "assumption",
  "body": {
    "id": "ass:independent-branching-law",
    "kind": "causal-structural",
    "condition": "\\(\\mathcal L\\!\\left(\\varepsilon,(B_{ijr})_{(i,j)\\in E,\\,r\\ge1}\\right)=\\bigotimes_{i\\in V}\\operatorname{Pois}(\\mu_i)\\otimes\\bigotimes_{(i,j)\\in E}\\bigotimes_{r\\ge1}\\operatorname{Bernoulli}(\\alpha_{ij})\\)",
    "free_symbols": [
      "\\(\\varepsilon\\)",
      "\\(B\\)",
      "\\(E\\)",
      "\\(V\\)",
      "\\(\\mu\\)",
      "\\(\\alpha\\)"
    ],
    "standard": {
      "name": "Independent Poisson innovations and independent Bernoulli thinning trials",
      "cite": "xiang2024identifiability"
    }
  }
}