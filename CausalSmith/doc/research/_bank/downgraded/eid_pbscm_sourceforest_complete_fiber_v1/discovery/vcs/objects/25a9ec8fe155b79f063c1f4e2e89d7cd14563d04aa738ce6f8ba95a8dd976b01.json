    "id": "def:source-reversal",
    "name": "Positive source-edge reversal",
    "construction": "\\(\\mathsf R_{u\\to v}(G,\\mu,\\alpha)=(G-u\\to v+v\\to u,\\mu',\\alpha'),\\quad \\mu'_u=\\mu_u(1-\\alpha_{uv}),\\quad\\mu'_v=\\mu_v+\\mu_u\\alpha_{uv},\\quad\\alpha'_{vu}=\\frac{\\mu_u\\alpha_{uv}}{\\mu_v+\\mu_u\\alpha_{uv}},\\quad(\\mu'_i,\\alpha'_e)=(\\mu_i,\\alpha_e)\\text{ otherwise}\\)",
    "free_symbols": [
      "\\(\\mathsf R_{u\\to v}\\)",
      "\\(G\\)",
      "\\(\\mu\\)",
      "\\(\\alpha\\)"
    ],
    "inputs": [
