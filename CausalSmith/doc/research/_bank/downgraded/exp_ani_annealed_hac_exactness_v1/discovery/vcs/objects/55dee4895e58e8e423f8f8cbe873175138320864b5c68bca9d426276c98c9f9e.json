  "body": {
    "name": "\\(\\widehat\\Omega_n^{12}\\)",
    "type": "Two-wave population-variance statistic",
    "def": "\\(\\widehat\\Omega_n^{12}=\\sum_{k=-2r}^{2r}\\{N_{n,k}^{-1}\\sum_{i\\in J_{n,k}}Z_{n,i}^{(1)}Z_{n,i+k}^{(2)}-\\widehat\\tau_n^{(1)}\\widehat\\tau_n^{(2)}\\}\\)",
    "role": "Observable cross-wave diagnostic statistic",
    "refs": [
      "\\(n\\)",
      "\\(r\\)",
      "\\(N_{n,k}\\)",
      "\\(J_{n,k}\\)",
      "\\(Z_{n,i}^{(1)}\\)",
      "\\(Z_{n,i}^{(2)}\\)",
      "\\(\\widehat\\tau_n^{(1)}\\)",
      "\\(\\widehat\\tau_n^{(2)}\\)"
    ]
  }
}