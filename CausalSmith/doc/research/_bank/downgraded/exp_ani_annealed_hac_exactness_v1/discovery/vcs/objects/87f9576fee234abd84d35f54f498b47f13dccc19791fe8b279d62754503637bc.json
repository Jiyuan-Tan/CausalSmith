{
  "node_type": "assumption",
  "body": {
    "id": "ass:graph-edge-range",
    "kind": "regularity",
    "condition": "Every neighbor of \\(i\\) in \\(G\\) belongs to \\(\\{i-r,\\ldots,i+r\\}\\).",
    "free_symbols": [
      "\\(G\\)",
      "\\(r\\)"
    ],
    "standard": {
      "name": "Bounded-range sparse graph specialization",
      "cite": "BaryshnikovYukich2005"
    }
  }
}