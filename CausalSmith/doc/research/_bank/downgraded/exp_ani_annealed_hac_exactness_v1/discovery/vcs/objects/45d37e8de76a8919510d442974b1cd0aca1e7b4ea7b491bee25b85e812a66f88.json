{
  "node_type": "definition",
  "body": {
    "id": "def:diagnostic-test",
    "name": "Finite-sample two-wave boundary test",
    "construction": "For \\(n>4r\\), compute \\(b_n=4(4r+1)^2K^2/N_n\\), \\(q_n(\\delta)=\\{\\sqrt{48n}(2r+1)(4r+1)K^2/(n-4r)\\}\\sqrt{\\log(2/\\delta)}\\), and reject \\(H_0:\\Omega_{\\mathrm{pop}}=0\\) when \\(\\phi_{n,\\alpha}=\\mathbf 1\\{\\widehat\\Omega_n^{12}>b_n+q_n(\\alpha)\\}=1\\).",
    "free_symbols": [
      "\\(n\\)",
      "\\(r\\)",
      "\\(K\\)",
      "\\(N_n\\)",
      "\\(\\delta\\)",
      "\\(b_n\\)",
      "\\(q_n(\\delta)\\)",
      "\\(\\Omega_{\\mathrm{pop}}\\)",
      "\\(\\phi_{n,\\alpha}\\)",
      "\\(\\alpha\\)",
      "\\(\\widehat\\Omega_n^{12}\\)"
    ],
    "inputs": [
      "\\(\\widehat\\Omega_n^{12}\\)",
      "\\(r\\)",
      "\\(K\\)",
      "\\(\\alpha\\)"
    ]
  }
}