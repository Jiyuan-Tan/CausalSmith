{
  "node_type": "assumption",
  "body": {
    "id": "ass:graph-equivariance",
    "kind": "regularity",
    "condition": "The graph rule is translation equivariant: \\(G(\\theta^kU)=\\theta^kG(U)\\) for every \\(k\\in\\mathbb Z\\).",
    "free_symbols": [
      "\\(G\\)",
      "\\(\\theta\\)",
      "\\(U\\)"
    ],
    "standard": {
      "name": "Translation-equivariant local graph rule",
      "cite": "BaryshnikovYukich2005"
    }
  }
}