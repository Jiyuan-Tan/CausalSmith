{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-sampling",
    "kind": "sampling",
    "condition": "\\(O_1,\\ldots,O_n\\) are independent and identically distributed with common law \\(\\Phi_{T,S,B,e}(P)\\).",
    "free_symbols": [
      "T",
      "S",
      "B",
      "e",
      "n",
      "O",
      "P",
      "Phi",
      "Odata"
    ],
    "standard": {
      "name": "Independent sampling",
      "cite": "vanDerVaart1998Asymptotic"
    }
  }
}