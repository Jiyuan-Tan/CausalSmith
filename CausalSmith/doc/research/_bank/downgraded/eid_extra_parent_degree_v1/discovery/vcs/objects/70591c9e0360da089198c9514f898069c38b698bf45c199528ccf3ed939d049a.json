{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-gaussian",
    "kind": "sampling restriction",
    "condition": "\\(X^{(1)},\\ldots,X^{(m)}\\) are independent draws from \\(N(0,\\Sigma)\\).",
    "free_symbols": [
      "X_sample",
      "m",
      "Sigma"
    ],
    "standard": {
      "name": "Independent Gaussian SEM sampling",
      "cite": "FoygelDraismaDrton2012HTC"
    }
  }
}