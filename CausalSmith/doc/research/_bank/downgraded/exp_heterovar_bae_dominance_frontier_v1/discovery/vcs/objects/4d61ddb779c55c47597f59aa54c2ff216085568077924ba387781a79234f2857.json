{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-marginals",
    "kind": "distribution",
    "condition": "For every \\(i\\in\\mathcal A\\) and \\(t\\in\\mathbb N\\), \\(Y_{i,t}\\sim\\mathcal N(\\mu_i,s_i)\\).",
    "free_symbols": [
      "Y",
      "\\mathcal A",
      "\\mu",
      "s"
    ],
    "standard": {
      "name": "Known-variance heteroskedastic Gaussian arm model",
      "cite": "Kato2023WorstCaseGaussian"
    }
  }
}