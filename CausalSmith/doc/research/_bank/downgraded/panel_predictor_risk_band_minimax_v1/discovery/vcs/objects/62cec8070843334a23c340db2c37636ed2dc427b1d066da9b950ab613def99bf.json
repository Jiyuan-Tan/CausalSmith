  "body": {
    "id": "ass:fixed-dimensions",
    "kind": "regularity",
    "condition": "The integers \\(J,K,L,r\\) are fixed, \\(L\\ge r\\), and \\(1\\le r\\le\\min\\{L,J\\}\\).",
    "free_symbols": [
      "J",
      "K",
      "L",
      "r"
    ],
    "standard": {
      "name": "fixed-dimensional synthetic-control factor asymptotics",
      "cite": "Fry2024MomentsSC"
    }
  }
}