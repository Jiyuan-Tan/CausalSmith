{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-sampling",
    "kind": "sampling",
    "condition": "\\(X_1,\\ldots,X_n\\stackrel{\\mathrm{iid}}{\\sim}N_3(0,\\Sigma)\\).",
    "free_symbols": [
      "Xi",
      "n",
      "Sigma"
    ],
    "standard": {
      "name": "Known-zero-mean Gaussian covariance sampling",
      "cite": "Muirhead1982Multivariate"
    }
  }
}