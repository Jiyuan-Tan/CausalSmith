  "node_type": "definition",
  "body": {
    "id": "def:n4-certificate",
    "name": "The \\(n=4\\) saddle certificate",
    "construction": "Let \\(z_4=(3-\\sqrt3)/2\\). Set \\(g_4(0)=0\\), \\(g_4(2)=1/4\\), \\(g_4(4)=z_4\\), and \\(g_4(-w)=-g_4(w)\\). Put mass \\((\\sqrt3-1)/4\\) on each of \\(N=(0,4,0,0)\\) and \\(N=(0,0,4,0)\\), mass \\(z_4\\) on \\(N=(2,0,0,2)\\), and zero elsewhere; this prior is \\(\\pi_4\\).",
    "free_symbols": [
      "z_4",
      "g_4",
      "\\pi_4",
      "N",
      "w"
    ]
  }
}