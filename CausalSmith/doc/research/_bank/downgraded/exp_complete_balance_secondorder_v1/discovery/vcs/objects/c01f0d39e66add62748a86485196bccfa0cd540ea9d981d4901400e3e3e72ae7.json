  "body": {
    "id": "def:n6-algebraic-certificate",
    "name": "The algebraic seven-state \\(n=6\\) certificate",
    "construction": "Define \\(F_6(r_6)=3r_6^2/5-4\\sqrt{10}r_6/15-2r_6/15-2\\sqrt{9r_6^2+2r_6-1}/15+14/45\\), and let \\(s_6\\) be its unique root in \\((29066256529188/10^{14},29066256529190/10^{14})\\). Set \\(u_6=\\sqrt{9s_6^2+2s_6-1}/3\\), \\(v_6=\\sqrt{10}s_6/2\\), \\(z_6=1-s_6\\), and define the odd rule by \\(g_6(0)=0\\), \\(g_6(2)=u_6\\), \\(g_6(4)=v_6\\), and \\(g_6(6)=z_6\\). Set \\(D_6=(2-3u_6)/(9u_6)\\), \\(C_6=2/(3v_6)-1\\), \\(A_6=\\{(3z_6-2)+z_6D_6\\}/\\{10(1-z_6)\\}\\), and \\(B_6=(1+A_6+C_6+D_6)^{-1}\\). The prior \\(\\pi_6\\) assigns masses \\(A_6B_6/2\\) to each of \\((0,6,0,0)\\) and \\((0,0,6,0)\\), \\(B_6/2\\) to each of \\((1,4,0,1)\\) and \\((1,0,4,1)\\), \\(C_6B_6/2\\) to each of \\((2,0,0,4)\\) and \\((4,0,0,2)\\), and \\(D_6B_6\\) to \\((3,0,0,3)\\).",
    "free_symbols": [
      "F_6",
      "r_6",
      "s_6",
      "u_6",
      "v_6",
      "z_6",
      "g_6",
      "D_6",
      "C_6",
      "A_6",
      "B_6",
      "\\pi_6"
    ]
  }
}