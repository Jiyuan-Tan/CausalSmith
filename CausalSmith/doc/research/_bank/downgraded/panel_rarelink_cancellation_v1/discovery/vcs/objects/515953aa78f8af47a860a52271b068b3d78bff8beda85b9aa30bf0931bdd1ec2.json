{
  "node_type": "assumption",
  "body": {
    "id": "ass:bernoulli-role-sampling",
    "kind": "sampling",
    "condition": "For every \\(\\ell,j,n\\) and \\(1\\le a\\le n_{\\ell j}\\), \\(E_{\\ell j a,n}\\sim\\operatorname{Bernoulli}(r_{\\ell j,n})\\).",
    "free_symbols": [
      "Erole",
      "nrole",
      "r",
      "L",
      "J",
      "n"
    ],
    "standard": {
      "name": "Bernoulli sampling of threshold indicators",
      "cite": "BrownCaiDasGupta2001"
    }
  }
}