{
  "node_type": "statement",
  "body": {
    "id": "lem:published-two-arm-airy-law",
    "kind": "lemma",
    "statement": "For the unrestricted two-arm binary-potential-outcome design-estimation game with contrast \\(c=(1,-1)\\), the minimax risk satisfies\n\\[\nR_n(c)=\\frac1n-C_An^{-4/3}+o(n^{-4/3}).\n\\]",
    "free_symbols": [
      "c",
      "R_n(c)",
      "n",
      "C_A"
    ],
    "depends_on": [
      "def:risk-game",
      "def:airy-constant"
    ],
    "source": {
      "cite": "SudijonoDobribanTchetgen2026",
      "locator": "Theorems 2.2 and 3.1 of arXiv:2608.13822v1",
      "carrier": "logical-claim",
      "verbatim_statement": "\\(\\inf_{\\mathcal A,\\widehat\\tau}\\sup_{\\mathcal P\\in\\{0,1\\}^{2n}}R_n(\\mathcal A,\\widehat\\tau)=\\rho_n^*\\) and \\(\\rho_n^*=n^{-1}-C_An^{-4/3}+o_n(n^{-4/3})\\).",
      "attestation": {
        "by": "d0-agent",
        "note": "Transcribed from arXiv:2608.13822v1, Theorem 2.2, equation (2.5), and Theorem 3.1."
      }
    }
  }
}