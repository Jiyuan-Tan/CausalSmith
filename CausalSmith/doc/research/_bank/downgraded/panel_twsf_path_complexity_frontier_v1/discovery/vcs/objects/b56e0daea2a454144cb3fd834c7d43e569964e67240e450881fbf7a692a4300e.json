{
  "node_type": "assumption",
  "body": {
    "id": "ass:variance-floor",
    "kind": "nondegeneracy",
    "condition": "For a fixed \\(c_v>0\\), \\(\\min_{m\\in\\{\\mathrm{dir},\\mathrm{rec}\\},\\ell\\le H_n}s_{m,n,\\ell}\\ge c_vn^{-1/2}\\).",
    "free_symbols": [
      "s_{m,n,\\ell}",
      "H_n",
      "n"
    ],
    "constants": [
      "c_v"
    ],
    "standard": {
      "name": "Uniform marginal-variance nondegeneracy without an eigenvalue bound",
      "cite": "ChernozhukovChetverikovKato2015"
    }
  }
}