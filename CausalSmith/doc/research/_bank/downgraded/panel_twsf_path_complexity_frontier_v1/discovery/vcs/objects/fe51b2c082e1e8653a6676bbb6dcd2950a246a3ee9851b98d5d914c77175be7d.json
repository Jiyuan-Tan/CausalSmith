{
  "node_type": "assumption",
  "body": {
    "id": "ass:bounded-means",
    "kind": "moment",
    "condition": "All entries of the conditional-mean blocks and all conditional target means have absolute value at most a fixed constant \\(C_\\mu\\).",
    "free_symbols": [
      "\\bar Y_n",
      "\\bar y_n",
      "\\bar Z_{m,n}",
      "\\bar z_{\\mathrm{dir},n,\\ell}",
      "\\bar z_{\\mathrm{rec},n}",
      "\\bar W_n",
      "\\theta_{n,\\ell}"
    ],
    "constants": [
      "C_\\mu"
    ],
    "standard": {
      "name": "Uniformly bounded TWSF signal",
      "cite": "Shen2026TWSF"
    }
  }
}