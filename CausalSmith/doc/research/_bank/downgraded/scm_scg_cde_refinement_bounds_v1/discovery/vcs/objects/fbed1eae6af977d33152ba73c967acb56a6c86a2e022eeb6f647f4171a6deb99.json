{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-window-sampling",
    "kind": "sampling",
    "condition": "The \\(n\\) observed vectors are independent draws from the multinomial law \\(p\\) on \\(\\{0,1\\}^{\\mathcal W_H}\\).",
    "free_symbols": [
      "n",
      "p",
      "\\mathcal W_H"
    ],
    "standard": {
      "name": "multinomial sampling model",
      "cite": "MalloyTripathyNowak2020"
    }
  }
}