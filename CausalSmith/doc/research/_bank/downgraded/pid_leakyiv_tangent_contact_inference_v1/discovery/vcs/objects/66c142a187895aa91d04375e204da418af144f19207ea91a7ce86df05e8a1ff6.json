{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-centered",
    "kind": "sampling",
    "condition": "The observations \\(W_1,\\ldots,W_n\\) are independent draws from \\(P\\) and satisfy \\(E_P[W_i]=0\\).",
    "free_symbols": [
      "n",
      "W_i",
      "P"
    ],
    "standard": {
      "name": "centered i.i.d. sampling",
      "cite": "watson2024bounding"
    }
  }
}