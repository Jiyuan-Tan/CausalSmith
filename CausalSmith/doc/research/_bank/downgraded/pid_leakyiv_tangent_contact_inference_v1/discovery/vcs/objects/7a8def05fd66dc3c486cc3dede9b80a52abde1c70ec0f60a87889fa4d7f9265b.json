  "body": {
    "id": "ass:score-nondegeneracy",
    "kind": "regularity",
    "condition": "The score variance satisfies \\(c_{\\sigma}\\leq\\inf_{\\theta\\in K}\\sigma_P(\\theta)\\leq\\sup_{\\theta\\in K}\\sigma_P(\\theta)\\leq C_{\\sigma}\\).",
    "free_symbols": [
      "c_sigma",
      "C_sigma",
      "K",
      "sigma",
      "P"
    ],
    "standard": {
      "name": "uniform nondegenerate studentization",
      "cite": "chernozhukovChetverikovKato2013gaussian"
    }
  }
}