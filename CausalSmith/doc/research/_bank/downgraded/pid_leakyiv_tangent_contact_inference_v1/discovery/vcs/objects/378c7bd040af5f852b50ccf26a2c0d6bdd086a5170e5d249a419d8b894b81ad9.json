{
  "node_type": "assumption",
  "body": {
    "id": "ass:contact-competitor-coverage",
    "kind": "decision-class",
    "condition": "A competing sequence \\(D_n\\) satisfies \\(\\liminf_{n\\to\\infty}\\inf_{h\\in[0,\\bar H]}P_{n,h}\\{\\Theta_I(P_{n,h})\\subseteq D_n\\}\\geq1-\\eta\\).",
    "free_symbols": [
      "D_n",
      "n",
      "H_bar",
      "P_nh",
      "Theta_I",
      "eta"
    ],
    "standard": {
      "name": "uniform whole-identified-set coverage requirement",
      "cite": "romanoShaikh2010identifiedSet"
    }
  }
}