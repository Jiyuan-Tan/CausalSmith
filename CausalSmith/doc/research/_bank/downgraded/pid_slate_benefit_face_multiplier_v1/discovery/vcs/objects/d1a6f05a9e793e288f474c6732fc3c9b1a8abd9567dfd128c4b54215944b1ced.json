{
  "node_type": "assumption",
  "body": {
    "id": "ass:raw-covariance-band",
    "kind": "regularity",
    "condition": "Every eigenvalue of \\(\\Sigma_{c,n}\\) on the nonredundant conditional-contrast space lies in \\([\\underline\\lambda,\\overline\\lambda]\\).",
    "free_symbols": [
      "\\(\\Sigma_{c,n}\\)",
      "\\(\\underline\\lambda\\)",
      "\\(\\overline\\lambda\\)"
    ],
    "constants": [
      "\\(\\underline\\lambda\\)",
      "\\(\\overline\\lambda\\)"
    ],
    "standard": {
      "name": "finite-dimensional nondegenerate Gaussian covariance band",
      "cite": "ChernozhukovChetverikovKato2017"
    }
  }
}