{
  "node_type": "assumption",
  "body": {
    "id": "ass:weak-selection-monotonicity",
    "kind": "identification",
    "condition": "For each \\(x\\in\\mathcal X\\), \\(\\sigma_{n,x}\\{S_{ni}(1)-S_{ni}(0)\\}\\ge0\\) almost surely conditional on \\(C_{ni}=1\\) and \\(X_{ni}=x\\).",
    "free_symbols": [
      "\\(\\mathcal X\\)",
      "\\(P_n\\)",
      "\\(X_{ni}\\)",
      "\\(S_{ni}(d)\\)",
      "\\(C_{ni}\\)",
      "\\(\\sigma_{n,x}\\)"
    ],
    "standard": {
      "name": "covariate-specific weak sample-selection monotonicity",
      "cite": "DongHeiler2026"
    }
  }
}