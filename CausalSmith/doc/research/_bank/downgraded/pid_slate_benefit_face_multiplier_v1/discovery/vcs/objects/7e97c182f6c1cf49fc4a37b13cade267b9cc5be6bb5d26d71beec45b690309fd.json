{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-row",
    "kind": "sampling",
    "condition": "For every \\(n\\), \\(O_{n1},\\ldots,O_{nn}\\) are independent and identically distributed under \\(P_n\\).",
    "free_symbols": [
      "n",
      "\\(O_{ni}\\)",
      "\\(P_n\\)"
    ],
    "standard": {
      "name": "row-wise i.i.d. triangular-array sampling",
      "cite": "ChernozhukovChetverikovKato2017"
    }
  }
}