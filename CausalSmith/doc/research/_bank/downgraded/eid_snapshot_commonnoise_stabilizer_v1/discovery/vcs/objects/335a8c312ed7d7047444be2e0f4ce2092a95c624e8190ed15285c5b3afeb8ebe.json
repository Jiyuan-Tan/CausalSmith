{
  "node_type": "assumption",
  "body": {
    "id": "ass:sample-shares",
    "kind": "regularity",
    "condition": "For every \\(k\\in K\\), \\(n_k/N\\to\\pi_k\\in(0,1)\\).",
    "free_symbols": [
      "K",
      "n_k",
      "N",
      "pi_k"
    ],
    "standard": {
      "name": "Positive limiting sample shares",
      "cite": "KoltchinskiiLounici2017"
    }
  }
}