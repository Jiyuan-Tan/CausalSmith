{
  "node_type": "assumption",
  "body": {
    "id": "ass:linear-flow",
    "kind": "causal-structural",
    "condition": "For every \\(k\\in K\\), the latent state obeys \\(X_k=V^k(X_0-x^\\star)+x^\\star\\) with \\(V=\\exp(hG)\\).",
    "free_symbols": [
      "K",
      "X_k",
      "V",
      "xstar",
      "h",
      "G"
    ],
    "standard": {
      "name": "Time-homogeneous linear flow",
      "cite": "WangEtAl2024"
    }
  }
}