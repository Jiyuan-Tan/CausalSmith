{
  "node_type": "assumption",
  "body": {
    "id": "ass:common-measurement-noise",
    "kind": "measurement",
    "condition": "For every \\(k\\in K\\), \\(\\varepsilon_k\\sim\\mathcal N(0,E)\\) with the same \\(E\\succ0\\).",
    "free_symbols": [
      "K",
      "epsilon_k",
      "E"
    ],
    "standard": {
      "name": "Time-homogeneous Gaussian measurement covariance",
      "cite": "DunikEtAl2017"
    }
  }
}