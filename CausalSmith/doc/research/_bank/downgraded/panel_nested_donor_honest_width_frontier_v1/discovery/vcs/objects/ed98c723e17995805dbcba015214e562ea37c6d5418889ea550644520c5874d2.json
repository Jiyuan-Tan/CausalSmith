{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-law",
    "kind": "sampling-law",
    "condition": "\\(Q-m\\sim N(0,\\Sigma_Q)\\) conditional on \\(x\\) and \\(T_{\\mathrm{adopt}}\\).",
    "free_symbols": [
      "Q",
      "m",
      "SigmaQ",
      "x",
      "Tadopt"
    ],
    "standard": {
      "name": "Known-covariance Gaussian fixed-design experiment",
      "cite": "ArmstrongKolesar2018"
    }
  }
}