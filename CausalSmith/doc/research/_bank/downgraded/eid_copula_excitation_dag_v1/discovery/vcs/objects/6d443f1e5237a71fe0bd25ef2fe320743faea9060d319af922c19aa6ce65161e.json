{
  "node_type": "assumption",
  "body": {
    "id": "ass:independent-gaussian-innovations",
    "kind": "distributional",
    "condition": "\\(\\varepsilon_e\\sim\\mathcal N(0,\\operatorname{diag}(v)D_e)\\) for every \\(e\\in\\mathcal E\\).",
    "free_symbols": [
      "epsilon",
      "e",
      "v",
      "D",
      "calE"
    ],
    "standard": {
      "name": "Independent Gaussian innovations under diagonal noise interventions",
      "cite": "GamellaEtAl2022GnIES"
    }
  }
}