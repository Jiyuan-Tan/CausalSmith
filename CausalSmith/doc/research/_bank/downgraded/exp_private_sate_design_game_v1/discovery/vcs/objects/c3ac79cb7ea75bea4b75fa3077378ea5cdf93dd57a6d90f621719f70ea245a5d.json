  "body": {
    "id": "ass:conditional-product",
    "kind": "privacy randomization",
    "condition": "\\(\\Pr(Z=z\\mid s,W,Q)=\\prod_{i\\in I}Q(z_i\\mid W_i,Y_i(W_i))\\).",
