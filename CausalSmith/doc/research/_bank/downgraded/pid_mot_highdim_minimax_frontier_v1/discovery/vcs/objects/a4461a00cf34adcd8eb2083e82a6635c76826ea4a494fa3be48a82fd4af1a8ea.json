  "node_type": "assumption",
  "body": {
    "id": "ass:star-complete-randomization",
    "kind": "assignment",
    "condition": "\\(\\mathcal L((W_j^{\\mathrm{STAR}})_{j\\in\\mathcal J^{\\mathrm{STAR}}}\\mid(U_j^{\\mathrm{STAR}})_{j\\in\\mathcal J^{\\mathrm{STAR}}})=\\operatorname{Unif}\\{w\\in\\{1,2,3\\}^{234}:\\sum_{j=1}^{234}\\mathbf 1\\{w_j=k\\}=n_k^{\\mathrm{STAR}}\\text{ for }k=1,2,3\\}\\).",
    "free_symbols": [
      "WSTARj",
      "JSTAR",
      "USTARj",
      "nSTAR"
    ],
    "standard": {
      "name": "Complete randomized assignment with fixed treatment-cell counts",
      "cite": "angrist_lang_oreopoulos_2009"
    }
  }
}