  "node_type": "statement",
  "body": {
    "id": "thm:conditional-multiplier",
    "kind": "theorem",
    "statement": "Construct \\(\\widetilde\\Psi_i\\), \\(\\widehat\\Gamma\\), and \\(G_n^*\\) with the common total ridge convention \\((\\widehat H_c^{\\mathrm{tot}})^{-1}\\). Under the explicit uniform estimated-influence replacement condition \\(\\delta_n=o_{\\mathbb P}(1)\\), the covariance estimator is uniformly consistent, \\(\\sup_{c,t\\in\\mathcal C}\\|\\widehat\\Gamma(c,t)-\\Gamma(c,t)\\|\\to_{\\mathbb P}0\\), and the conditional law of the stacked shared-multiplier process \\(G_n^*\\) given \\(O_1,\\ldots,O_n\\) converges in probability in bounded-Lipschitz distance on \\(C(\\mathcal C)^{d+4}\\) to the law of \\(G\\). The event \\(\\mathcal E_n\\) has probability tending to one and, on that event, the total ridge convention equals ordinary Hessian inversion simultaneously for every \\(c\\in\\mathcal C\\).",
    "free_symbols": [
      "\\(c\\)",
      "\\(\\mathcal C\\)",
      "\\(\\widehat\\Gamma\\)",
      "\\(\\Gamma\\)",
      "\\(G_n^*\\)",
      "\\(O_i\\)",
      "n",
      "d",
      "\\(G\\)",
      "\\(\\delta_n\\)",
      "\\(\\widetilde\\Psi_i\\)",
      "\\(\\widehat H_c^{\\mathrm{tot}}\\)",
      "\\(\\mathcal E_n\\)"
    ],
    "depends_on": [
      "ass:iid",
      "ass:bounded-outcome",
      "ass:overlap",
      "ass:bounded-features",
      "ass:uniform-curvature",
      "ass:outcome-estimability",
      "ass:propensity-estimability",
