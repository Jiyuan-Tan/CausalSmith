{
  "node_type": "assumption",
  "body": {
    "id": "ass:propensity-estimability",
    "kind": "nuisance",
    "condition": "Each \\(e_a\\) is \\(L^2(P_X)\\)-estimable at the deterministic rate \\(r_{e,n}\\to0\\), uniformly over the fixed set \\(\\mathcal A\\).",
    "free_symbols": [
      "\\(e_a\\)",
      "\\(P_X\\)",
      "\\(r_{e,n}\\)",
      "\\(\\mathcal A\\)"
    ],
    "standard": {
      "name": "cross-fitted propensity estimability",
      "cite": "ChernozhukovEtAl2018DML"
    }
  }
}