{
  "node_type": "assumption",
  "body": {
    "id": "ass:outcome-estimability",
    "kind": "nuisance",
    "condition": "Each \\(m_a\\) is \\(L^2(P_X)\\)-estimable at the deterministic rate \\(r_{m,n}\\to0\\), uniformly over the fixed set \\(\\mathcal A\\).",
    "free_symbols": [
      "\\(m_a\\)",
      "\\(P_X\\)",
      "\\(r_{m,n}\\)",
      "\\(\\mathcal A\\)"
    ],
    "standard": {
      "name": "cross-fitted outcome-regression estimability",
      "cite": "ChernozhukovEtAl2018DML"
    }
  }
}