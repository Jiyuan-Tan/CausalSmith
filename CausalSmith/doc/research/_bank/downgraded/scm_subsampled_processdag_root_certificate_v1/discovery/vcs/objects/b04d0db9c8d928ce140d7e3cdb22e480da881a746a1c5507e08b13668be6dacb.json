{
  "node_type": "assumption",
  "body": {
    "id": "ass:gaussian-innovations",
    "kind": "distribution",
    "condition": "The sequence \\((\\varepsilon_t)_{t\\in\\mathbb Z}\\) is independent and identically distributed as \\(N(0,D)\\).",
    "free_symbols": [
      "epsilon",
      "D"
    ],
    "standard": {
      "name": "Gaussian white-noise innovations",
      "cite": "gong2015discovering"
    }
  }
}