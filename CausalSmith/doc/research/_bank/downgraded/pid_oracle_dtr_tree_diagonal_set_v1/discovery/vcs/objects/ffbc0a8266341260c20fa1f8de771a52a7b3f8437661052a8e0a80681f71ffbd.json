{
  "node_type": "assumption",
  "body": {
    "id": "ass:swig-modularity",
    "kind": "causal-model",
    "condition": "\\(\\kappa^d_{Q,v}(\\cdot\\mid u)=\\kappa^{d'}_{Q,v}(\\cdot\\mid u')\\) whenever \\((d,u)\\sim_v(d',u')\\), \\(Q\\{O^d_{\\operatorname{pa}_d(v)}=u\\}>0\\), and \\(Q\\{O^{d'}_{\\operatorname{pa}_{d'}(v)}=u'\\}>0\\)",
    "free_symbols": [
      "\\kappa^d_{Q,v}",
      "\\sim_v",
      "\\mathcal D",
      "Q",
      "O^d",
      "\\operatorname{pa}_d(v)"
    ],
    "standard": {
      "name": "Reached-history SWIG modularity",
      "cite": "RichardsonRobins2013SWIG"
    }
  }
}