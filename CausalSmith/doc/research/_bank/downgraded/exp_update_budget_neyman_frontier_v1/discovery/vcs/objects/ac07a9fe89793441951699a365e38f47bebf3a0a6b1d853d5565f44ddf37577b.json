  "body": {
    "id": "def:oracle-loss",
    "name": "Constrained Neyman loss and regret",
    "construction": "For \\(p\\in[1/4,3/4]\\), \\(f_\\sigma(p)=\\sigma_1^2/p+\\sigma_0^2/(1-p)\\), \\(p^*(\\sigma)=\\operatorname{clip}_{[1/4,3/4]}\\{\\sigma_1/(\\sigma_1+\\sigma_0)\\}\\), \\(V^*(\\sigma)=f_\\sigma(p^*(\\sigma))\\), and \\(r_\\sigma(p)=f_\\sigma(p)-V^*(\\sigma)\\).",
    "free_symbols": [
      "f_\\sigma",
      "\\sigma",
      "p^*(\\sigma)",
      "V^*(\\sigma)",
      "r_\\sigma"
    ],
    "inputs": [
      "\\sigma"
    ]
  }
}