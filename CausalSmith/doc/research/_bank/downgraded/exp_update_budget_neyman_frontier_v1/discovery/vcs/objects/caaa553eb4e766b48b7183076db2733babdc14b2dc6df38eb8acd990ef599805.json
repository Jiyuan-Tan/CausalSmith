    "id": "prop:risk-decomposition",
    "kind": "proposition",
    "statement": "For every \\(d\\in\\mathfrak D_{n,B}\\), \\(\\widehat\\tau_d\\) is unbiased for \\(\\tau\\) and \\[\\mathcal R_{n,B}(d;\\mu,\\sigma)=V^*(\\sigma)\\sum_{b=1}^B\\frac{(w_b-t_b)^2}{t_b}+\\sum_{b=1}^B\\frac{w_b^2}{t_b}\\,\\mathbb E_{P^{d}_{\\mu,\\sigma}}[r_\\sigma(p_b)].\\]",
    "free_symbols": [
      "d",
      "\\mathfrak D_{n,B}",
      "n",
      "B",
      "\\widehat\\tau_d",
      "\\tau",
      "\\mathcal R_{n,B}",
      "\\mu",
      "\\sigma",
      "V^*(\\sigma)",
      "w",
      "t",
      "P^{d}_{\\mu,\\sigma}",
      "r_\\sigma",
      "p"
    ],
    "depends_on": [
      "prop:observed-law-wellposed",
      "ass:predictable-counts",
      "ass:deterministic-simplex-weights",
      "def:batch-contrast",
      "def:weighted-estimator",
