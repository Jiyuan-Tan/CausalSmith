{
  "node_type": "assumption",
  "body": {
    "id": "ass:bernoulli-response",
    "kind": "regularity",
    "condition": "\\(Y\\mid(X=x,A=a)\\sim\\operatorname{Bernoulli}(\\mu_{a,P}(x))\\) for every \\(a\\in\\{0,1\\}\\) and \\(P_X\\)-almost every \\(x\\in\\mathcal X\\).",
    "free_symbols": [
      "Y",
      "X",
      "A",
      "mu0P",
      "mu1P",
      "P",
      "Xspace"
    ],
    "standard": {
      "name": "Binary conditional-response experiment",
      "cite": "KennedyBalakrishnanRobinsWasserman2024MinimaxCATE"
    }
  }
}