    {
      "id": "thm:rational-certificate-termination",
      "proposed": {
        "tex_ref": "proposed-certificate-statement"
      },
      "reason": "As stated, the theorem quantifies over an empty certifiable feasible set. In that case the certificate definition would require rational numbers satisfying inequalities against an infimum of plus infinity and a supremum of minus infinity, which is impossible. Restricting termination and finite endpoint enclosures to the nonempty-feasible regime is necessary. This does not weaken the advertised containment: whenever the target fiber is nonempty on \\(p_0\\in C_n\\), it itself makes the confidence-feasible set nonempty, while an empty target fiber is contained trivially.",
      "direction": "narrow"
    }
