{
  "node_type": "assumption",
  "body": {
    "id": "ass:categorical-lipschitz",
    "kind": "mechanism-regularity",
    "condition": "For every categorical vertex \\(v\\), \\(\\pi_v\\) is \\(L_v\\)-Lipschitz in \\(\\ell_1\\) distance.",
    "free_symbols": [
      "V",
      "pi_v",
      "L_v"
    ],
    "standard": {
      "name": "Lipschitz categorical-propensity regularity",
      "cite": "TanBlanchetSyrgkanis2024"
    }
  }
}