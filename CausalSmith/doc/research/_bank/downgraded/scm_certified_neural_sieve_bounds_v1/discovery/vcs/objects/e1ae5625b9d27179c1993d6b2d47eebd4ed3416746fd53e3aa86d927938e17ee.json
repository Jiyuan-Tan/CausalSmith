{
  "node_type": "assumption",
  "body": {
    "id": "ass:bounded-density",
    "kind": "latent-regularity",
    "condition": "For every district \\(D\\), \\(0\\le\\rho_D(u)\\le B_D\\) for Lebesgue-almost every \\(u\\in\\mathcal U_D\\).",
    "free_symbols": [
      "D",
      "rho_D",
      "B_D",
      "U_D"
    ],
    "standard": {
      "name": "Uniformly bounded density class",
      "cite": "Tsybakov2009"
    }
  }
}