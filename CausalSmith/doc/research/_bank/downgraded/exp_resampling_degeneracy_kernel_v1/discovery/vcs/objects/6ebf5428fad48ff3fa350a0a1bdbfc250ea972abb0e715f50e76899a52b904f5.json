    "id": "def:subset-degeneracy",
    "name": "Subset degeneracy",
    "construction": "For \\(\\varnothing\\neq A\\subseteq\\Omega\\), \\(d_K(A)=\\min_{\\sigma\\in\\operatorname{Ord}(A)}\\max_{1\\leq j\\leq|A|}K(\\sigma_j,P_j(\\sigma))\\), where \\(P_j(\\sigma)=\\{\\sigma_1,\\ldots,\\sigma_j\\}\\), and \\(d_K(\\varnothing)=0\\).",
    "free_symbols": [
      "d_K",
      "K",
      "A",
      "\\Omega",
      "\\sigma",
      "P_j"
    ],
    "inputs": [
      "K",
      "A"
    ]
  }
}