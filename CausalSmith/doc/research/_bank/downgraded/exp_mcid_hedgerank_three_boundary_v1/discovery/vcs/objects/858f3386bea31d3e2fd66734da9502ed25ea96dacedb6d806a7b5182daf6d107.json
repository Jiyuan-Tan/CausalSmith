{
  "node_type": "assumption",
  "body": {
    "id": "ass:bow-free",
    "kind": "graphical",
    "condition": "For every distinct \\(u,v\\in V\\), \\((u,v)\\in D\\) or \\((v,u)\\in D\\) implies \\(\\{u,v\\}\\notin B\\).",
    "free_symbols": [
      "V",
      "D",
      "B"
    ],
    "standard": {
      "name": "Bow-free mixed graph condition",
      "cite": "RichardsonSpirtes2002"
    }
  }
}