{
  "node_type": "assumption",
  "body": {
    "id": "ass:primitive-moment-envelope",
    "kind": "empirical-process",
    "condition": "There exist fixed \\(\\delta>0\\) and \\(C<\\infty\\) such that \\(\\sup_n E_{P_n}[\\|h(O_{n1})-\\mu_n\\|^{4+\\delta}]\\le C\\).",
    "free_symbols": [
      "n",
      "h(O)",
      "O_{nr}",
      "\\mu_n",
      "P_n"
    ],
    "constants": [
      "\\(\\delta\\)",
      "\\(C\\)"
    ],
    "standard": {
      "name": "Uniform Lyapunov moment condition",
      "cite": "vanDerVaart1998"
    }
  }
}