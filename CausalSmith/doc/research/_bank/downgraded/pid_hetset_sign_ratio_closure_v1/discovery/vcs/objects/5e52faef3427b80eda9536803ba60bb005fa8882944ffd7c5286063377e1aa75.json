{
  "node_type": "assumption",
  "body": {
    "id": "ass:iid-triangular-sampling",
    "kind": "sampling",
    "condition": "For each \\(n\\), \\(O_{n1},\\ldots,O_{nn}\\) are independent and identically distributed under \\(P_n\\).",
    "free_symbols": [
      "n",
      "O_{nr}",
      "P_n"
    ],
    "standard": {
      "name": "Row-wise i.i.d. triangular-array sampling",
      "cite": "KaidoMolinariStoye2019"
    }
  }
}