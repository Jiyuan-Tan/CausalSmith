{
  "node_type": "assumption",
  "body": {
    "id": "ass:primitive-covariance",
    "kind": "regularity",
    "condition": "There exist fixed \\(0<c<C<\\infty\\) such that every eigenvalue of \\(\\Omega_n\\) lies in \\([c,C]\\).",
    "free_symbols": [
      "\\Omega_n"
    ],
    "constants": [
      "\\(c\\)",
      "\\(C\\)"
    ],
    "standard": {
      "name": "Uniform nonsingular covariance",
      "cite": "KaidoMolinariStoye2019"
    }
  }
}