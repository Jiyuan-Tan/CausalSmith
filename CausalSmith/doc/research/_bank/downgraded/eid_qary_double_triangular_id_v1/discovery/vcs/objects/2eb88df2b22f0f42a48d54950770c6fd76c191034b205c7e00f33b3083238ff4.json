      "\\(X_{\\mathrm{bin}}\\)",
      "K",
      "J",
      "\\(\\Lambda_{\\mathrm{bin}}\\)",
      "\\(\\Gamma_{\\mathrm{bin}}\\)"
    ],
    "standard": {
      "name": "binary causal Markov factorization",
      "cite": "LeeGu2026DTBLCM"
    }
  }
}