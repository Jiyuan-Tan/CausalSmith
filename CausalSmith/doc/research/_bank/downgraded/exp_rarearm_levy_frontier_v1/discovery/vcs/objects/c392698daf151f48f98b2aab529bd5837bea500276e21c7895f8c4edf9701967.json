{
  "node_type": "symbol",
  "body": {
    "name": "Hramp",
    "type": "deterministic function family",
    "def": "\\(H_{b,h}(z)=0\\) if \\(|z|\\le b\\), \\(H_{b,h}(z)=(|z|-b)/h\\) if \\(b<|z|<b+h\\), and \\(H_{b,h}(z)=1\\) if \\(|z|\\ge b+h\\)",
    "role": "atom-safe smoothed tail indicator",
    "refs": [
      "h"
    ]
  }
}