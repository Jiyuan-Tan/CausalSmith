{
  "node_type": "assumption",
  "body": {
    "id": "ass:moment-radius",
    "kind": "regularity",
    "condition": "\\(\\max_{c\\in[C]}\\mathbb E_P[\\|\\lambda_i\\|^{4+\\delta}+\\|\\varepsilon_i\\|^{4+\\delta}\\mid C_i=c]\\le M_{\\mathrm{mom}}\\)",
    "free_symbols": [
      "P",
      "lambda",
      "epsilon",
      "delta",
      "C",
      "Mmom"
    ],
    "constants": [
      "\\(\\delta\\)",
      "\\(M_{\\mathrm{mom}}\\)"
    ],
    "standard": {
      "name": "Uniform Lyapunov moment bound",
      "cite": "vanDerVaart1998"
    }
  }
}