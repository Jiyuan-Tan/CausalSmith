{
  "node_type": "assumption",
  "body": {
    "id": "ass:treated-residual-variance",
    "kind": "moment",
    "condition": "\\(E_P[(Y-g_1(X))^2\\mid D=1,X]\\le\\sigma_1^2\\) holds \\(P\\)-almost surely.",
    "free_symbols": [
      "P",
      "Y",
      "g_1",
      "X",
      "D",
      "\\sigma_1^2"
    ],
    "standard": {
      "name": "uniform treated residual second moment",
      "cite": "Dorn2025WeakOverlapTStatistics"
    }
  }
}