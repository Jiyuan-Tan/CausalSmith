{
  "node_type": "assumption",
  "body": {
    "id": "ass:control-residual-variance",
    "kind": "moment",
    "condition": "\\(E_P[(Y-g_0(X))^2\\mid D=0,X]\\le\\sigma_0^2\\) holds \\(P\\)-almost surely.",
    "free_symbols": [
      "P",
      "Y",
      "g_0",
      "X",
      "D",
      "\\sigma_0^2"
    ],
    "standard": {
      "name": "uniform control residual second moment",
      "cite": "Dorn2025WeakOverlapTStatistics"
    }
  }
}