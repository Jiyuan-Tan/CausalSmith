{
  "node_type": "assumption",
  "body": {
    "id": "ass:c2-bernoulli-outcomes",
    "kind": "primitive",
    "condition": "\\(\\mathcal L_P(Y\\mid A=a,X=x)=\\operatorname{Bernoulli}[(1-a)\\mu_0(x)+a\\mu_1(x)]\\) for \\(a\\in\\{0,1\\}\\).",
    "free_symbols": [
      "P",
      "Y",
      "A",
      "X",
      "mu0",
      "mu1"
    ],
    "standard": {
      "name": "Binary conditional outcome model",
      "cite": "NaimiEtAl2021TimeFixed"
    }
  }
}