module
public import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-!
# Measurable space on finite lists

The sigma algebra is generated by all finite-coordinate observations, with
`none` recording coordinates past the end of a list.
-/

@[expose] public section

instance {α : Type*} [MeasurableSpace α] : MeasurableSpace (List α) :=
  MeasurableSpace.generateFrom
    {s | ∃ (k : Nat) (A : Set α), MeasurableSet A ∧
      s = {l : List α | ∃ a ∈ A, l[k]? = some a}}
