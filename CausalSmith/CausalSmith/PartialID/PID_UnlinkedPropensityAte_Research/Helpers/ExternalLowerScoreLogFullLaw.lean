/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,hg,x,y,z,hxy,hyz,s,hs0,hs1,u,hu0,hu), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTriplePerturbed_externalScoreLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (hg : Measurable g) (x y z : ScoreSpace ε)
    (hxy : x < y) (hyz : y < z)
    (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (u : ℝ) (hu0 : 0 ≤ u) (hu : u * ((z : ℝ) - x) ≤ 1 / 3) :
    ExternalScoreLaw g (scoreLogTriplePerturbedFullLaw g x y z s u)
      (scoreLogTriplePerturbed x y z u) where
  probabilityP := scoreLogTriplePerturbedFullLaw_isProbabilityMeasure
    g hOverlap x y z hxy hyz s hs0 hs1 u hu0 hu
  probabilityH :=
    scoreLogTriplePerturbed_isProbabilityMeasure x y z hxy hyz u hu0 hu
  overlap := hOverlap
  measurableRelease := hg
  scoreMarginal :=
    scoreLogTriplePerturbedFullLaw_scoreMarginal g hOverlap x y z s hs0 hs1 u
  randomizedAssignment := scoreLogTripleFullLaw_randomizedAssignment
    g hOverlap x y z s hs0 hs1
      (1 / 3 + u * ((z : ℝ) - y))
      (1 / 3 - u * ((z : ℝ) - x))
      (1 / 3 + u * ((y : ℝ) - x))
  consistency := scoreLogTriplePerturbedFullLaw_consistency g x y z s u
  deterministicRelease :=
    scoreLogTriplePerturbedFullLaw_deterministicRelease g hg x y z s u

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,e,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_releasedLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (e : ScoreSpace ε)
    (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    releasedLaw (scoreLogAtomFullLaw g e s) =
      ENNReal.ofReal (e : ℝ) •
          (trialOutcomeLaw s).map (fun y => (g e, true, y)) +
        ENNReal.ofReal (1 - (e : ℝ)) •
          Measure.dirac (g e, false, trialZeroOutcome) := by
  letI : IsProbabilityMeasure (trialOutcomeLaw s) :=
    trialOutcomeLaw_isProbabilityMeasure s hs0 hs1
  have hrow := scoreLogAtomRow_measurable g e
  have hread : Measurable (fun ya : OutcomeSpace × ArmSpace =>
      (g e, ya.2, if ya.2 then ya.1 else trialZeroOutcome)) := by
    have hcond : MeasurableSet {ya : OutcomeSpace × ArmSpace | ya.2 = true} :=
      measurableSet_eq_fun measurable_snd measurable_const
    have hobs : Measurable (fun ya : OutcomeSpace × ArmSpace =>
        if ya.2 then ya.1 else trialZeroOutcome) :=
      Measurable.ite hcond measurable_fst measurable_const
    fun_prop (disch := assumption)
  unfold releasedLaw scoreLogAtomFullLaw
  rw [Measure.map_map (by unfold releasedRecord label arm observed; fun_prop) hrow]
  change ((trialOutcomeLaw s).prod (scoreLogArmLaw e)).map _ = _
  unfold scoreLogArmLaw
  rw [Measure.prod_add _, Measure.prod_smul_right, Measure.prod_smul_right]
  change Measure.map (fun ya : OutcomeSpace × ArmSpace =>
      (g e, ya.2, if ya.2 then ya.1 else trialZeroOutcome)) _ = _
  rw [Measure.map_add _ _ hread, Measure.map_smul, Measure.map_smul,
    Measure.prod_dirac, Measure.prod_dirac,
    Measure.map_map hread (by fun_prop), Measure.map_map hread (by fun_prop)]
  congr 1
  rw [show ((fun ya : OutcomeSpace × ArmSpace =>
      (g e, ya.2, if ya.2 then ya.1 else trialZeroOutcome)) ∘
      fun y => (y, false)) =
        (fun _ : OutcomeSpace => (g e, false, trialZeroOutcome)) by
          funext y
          rfl]
  rw [Measure.map_const]
  simp

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,x,y,z,s), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTripleBaselineFullLaw_releasedLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (x y z : ScoreSpace ε)
    (s : ℝ) :
    releasedLaw (scoreLogTripleBaselineFullLaw g x y z s) =
      ENNReal.ofReal (1 / 3 : ℝ) • releasedLaw (scoreLogAtomFullLaw g x s) +
        ENNReal.ofReal (1 / 3 : ℝ) • releasedLaw (scoreLogAtomFullLaw g y s) +
        ENNReal.ofReal (1 / 3 : ℝ) • releasedLaw (scoreLogAtomFullLaw g z s) := by
  unfold releasedLaw scoreLogTripleBaselineFullLaw
  rw [Measure.map_add _ _ (by unfold releasedRecord label arm observed; fun_prop),
    Measure.map_add _ _ (by unfold releasedRecord label arm observed; fun_prop),
    Measure.map_smul, Measure.map_smul, Measure.map_smul]

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,x,y,z,s,u), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTriplePerturbedFullLaw_releasedLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (x y z : ScoreSpace ε)
    (s u : ℝ) :
    releasedLaw (scoreLogTriplePerturbedFullLaw g x y z s u) =
      ENNReal.ofReal (1 / 3 + u * ((z : ℝ) - y)) •
          releasedLaw (scoreLogAtomFullLaw g x s) +
        ENNReal.ofReal (1 / 3 - u * ((z : ℝ) - x)) •
          releasedLaw (scoreLogAtomFullLaw g y s) +
        ENNReal.ofReal (1 / 3 + u * ((y : ℝ) - x)) •
          releasedLaw (scoreLogAtomFullLaw g z s) := by
  unfold releasedLaw scoreLogTriplePerturbedFullLaw
  rw [Measure.map_add _ _ (by unfold releasedRecord label arm observed; fun_prop),
    Measure.map_add _ _ (by unfold releasedRecord label arm observed; fun_prop),
    Measure.map_smul, Measure.map_smul, Measure.map_smul]

private lemma ennreal_three_weighted_eq
    (a b c w₁ w₂ w₃ v₁ v₂ v₃ : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hw₁ : 0 ≤ w₁) (hw₂ : 0 ≤ w₂) (hw₃ : 0 ≤ w₃)
    (hv₁ : 0 ≤ v₁) (hv₂ : 0 ≤ v₂) (hv₃ : 0 ≤ v₃)
    (h : w₁ * a + w₂ * b + w₃ * c =
      v₁ * a + v₂ * b + v₃ * c) :
    ENNReal.ofReal w₁ * ENNReal.ofReal a +
        ENNReal.ofReal w₂ * ENNReal.ofReal b +
        ENNReal.ofReal w₃ * ENNReal.ofReal c =
      ENNReal.ofReal v₁ * ENNReal.ofReal a +
        ENNReal.ofReal v₂ * ENNReal.ofReal b +
        ENNReal.ofReal v₃ * ENNReal.ofReal c := by
  rw [← ENNReal.ofReal_mul hw₁, ← ENNReal.ofReal_mul hw₂,
    ← ENNReal.ofReal_mul hw₃, ← ENNReal.ofReal_mul hv₁,
    ← ENNReal.ofReal_mul hv₂, ← ENNReal.ofReal_mul hv₃]
  rw [← ENNReal.ofReal_add (mul_nonneg hw₁ ha) (mul_nonneg hw₂ hb),
    ← ENNReal.ofReal_add
      (add_nonneg (mul_nonneg hw₁ ha) (mul_nonneg hw₂ hb)) (mul_nonneg hw₃ hc),
    ← ENNReal.ofReal_add (mul_nonneg hv₁ ha) (mul_nonneg hv₂ hb),
    ← ENNReal.ofReal_add
      (add_nonneg (mul_nonneg hv₁ ha) (mul_nonneg hv₂ hb)) (mul_nonneg hv₃ hc)]
  rw [h]

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,r,x,y,z,hxy,hyz,hx,hy,hz,s,hs0,hs1,u,hu0,hu), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTriple_releasedLaw_eq {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (r : LabelSpace J) (x y z : ScoreSpace ε)
    (hxy : x < y) (hyz : y < z)
    (hx : g x = r) (hy : g y = r) (hz : g z = r)
    (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (u : ℝ) (hu0 : 0 ≤ u) (hu : u * ((z : ℝ) - x) ≤ 1 / 3) :
    releasedLaw (scoreLogTripleBaselineFullLaw g x y z s) =
      releasedLaw (scoreLogTriplePerturbedFullLaw g x y z s u) := by
  have ex0 : 0 ≤ (x : ℝ) := le_trans hOverlap.1.le x.property.1
  have ey0 : 0 ≤ (y : ℝ) := le_trans hOverlap.1.le y.property.1
  have ez0 : 0 ≤ (z : ℝ) := le_trans hOverlap.1.le z.property.1
  have ex1 : (x : ℝ) ≤ 1 := by linarith [x.property.2, hOverlap.1]
  have ey1 : (y : ℝ) ≤ 1 := by linarith [y.property.2, hOverlap.1]
  have ez1 : (z : ℝ) ≤ 1 := by linarith [z.property.2, hOverlap.1]
  have hw := scoreLogTriple_weights_nonneg x y z hxy hyz u hu0 hu
  have hid := scoreLogTriple_weight_identities x y z hxy hyz u
  let w₁ : ℝ := 1 / 3 + u * ((z : ℝ) - y)
  let w₂ : ℝ := 1 / 3 - u * ((z : ℝ) - x)
  let w₃ : ℝ := 1 / 3 + u * ((y : ℝ) - x)
  have hw' : 0 ≤ w₁ ∧ 0 ≤ w₂ ∧ 0 ≤ w₃ := by simpa [w₁, w₂, w₃] using hw
  have htReal : (1 / 3) * (x : ℝ) + (1 / 3) * (y : ℝ) +
      (1 / 3) * (z : ℝ) = w₁ * (x : ℝ) + w₂ * (y : ℝ) + w₃ * (z : ℝ) := by
    dsimp [w₁, w₂, w₃]
    nlinarith [hid.2]
  have hcReal : (1 / 3) * (1 - (x : ℝ)) + (1 / 3) * (1 - (y : ℝ)) +
      (1 / 3) * (1 - (z : ℝ)) =
        w₁ * (1 - (x : ℝ)) + w₂ * (1 - (y : ℝ)) + w₃ * (1 - (z : ℝ)) := by
    dsimp [w₁, w₂, w₃]
    nlinarith [hid.1, hid.2]
  have ht := ennreal_three_weighted_eq
    (x : ℝ) y z (1 / 3) (1 / 3) (1 / 3) w₁ w₂ w₃
    ex0 ey0 ez0 (by norm_num) (by norm_num) (by norm_num)
    hw'.1 hw'.2.1 hw'.2.2 htReal
  have hc := ennreal_three_weighted_eq
    (1 - (x : ℝ)) (1 - (y : ℝ)) (1 - (z : ℝ))
    (1 / 3) (1 / 3) (1 / 3) w₁ w₂ w₃
    (sub_nonneg.mpr ex1) (sub_nonneg.mpr ey1) (sub_nonneg.mpr ez1)
    (by norm_num) (by norm_num) (by norm_num) hw'.1 hw'.2.1 hw'.2.2 hcReal
  let T : Measure (Observation J) :=
    (trialOutcomeLaw s).map (fun y => (r, true, y))
  let F : Measure (Observation J) := Measure.dirac (r, false, trialZeroOutcome)
  have hb : releasedLaw (scoreLogTripleBaselineFullLaw g x y z s) =
      (ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (x : ℝ) +
          ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (y : ℝ) +
          ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (z : ℝ)) • T +
        (ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (1 - (x : ℝ)) +
          ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (1 - (y : ℝ)) +
          ENNReal.ofReal (1 / 3 : ℝ) * ENNReal.ofReal (1 - (z : ℝ))) • F := by
    rw [scoreLogTripleBaselineFullLaw_releasedLaw,
      scoreLogAtomFullLaw_releasedLaw g x s hs0 hs1,
      scoreLogAtomFullLaw_releasedLaw g y s hs0 hs1,
      scoreLogAtomFullLaw_releasedLaw g z s hs0 hs1, hx, hy, hz]
    dsimp [T, F]
    module
  have hp : releasedLaw (scoreLogTriplePerturbedFullLaw g x y z s u) =
      (ENNReal.ofReal w₁ * ENNReal.ofReal (x : ℝ) +
          ENNReal.ofReal w₂ * ENNReal.ofReal (y : ℝ) +
          ENNReal.ofReal w₃ * ENNReal.ofReal (z : ℝ)) • T +
        (ENNReal.ofReal w₁ * ENNReal.ofReal (1 - (x : ℝ)) +
          ENNReal.ofReal w₂ * ENNReal.ofReal (1 - (y : ℝ)) +
          ENNReal.ofReal w₃ * ENNReal.ofReal (1 - (z : ℝ))) • F := by
    rw [scoreLogTriplePerturbedFullLaw_releasedLaw,
      scoreLogAtomFullLaw_releasedLaw g x s hs0 hs1,
      scoreLogAtomFullLaw_releasedLaw g y s hs0 hs1,
      scoreLogAtomFullLaw_releasedLaw g z s hs0 hs1, hx, hy, hz]
    dsimp [w₁, w₂, w₃, T, F]
    module
  rw [hb, hp, ht, hc]

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,hg,r,x,y,z,hxy,hyz,hx,hy,hz,s,hs0,hs1,u,hu0,hu), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTriple_externalPair {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (hg : Measurable g) (r : LabelSpace J) (x y z : ScoreSpace ε)
    (hxy : x < y) (hyz : y < z)
    (hx : g x = r) (hy : g y = r) (hz : g z = r)
    (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (u : ℝ) (hu0 : 0 ≤ u) (hu : u * ((z : ℝ) - x) ≤ 1 / 3) :
    let P₀ := scoreLogTripleBaselineFullLaw g x y z s
    let H₀ := scoreLogTripleBaseline x y z
    let P₁ := scoreLogTriplePerturbedFullLaw g x y z s u
    let H₁ := scoreLogTriplePerturbed x y z u
    (P₀, H₀) ∈ ExternalLaws g ∧ (P₁, H₁) ∈ ExternalLaws g ∧
      releasedLaw P₀ = releasedLaw P₁ := by
  dsimp
  refine ⟨?_, ?_, scoreLogTriple_releasedLaw_eq g hOverlap r x y z hxy hyz
    hx hy hz s hs0 hs1 u hu0 hu⟩
  · exact ⟨scoreLogTripleBaselineFullLaw_isProbabilityMeasure
      g hOverlap x y z s hs0 hs1,
      scoreLogTripleBaseline_isProbabilityMeasure x y z,
      scoreLogTripleBaseline_externalScoreLaw g hOverlap hg x y z s hs0 hs1⟩
  · exact ⟨scoreLogTriplePerturbedFullLaw_isProbabilityMeasure
      g hOverlap x y z hxy hyz s hs0 hs1 u hu0 hu,
      scoreLogTriplePerturbed_isProbabilityMeasure x y z hxy hyz u hu0 hu,
      scoreLogTriplePerturbed_externalScoreLaw g hOverlap hg x y z hxy hyz
        s hs0 hs1 u hu0 hu⟩

end
