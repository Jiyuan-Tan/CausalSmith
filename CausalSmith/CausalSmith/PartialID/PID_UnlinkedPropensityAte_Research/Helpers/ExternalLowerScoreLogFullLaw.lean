/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hg,x,y,z,s), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTripleBaselineFullLaw_deterministicRelease {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hg : Measurable g)
    (x y z : ScoreSpace ε) (s : ℝ) :
    DeterministicRelease g (scoreLogTripleBaselineFullLaw g x y z s) := by
  unfold DeterministicRelease scoreLogTripleBaselineFullLaw
  rw [ae_add_measure_iff, ae_add_measure_iff]
