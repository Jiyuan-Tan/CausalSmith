public import CausalSmith.PartialID.PID_UnlinkedPropensityAte_Research.Helpers.ExternalLowerTrialPair

/-! Full causal laws generated by a score atom for the score-log lower pair. -/

@[expose] public section

open MeasureTheory Set
open scoped ENNReal
namespace CausalSmith.PartialID.UnlinkedPropensityAte

noncomputable section

/-- For [the specified mathematical inputs](hyp:ε,e), [this definition](goal) introduces the corresponding object. -/
def scoreLogArmLaw {ε : ℝ} (e : ScoreSpace ε) : Measure ArmSpace :=
  ENNReal.ofReal (e : ℝ) • Measure.dirac true +
    ENNReal.ofReal (1 - (e : ℝ)) • Measure.dirac false

/-- For [the specified mathematical inputs](hyp:ε,J,g,e,y,a), [this definition](goal) introduces the corresponding object. -/
def scoreLogAtomRow {ε : ℝ} {J : ℕ} (g : ScoreSpace ε → LabelSpace J)
    (e : ScoreSpace ε) (y : OutcomeSpace) (a : ArmSpace) : FullRow ε J :=
  (e, trialZeroOutcome, y, a, if a then y else trialZeroOutcome, g e)
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,e), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomRow_measurable {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (e : ScoreSpace ε) :
    Measurable (fun ya : OutcomeSpace × ArmSpace =>
      scoreLogAtomRow g e ya.1 ya.2) := by
  have hcond : MeasurableSet {ya : OutcomeSpace × ArmSpace | ya.2 = true} :=
    measurableSet_eq_fun measurable_snd measurable_const
  have hobs : Measurable (fun ya : OutcomeSpace × ArmSpace =>
      if ya.2 then ya.1 else trialZeroOutcome) :=
    Measurable.ite hcond measurable_fst measurable_const
  unfold scoreLogAtomRow
  fun_prop (disch := assumption)

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,e,hOverlap), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogArmLaw_isProbabilityMeasure {ε : ℝ}
    (e : ScoreSpace ε) (hOverlap : Overlap ε) :
    IsProbabilityMeasure (scoreLogArmLaw e) := by
  have he0 : 0 ≤ (e : ℝ) := le_trans hOverlap.1.le e.property.1
  have he1 : (e : ℝ) ≤ 1 := by linarith [e.property.2, hOverlap.1]
  rw [isProbabilityMeasure_iff]
  unfold scoreLogArmLaw
  rw [Measure.add_apply, Measure.smul_apply, Measure.smul_apply]
  simp only [Measure.dirac_apply, Set.mem_univ, Set.indicator_of_mem,
    Pi.one_apply, smul_eq_mul, mul_one]
  rw [← ENNReal.ofReal_add he0 (sub_nonneg.mpr he1)]
  norm_num
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,e,hOverlap), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogArmLaw_true_mass {ε : ℝ}
    (e : ScoreSpace ε) (hOverlap : Overlap ε) :
    (scoreLogArmLaw e).real {true} = (e : ℝ) := by
  have he0 : 0 ≤ (e : ℝ) := le_trans hOverlap.1.le e.property.1
  unfold scoreLogArmLaw
  rw [Measure.real_def, Measure.add_apply, Measure.smul_apply, Measure.smul_apply]
  simp [he0]

/-- For [the specified mathematical inputs](hyp:ε,J,g,e,s), [this definition](goal) introduces the corresponding object. -/
def scoreLogAtomFullLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (e : ScoreSpace ε) (s : ℝ) :
    Measure (FullRow ε J) :=
  ((trialOutcomeLaw s).prod (scoreLogArmLaw e)).map
    (fun ya => scoreLogAtomRow g e ya.1 ya.2)
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,e,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_isProbabilityMeasure {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (e : ScoreSpace ε) (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    IsProbabilityMeasure (scoreLogAtomFullLaw g e s) := by
  letI : IsProbabilityMeasure (trialOutcomeLaw s) :=
    trialOutcomeLaw_isProbabilityMeasure s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogArmLaw e) :=
    scoreLogArmLaw_isProbabilityMeasure e hOverlap
  unfold scoreLogAtomFullLaw
  exact Measure.isProbabilityMeasure_map
    (scoreLogAtomRow_measurable g e).aemeasurable
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,e,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_scoreMarginal {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (e : ScoreSpace ε) (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    ScoreMarginal (scoreLogAtomFullLaw g e s) (Measure.dirac e) := by
  letI : IsProbabilityMeasure (trialOutcomeLaw s) :=
    trialOutcomeLaw_isProbabilityMeasure s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogArmLaw e) :=
    scoreLogArmLaw_isProbabilityMeasure e hOverlap
  have hrow := scoreLogAtomRow_measurable g e
  unfold ScoreMarginal scoreLogAtomFullLaw
  rw [Measure.map_map (by unfold score; fun_prop) hrow]
  change ((trialOutcomeLaw s).prod (scoreLogArmLaw e)).map (fun _ => e) = _
  rw [Measure.map_const]
  simp
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,e,s), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_consistency {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (e : ScoreSpace ε) (s : ℝ) :
    Consistency (scoreLogAtomFullLaw g e s) := by
  have hrow := scoreLogAtomRow_measurable g e
  have hcond : MeasurableSet {ω : FullRow ε J | arm ω = true} :=
    measurableSet_eq_fun (by unfold arm; fun_prop) measurable_const
  have hpot : Measurable (fun ω : FullRow ε J =>
      if arm ω then outcome1 ω else outcome0 ω) :=
    Measurable.ite hcond (by unfold outcome1; fun_prop)
      (by unfold outcome0; fun_prop)
  have hset : MeasurableSet {ω : FullRow ε J |
      observed ω = if arm ω then outcome1 ω else outcome0 ω} :=
    measurableSet_eq_fun (by unfold observed; fun_prop) hpot
  unfold Consistency scoreLogAtomFullLaw
  rw [ae_map_iff hrow.aemeasurable hset]
  filter_upwards [] with ya
  rfl
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,e,s,hg), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_deterministicRelease {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (e : ScoreSpace ε) (s : ℝ)
    (hg : Measurable g) :
    DeterministicRelease g (scoreLogAtomFullLaw g e s) := by
  have hrow := scoreLogAtomRow_measurable g e
  have hset : MeasurableSet {ω : FullRow ε J | label ω = g (score ω)} :=
    measurableSet_eq_fun (by unfold label; fun_prop)
      (hg.comp (by unfold score; fun_prop))
  unfold DeterministicRelease scoreLogAtomFullLaw
  rw [ae_map_iff hrow.aemeasurable hset]
  filter_upwards [] with ya
  rfl

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,e,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogAtomFullLaw_randomizedAssignment {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (e : ScoreSpace ε) (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    RandomizedAssignment (scoreLogAtomFullLaw g e s) := by
  intro B hB
  let μ : Measure OutcomeSpace := trialOutcomeLaw s
  let ν : Measure ArmSpace := scoreLogArmLaw e
  let f : OutcomeSpace × ArmSpace → FullRow ε J :=
    fun ya => scoreLogAtomRow g e ya.1 ya.2
  have hf : Measurable f := scoreLogAtomRow_measurable g e
  let U : Set OutcomeSpace := {y | (e, trialZeroOutcome, y) ∈ B}
  have hU : MeasurableSet U := by
    exact hB.preimage (by fun_prop : Measurable
      (fun y : OutcomeSpace => (e, trialZeroOutcome, y)))
  let S : Set (FullRow ε J) :=
    {ω | arm ω = true ∧ latentTriple ω ∈ B}
  let T : Set (FullRow ε J) := {ω | latentTriple ω ∈ B}
  have hlatent : Measurable (latentTriple (ε := ε) (J := J)) := by
    unfold latentTriple score outcome0 outcome1
    fun_prop
  have hS : MeasurableSet S :=
    (measurableSet_eq_fun (by unfold arm; fun_prop) measurable_const).inter
      (hB.preimage hlatent)
  have hT : MeasurableSet T := hB.preimage hlatent
  have hpreS : f ⁻¹' S = U ×ˢ {true} := by
    ext ya
    cases ha : ya.2 <;> simp [f, S, U, scoreLogAtomRow, arm,
      latentTriple, score, outcome0, outcome1, ha]
  have hpreT : f ⁻¹' T = U ×ˢ Set.univ := by
    ext ya
    simp [f, T, U, scoreLogAtomRow, latentTriple, score, outcome0, outcome1]
  have hνprob : IsProbabilityMeasure ν :=
    scoreLogArmLaw_isProbabilityMeasure e hOverlap
  have hνuniv : ν.real Set.univ = 1 := isProbabilityMeasure_iff_real.mp hνprob
  change (scoreLogAtomFullLaw g e s).real S =
    ∫ ω in T, (score ω : ℝ) ∂scoreLogAtomFullLaw g e s
  have hleft : (scoreLogAtomFullLaw g e s).real S = μ.real U * (e : ℝ) := by
    unfold scoreLogAtomFullLaw
    rw [MeasureTheory.map_measureReal_apply hf hS, hpreS,
      measureReal_prod_prod]
    rw [show ν.real {true} = (e : ℝ) from scoreLogArmLaw_true_mass e hOverlap]
  have hright : (∫ ω in T, (score ω : ℝ)
        ∂scoreLogAtomFullLaw g e s) = μ.real U * (e : ℝ) := by
    unfold scoreLogAtomFullLaw
    rw [MeasureTheory.setIntegral_map hT (by unfold score; fun_prop)
      hf.aemeasurable]
    rw [hpreT]
    change ∫ _ in U ×ˢ Set.univ, (e : ℝ) ∂(μ.prod ν) = _
    rw [setIntegral_const, measureReal_prod_prod, hνuniv]
    simp only [smul_eq_mul, mul_one]
  exact hleft.trans hright.symm

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,P,hP,c,hc), this result [establishes the stated mathematical conclusion](goal). -/
lemma randomizedAssignment_smul_of_ne_top {ε : ℝ} {J : ℕ}
    (P : Measure (FullRow ε J)) (hP : RandomizedAssignment P)
    (c : ENNReal) (hc : c ≠ ∞) : RandomizedAssignment (c • P) := by
  intro B hB
  have hS : MeasurableSet {ω : FullRow ε J |
      arm ω = true ∧ (score ω, outcome0 ω, outcome1 ω) ∈ B} := by
    exact (measurableSet_eq_fun (by unfold arm; fun_prop) measurable_const).inter
      (hB.preimage (by unfold score outcome0 outcome1; fun_prop))
  rw [Measure.real_def]
  change ((c • P) {ω | arm ω = true ∧
      (score ω, outcome0 ω, outcome1 ω) ∈ B}).toReal =
    ∫ ω, (score ω : ℝ) ∂(c • P).restrict
      {ω | (score ω, outcome0 ω, outcome1 ω) ∈ B}
  rw [Measure.smul_apply, Measure.restrict_smul, integral_smul_measure]
  simp only [smul_eq_mul, ENNReal.toReal_mul]
  have hr := hP B hB
  rw [Measure.real_def] at hr
  rw [hr]

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,P), this result [establishes the stated mathematical conclusion](goal). -/
lemma score_integrable_finite {ε : ℝ} {J : ℕ}
    (P : Measure (FullRow ε J)) [IsFiniteMeasure P] :
    Integrable (fun ω => (score ω : ℝ)) P := by
  apply Integrable.of_bound (by unfold score; fun_prop) (|ε| + |1 - ε| + 1)
  filter_upwards [] with ω
  change |((score ω : ScoreSpace ε) : ℝ)| ≤ |ε| + |1 - ε| + 1
  rcases (score ω).property with ⟨he₁, he₂⟩
  have h₁ := neg_le_abs ε
  have h₂ := le_abs_self (1 - ε)
  have h₃ := neg_le_abs (1 - ε)
  have h₄ := le_abs_self ε
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,P,Q,hP,hQ), this result [establishes the stated mathematical conclusion](goal). -/
lemma randomizedAssignment_add {ε : ℝ} {J : ℕ}
    (P Q : Measure (FullRow ε J)) [IsFiniteMeasure P] [IsFiniteMeasure Q]
    (hP : RandomizedAssignment P) (hQ : RandomizedAssignment Q) :
    RandomizedAssignment (P + Q) := by
  intro B hB
  let T : Set (FullRow ε J) :=
    {ω | (score ω, outcome0 ω, outcome1 ω) ∈ B}
  have hT : MeasurableSet T :=
    hB.preimage (by unfold score outcome0 outcome1; fun_prop)
  have hS : MeasurableSet {ω : FullRow ε J |
      arm ω = true ∧ (score ω, outcome0 ω, outcome1 ω) ∈ B} := by
    exact (measurableSet_eq_fun (by unfold arm; fun_prop) measurable_const).inter hT
  change (P + Q).real _ = ∫ ω in T, (score ω : ℝ) ∂(P + Q)
  rw [Measure.real_def, Measure.add_apply _ _ _,
    ENNReal.toReal_add (measure_ne_top P _) (measure_ne_top Q _)]
  rw [Measure.restrict_add,
    integral_add_measure (score_integrable_finite P).integrableOn
      (score_integrable_finite Q).integrableOn]
  change P.real _ + Q.real _ = _
  rw [hP B hB, hQ B hB]

/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,x,y,z,s,hs0,hs1,w₁,w₂,w₃), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTripleFullLaw_randomizedAssignment {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (x y z : ScoreSpace ε) (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (w₁ w₂ w₃ : ℝ) :
    RandomizedAssignment
      (ENNReal.ofReal w₁ • scoreLogAtomFullLaw g x s +
        ENNReal.ofReal w₂ • scoreLogAtomFullLaw g y s +
        ENNReal.ofReal w₃ • scoreLogAtomFullLaw g z s) := by
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g x s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap x s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g y s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap y s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g z s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap z s hs0 hs1
  have hx := randomizedAssignment_smul_of_ne_top _
    (scoreLogAtomFullLaw_randomizedAssignment g hOverlap x s hs0 hs1)
    (ENNReal.ofReal w₁) (by simp)
  have hy := randomizedAssignment_smul_of_ne_top _
    (scoreLogAtomFullLaw_randomizedAssignment g hOverlap y s hs0 hs1)
    (ENNReal.ofReal w₂) (by simp)
  have hz := randomizedAssignment_smul_of_ne_top _
    (scoreLogAtomFullLaw_randomizedAssignment g hOverlap z s hs0 hs1)
    (ENNReal.ofReal w₃) (by simp)
  letI : IsFiniteMeasure
      (ENNReal.ofReal w₁ • scoreLogAtomFullLaw g x s) := ⟨by simp⟩
  letI : IsFiniteMeasure
      (ENNReal.ofReal w₂ • scoreLogAtomFullLaw g y s) := ⟨by simp⟩
  letI : IsFiniteMeasure
      (ENNReal.ofReal w₃ • scoreLogAtomFullLaw g z s) := ⟨by simp⟩
  exact randomizedAssignment_add _ _ (randomizedAssignment_add _ _ hx hy) hz

/-- For [the specified mathematical inputs](hyp:ε,J,g,x,y,z,s), [this definition](goal) introduces the corresponding object. -/
def scoreLogTripleBaselineFullLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (x y z : ScoreSpace ε) (s : ℝ) :
    Measure (FullRow ε J) :=
  ENNReal.ofReal (1 / 3 : ℝ) • scoreLogAtomFullLaw g x s +
    ENNReal.ofReal (1 / 3 : ℝ) • scoreLogAtomFullLaw g y s +
    ENNReal.ofReal (1 / 3 : ℝ) • scoreLogAtomFullLaw g z s

/-- For [the specified mathematical inputs](hyp:ε,J,g,x,y,z,s,u), [this definition](goal) introduces the corresponding object. -/
def scoreLogTriplePerturbedFullLaw {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (x y z : ScoreSpace ε)
    (s u : ℝ) : Measure (FullRow ε J) :=
  ENNReal.ofReal (1 / 3 + u * ((z : ℝ) - y)) •
      scoreLogAtomFullLaw g x s +
    ENNReal.ofReal (1 / 3 - u * ((z : ℝ) - x)) •
      scoreLogAtomFullLaw g y s +
    ENNReal.ofReal (1 / 3 + u * ((y : ℝ) - x)) •
      scoreLogAtomFullLaw g z s
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,x,y,z,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTripleBaselineFullLaw_isProbabilityMeasure {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (x y z : ScoreSpace ε) (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    IsProbabilityMeasure (scoreLogTripleBaselineFullLaw g x y z s) := by
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g x s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap x s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g y s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap y s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g z s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap z s hs0 hs1
  rw [isProbabilityMeasure_iff]
  unfold scoreLogTripleBaselineFullLaw
  rw [Measure.add_apply, Measure.add_apply]
  simp only [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
  rw [← ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 1 / 3) (by norm_num),
    ← ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 1 / 3 + 1 / 3) (by norm_num)]
  norm_num
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,x,y,z,hxy,hyz,s,hs0,hs1,u,hu0,hu), this result [establishes the stated mathematical conclusion](goal). -/
lemma scoreLogTriplePerturbedFullLaw_isProbabilityMeasure {ε : ℝ} {J : ℕ}
    (g : ScoreSpace ε → LabelSpace J) (hOverlap : Overlap ε)
    (x y z : ScoreSpace ε) (hxy : x < y) (hyz : y < z)
    (s : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (u : ℝ) (hu0 : 0 ≤ u) (hu : u * ((z : ℝ) - x) ≤ 1 / 3) :
    IsProbabilityMeasure (scoreLogTriplePerturbedFullLaw g x y z s u) := by
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g x s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap x s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g y s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap y s hs0 hs1
  letI : IsProbabilityMeasure (scoreLogAtomFullLaw g z s) :=
    scoreLogAtomFullLaw_isProbabilityMeasure g hOverlap z s hs0 hs1
  have hw := scoreLogTriple_weights_nonneg x y z hxy hyz u hu0 hu
  have hsum := (scoreLogTriple_weight_identities x y z hxy hyz u).1
  rw [isProbabilityMeasure_iff]
  unfold scoreLogTriplePerturbedFullLaw
  rw [Measure.add_apply, Measure.add_apply]
  simp only [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
  rw [← ENNReal.ofReal_add hw.1 hw.2.1,
    ← ENNReal.ofReal_add (add_nonneg hw.1 hw.2.1) hw.2.2, hsum]
  norm_num
/-- Given [the stated mathematical inputs and assumptions](hyp:ε,J,g,hOverlap,x,y,z,s,hs0,hs1), this result [establishes the stated mathematical conclusion](goal). -/
