---
import { loadBundles, type Bundle } from "../lib/bundles.js";
import { bundleRoots, GITHUB_URL, PAPER_CITE, PAPER_URL, SERIES_NAME, SERIES_TAGLINE } from "../lib/config.js";
import PaperEntry from "../components/PaperEntry.astro";
import SeoHead from "../components/SeoHead.astro";
import "katex/dist/katex.min.css";
import "../styles/series.css";
import "../styles/runs.css";

const bundles = await loadBundles(bundleRoots());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Flagship: the top-scored paper gets a featured panel above the sortable list —
// one focal point that answers "where do I start?". Only when there's a score to
// justify the pick and more than one paper to feature over.
const flagship: Bundle | null =
  bundles.length >= 2 && typeof bundles[0].score === "number" ? bundles[0] : null;
const listed = flagship ? bundles.slice(1) : bundles;
---

<html lang="en">
  <head>
    <SeoHead
      title={`${SERIES_NAME} · ${SERIES_TAGLINE}`}
      description={`Working papers from ${SERIES_NAME}, an AI causal scientist: econometric theory in which every theorem, assumption, and lemma is machine-verified in Lean 4.`}
    />
  </head>
  <body>
    <div class="series-wrap">
      <header class="masthead">
        <div class="series-kicker">{SERIES_NAME} · {SERIES_TAGLINE}</div>
        <nav class="masthead-nav">
          <span class="masthead-nav-current">CausalSmith Working Papers</span>
          <a href={`${base}/library/`}>Causalean Library</a>
          <a href={`${base}/how-it-works/`}>How it works</a>
          <a class="nav-external" href={PAPER_URL} title={PAPER_CITE} target="_blank" rel="noopener">
            arXiv <span aria-hidden="true">↗</span>
          </a>
          {GITHUB_URL && (
            <a class="nav-external" href={GITHUB_URL} target="_blank" rel="noopener">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          )}
        </nav>
        <h1>CausalSmith Working Papers</h1>
        <p class="lede">
          Working papers from <strong>{SERIES_NAME}</strong> — econometric theory in which
          every formal statement, every theorem, assumption, and lemma, is machine-verified
          in Lean 4. Click any statement in a
          paper to see the exact Lean code it stands for. The papers build on the
          <a href={`${base}/library/`}>Causalean library</a>, which you can browse with
          natural-language translations and review status.
        </p>
        <p class="lede">
          The main mathematics and Lean formalization are produced by OpenAI's GPT-5.6 Sol,
          with Anthropic's Claude Opus 4.8 handling planning and Lean code review; the
          paper write-ups themselves are drafted by OpenAI's GPT-5.5.
        </p>
        <p class="lede">
          Most questions the system takes on do not end as a paper. Those are kept as
          <a href={`${base}/shelved/`}>shelved runs</a>, with how far each got and why it stopped.
        </p>
      </header>

      {bundles.length === 0 && <p class="empty-series">No papers published yet.</p>}

      {flagship && <PaperEntry bundle={flagship} flagship />}

      {listed.length > 1 && (
        <div class="wp-controls" role="group" aria-label="Sort papers">
          <span class="wp-controls-label">Sort:</span>
          <button type="button" class="wp-sort-btn is-active" data-sort="score">AI score</button>
          <button type="button" class="wp-sort-btn" data-sort="readers" title="Average reader star rating, best first">Reader rating</button>
          <button type="button" class="wp-sort-btn" data-sort="cluster">Cluster</button>
          <button type="button" class="wp-sort-btn" data-sort="date" title="First published, newest first">Date</button>
        </div>
      )}
      {listed.length > 0 && (
        <p class="wp-score-note">
          The <strong>AI score</strong> (0–10) is a single automated referee's estimate,
          produced by the pipeline's review stage — it can be inaccurate and is intended only as a
          rough reference, not a peer-review verdict. Click a score to read the referee's
          reasoning and its main criticisms. The <strong>reader rating</strong> (1–5 ★) is
          the average of star ratings left by signed-in readers, on each paper and on individual
          statements within it.
        </p>
      )}

      <div id="wp-list">
      {listed.map((b) => <PaperEntry bundle={b} />)}
      </div>
      <nav class="run-pager" id="wp-pager" aria-label="Pages" hidden></nav>

      <footer class="site-footer">
        Statements are rendered from the verified Lean artifact at a pinned commit; the
        formal layer of each paper is hash-checked against it at build time.
      </footer>
    </div>

    <script>
      import { paperAverages } from "../scripts/ratings/api.js";
      import { initDisclosures } from "../scripts/disclosures.js";

      // Cite panels and AI-score folds. Delegated on the document, so the
      // sort below — which MOVES entry nodes with appendChild — cannot
      // detach them (see scripts/disclosures.ts).
      initDisclosures();

      // Client-side reorder and paging of the working-paper list. Server renders it
      // score-desc (best first); "Cluster" regroups by area with a heading per cluster,
      // score-desc within each. appendChild MOVES the existing nodes, so <details>
      // open-state and any listeners survive the reorder.
      const list = document.getElementById("wp-list");
      if (list) {
        const entries = Array.from(list.querySelectorAll(".wp-entry"));
        const btns = Array.from(document.querySelectorAll(".wp-sort-btn"));
        const score = (el) => Number(el.getAttribute("data-score"));
        // Average reader stars, hydrated below; unrated papers sort last.
        const human = (el) => Number(el.getAttribute("data-human") ?? -1);
        const area = (el) => el.getAttribute("data-area") || "";
        const created = (el) => el.getAttribute("data-created") || "";
        // The list is paged: a sort orders ALL the papers, then one page of them is
        // shown. Off-page entries stay in the document (hidden), so their open
        // panels, listeners and rating badges survive both paging and re-sorting.
        const PAGE = 20;
        const pager = document.getElementById("wp-pager");
        // The page number lives in the address (#p3), so back and shared links keep the place.
        const pageFromHash = () => Math.max(1, Number(/^#p(\d+)$/.exec(location.hash)?.[1] ?? 1));
        let page = pageFromHash();
        let order = entries.slice();
        let grouped = false;
        const render = () => {
          list.querySelectorAll(".cluster-head").forEach((h) => h.remove());
          const pages = Math.max(1, Math.ceil(order.length / PAGE));
          page = Math.min(page, pages);
          let cur = null;
          order.forEach((e, i) => {
            const shown = i >= (page - 1) * PAGE && i < page * PAGE;
            e.hidden = !shown;
            // "Cluster" puts a heading before each area's first paper on the page.
            if (grouped && shown && area(e) !== cur) {
              cur = area(e);
              const h = document.createElement("h3");
              h.className = "cluster-head";
              h.textContent = cur;
              list.appendChild(h);
            }
            list.appendChild(e);
          });
          if (!pager) return;
          pager.hidden = pages <= 1;
          // First, last, and a window around the current page; gaps shown as an ellipsis.
          const nums = [...new Set([1, 2, page - 1, page, page + 1, pages - 1, pages])]
            .filter((n) => n >= 1 && n <= pages)
            .sort((a, b) => a - b);
          const link = (n, label, off, isCur = false) =>
            off
              ? `<span class="off">${label}</span>`
              : isCur
                ? `<span class="cur" aria-current="page">${label}</span>`
                : `<a href="#p${n}">${label}</a>`;
          pager.innerHTML =
            link(page - 1, "‹ Previous", page === 1) +
            nums
              .map((n, i) => (i > 0 && n - nums[i - 1] > 1 ? `<span class="gap">…</span>` : "") + link(n, String(n), false, n === page))
              .join("") +
            link(page + 1, "Next ›", page === pages);
        };
        const sorters = {
          score: (a, b) => score(b) - score(a),
          // Reader rating, best first; ties (and the unrated tail) fall back to AI score.
          readers: (a, b) => human(b) - human(a) || score(b) - score(a),
          // Timeline: first-published (meta.created, an ISO date so string order is
          // date order), newest first; same-day papers fall back to score.
          date: (a, b) => created(b).localeCompare(created(a)) || score(b) - score(a),
          cluster: (a, b) => area(a).localeCompare(area(b)) || score(b) - score(a),
        };
        const sortBy = (mode) => {
          grouped = mode === "cluster";
          order = entries.slice().sort(sorters[mode] ?? sorters.score);
          render();
        };
        for (const btn of btns) {
          btn.addEventListener("click", () => {
            btns.forEach((b) => b.classList.toggle("is-active", b === btn));
            // A new order starts again at page 1.
            page = 1;
            history.replaceState(null, "", location.pathname + location.search);
            sortBy(btn.getAttribute("data-sort"));
          });
        }
        window.addEventListener("hashchange", () => {
          page = pageFromHash();
          render();
          list.scrollIntoView({ block: "start" });
        });
        render();
      }

      // Reader-rating badges, filled from the worker after render. Static pages
      // cannot know live averages, so every badge starts hidden and the page is
      // exactly what it was before ratings existed when the fetch fails or no
      // worker is configured.
      {
        const worker = (import.meta.env.PUBLIC_COMMENTS_WORKER ?? "").trim().replace(/\/+$/, "");
        const badges = Array.from(document.querySelectorAll("[data-rating-for]"));
        if (worker && badges.length > 0) {
          const ids = badges
            .map((b) => b.getAttribute("data-rating-for"))
            .filter((id) => typeof id === "string" && id.length > 0);
          paperAverages(worker, [...new Set(ids)])
            .then((avgs) => {
              // The worker answered, so every badge shows SOMETHING: an average,
              // or an explicit muted "not yet rated" (the storefront convention —
              // an empty star, never a fake 0/5, which would read as the worst
              // possible score rather than the absence of one).
              for (const badge of badges) {
                const stat = avgs[badge.getAttribute("data-rating-for") ?? ""];
                if (stat) {
                  badge.textContent = `★ ${stat.avg}/5 · ${stat.count} reader${stat.count === 1 ? "" : "s"}`;
                  const entry = badge.closest(".wp-entry");
                  if (entry) entry.setAttribute("data-human", String(stat.avg));
                } else {
                  badge.textContent = "☆ not yet rated";
                  badge.classList.add("rating-badge-empty");
                }
                badge.hidden = false;
              }
            })
            .catch(() => {
              /* badges simply stay hidden */
            });
        }
      }
    </script>
  </body>
</html>
