---
/**
 * The shared <head> block: charset, viewport, title, description, canonical URL,
 * and Open Graph / Twitter card tags. Every page routes its head through here so
 * the set stays uniform — a page with no description is invisible in search
 * result snippets, and a missing canonical lets the base-path and trailing-slash
 * variants of a URL compete with each other.
 *
 * The canonical is derived from `site` + the page's own path, so it is only
 * emitted when `SITE_URL` is set (i.e. in the deploy workflow, not local dev).
 */
import { SERIES_NAME } from "../lib/config.js";

/**
 * Highwire Press tags for a working paper. Google Scholar indexes a page as a
 * paper only when it finds these — without them a CausalSmith working paper is
 * an ordinary web page to Scholar and never becomes a citable record. Only the
 * paper page passes this; every other page's head is unchanged.
 */
export interface CitationTags {
  title: string;
  /** Corporate author ("CausalSmith"), one entry per `citation_author` tag. */
  authors: string[];
  /** ISO date of the CURRENT version — what a citer should record. */
  publicationDate: string;
  /** ISO date the paper first went online (v1). */
  onlineDate?: string | null;
  institution: string;
  /** `CSWP-2026-008`; omitted before a number is assigned. */
  number?: string | null;
  /** Absolute URL of the PDF; omitted when the bundle ships no PDF. */
  pdfUrl?: string | null;
  doi?: string | null;
}

interface Props {
  title: string;
  description: string;
  /** "article" for papers; "website" for the hub and library pages. */
  ogType?: string;
  /** Present only on paper pages — see `CitationTags`. */
  citation?: CitationTags | null;
}

const { title, description, ogType = "website", citation = null } = Astro.props;

/** Highwire wants `YYYY/MM/DD`; a non-ISO value is dropped rather than guessed. */
function scholarDate(iso: string | null | undefined): string | null {
  const m = iso ? /^(\d{4})-(\d{2})-(\d{2})/.exec(iso) : null;
  return m ? `${m[1]}/${m[2]}/${m[3]}` : null;
}

/** TeX control words worth keeping as a glyph; anything else keeps its name. */
const TEX_GLYPH: Record<string, string> = {
  alpha: "α", beta: "β", gamma: "γ", delta: "δ", epsilon: "ε", varepsilon: "ε",
  zeta: "ζ", eta: "η", theta: "θ", kappa: "κ", lambda: "λ", mu: "μ", nu: "ν",
  xi: "ξ", rho: "ρ", sigma: "σ", tau: "τ", phi: "φ", varphi: "φ", chi: "χ",
  psi: "ψ", omega: "ω", Gamma: "Γ", Delta: "Δ", Theta: "Θ", Lambda: "Λ",
  Sigma: "Σ", Phi: "Φ", Psi: "Ψ", Omega: "Ω",
  pm: "±", mp: "∓", times: "×", cdot: "·", leq: "≤", le: "≤", geq: "≥",
  ge: "≥", neq: "≠", ll: "≪", gg: "≫", to: "→", infty: "∞", sqrt: "√",
  quad: " ", qquad: " ",
};

/**
 * Paper titles and module intros carry TeX and markdown, which would render as
 * raw source inside a meta tag. Drop the delimiters and keep the words.
 */
function plain(text: string): string {
  return text
    .replace(/\\\(|\\\)|\\\[|\\\]/g, "")
    .replace(/\\(?:text|mathrm|mathbf|mathcal|emph|texttt)\{([^{}]*)\}/g, "$1")
    .replace(/\\([A-Za-z]+)/g, (_, name) => TEX_GLYPH[name] ?? name)
    .replace(/---/g, "—")
    .replace(/--/g, "–")
    // `_` and `^` survive: bundle tldrs write ASCII math in backticks, where
    // dropping them turns `rho_epsilon` and `d^2` into `rhoepsilon` and `d2`.
    .replace(/[$`*{}~\\]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

/** Search snippets are cut around 160 chars; trim at a word boundary first. */
function clamp(text: string, max = 160): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const space = cut.lastIndexOf(" ");
  return `${(space > max * 0.6 ? cut.slice(0, space) : cut).replace(/[,;:—-]$/, "")}…`;
}

const desc = clamp(plain(description));
const pageTitle = plain(title);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;

const pubDate = citation ? scholarDate(citation.publicationDate) : null;
const onlineDate = citation ? scholarDate(citation.onlineDate) : null;
---

{/* Marks the document as scripted BEFORE anything paints, so the disclosures
    are collapsed without a flash. The watchdog is the other half: collapsing
    is only safe once the controller that REOPENS them has actually loaded, so
    if `js-ready` has not appeared shortly after the document is ready, the
    marker is withdrawn and the panels fall back to open (audit r3). */}
<script is:inline>
  (function () {
    var d = document;
    d.documentElement.classList.add("js");
    function check() {
      setTimeout(function () {
        var r = d.documentElement.classList;
        if (!r.contains("js-ready")) r.remove("js");
      }, 3000);
    }
    if (d.readyState === "loading") d.addEventListener("DOMContentLoaded", check);
    else check();
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={desc} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SERIES_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
{canonical && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
{citation && (
  <>
    <meta name="citation_title" content={plain(citation.title)} />
    {citation.authors.map((a) => <meta name="citation_author" content={a} />)}
    {pubDate && <meta name="citation_publication_date" content={pubDate} />}
    {onlineDate && <meta name="citation_online_date" content={onlineDate} />}
    <meta name="citation_technical_report_institution" content={citation.institution} />
    {citation.number && <meta name="citation_technical_report_number" content={citation.number} />}
    {citation.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}
    {citation.doi && <meta name="citation_doi" content={citation.doi} />}
  </>
)}
