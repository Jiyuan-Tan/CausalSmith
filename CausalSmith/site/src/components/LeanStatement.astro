---
// One row per top-level binder instead of a single shared-scroll block, for
// EVERY declaration kind — the section labels follow the role:
//
//   theorem      hypotheses · conclusion
//   definition   parameters · def · given by
//   propdef      parameters · def · given by      (a `def … : Prop`)
//   assumption   parameters · assumes            (a Prop-valued structure)
//   record       parameters · fields
//
// The binder name sits outside the scrolling area (so it can't scroll out of
// view); the clause side (conclusion / given by) renders as nested cards when
// it splits, else as plain lines. See StmtBodyView / ClauseCards.
import { isChain } from "../lib/leanStatement.js";
import { hasClause, type DeclView } from "../lib/leanDeclView.js";
import StmtBodyView from "./StmtBodyView.astro";
import StmtRowList from "./StmtRowList.astro";
import ClauseCards from "./ClauseCards.astro";

interface Props {
  view: DeclView;
  /** Original authored signature (docstring/proof stripped), for the copy button. */
  copyText: string;
}
const { view, copyText } = Astro.props as Props;

const LABELS: Record<DeclView["role"], { rows: string; fields: string; clause: string; word: string }> = {
  theorem: { rows: "hypotheses", fields: "", clause: "conclusion", word: "conclusion" },
  definition: { rows: "parameters", fields: "", clause: "given by", word: "clause" },
  propdef: { rows: "parameters", fields: "", clause: "given by", word: "clause" },
  assumption: { rows: "parameters", fields: "assumes", clause: "", word: "" },
  record: { rows: "parameters", fields: "fields", clause: "", word: "" },
  instance: { rows: "parameters", fields: "", clause: "given by", word: "clause" },
  inductive: { rows: "parameters", fields: "constructors", clause: "", word: "" },
};
const NAME_ROW: Partial<Record<DeclView["role"], string>> = { instance: "instance", inductive: "inductive" };
const nameLabel = NAME_ROW[view.role] ?? "def";
// constructor rows are addressable by number as well as by name
const fieldTokens = view.role === "inductive";
const L = LABELS[view.role];
const hasRows = view.rows.length > 0;
const hasFields = !!view.fields && view.fields.length > 0;
const showClause = hasClause(view);
const hasType = view.defRow ? isChain(view.defRow.type) || view.defRow.type.length > 0 : false;
---

<div class={`decl-stmt stmt-structured role-${view.role}`} data-copy-text={copyText}>
  {hasRows && (
    <>
      <div class="stmt-section-label">{L.rows}</div>
      <StmtRowList items={view.rows} />
    </>
  )}
  {view.defRow && view.role === "inductive" && (
    <div class:list={["stmt-def", hasRows && "bordered"]}>
      <div class="stmt-section-label">{nameLabel}</div>
      <div class="stmt-def-row" data-binder="⊢">
        <span class="stmt-def-head">{view.defRow.head}</span>
        {hasType && (
          <>
            <span class="stmt-row-colon">:</span>
            <StmtBodyView body={view.defRow.type} />
          </>
        )}
      </div>
    </div>
  )}
  {hasFields && (
    <div class:list={["stmt-fields", (hasRows || view.role === "inductive") && "bordered"]}>
      <div class="stmt-section-label">{L.fields}</div>
      <StmtRowList items={view.fields!} numbered={fieldTokens} />
      {view.note && <div class="stmt-deriving">{view.note}</div>}
    </div>
  )}
  {view.defRow && view.role !== "inductive" && (
    <div class:list={["stmt-def", hasRows && "bordered"]}>
      <div class="stmt-section-label">{nameLabel}</div>
      {/* "⊢" is the token a docstring's `[phrase](goal)` targets (renderNl). */}
      <div class="stmt-def-row" data-binder="⊢">
        <span class="stmt-def-head">{view.defRow.head}</span>
        {hasType && (
          <>
            <span class="stmt-row-colon">:</span>
            <StmtBodyView body={view.defRow.type} />
          </>
        )}
      </div>
    </div>
  )}
  {showClause && (
    <div class="stmt-concl">
      <div class="stmt-section-label">{L.clause}</div>
      {view.cards ? (
        <ClauseCards cards={view.cards} clauseWord={L.word} />
      ) : (
        <div class="stmt-concl-body" data-binder="⊢ ⊢1">
          <StmtBodyView body={view.flat} />
        </div>
      )}
    </div>
  )}
</div>
