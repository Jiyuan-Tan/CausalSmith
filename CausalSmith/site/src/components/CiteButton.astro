---
/**
 * The `Cite` control. A UTILITY, not navigation (user decision: layout B) — it
 * sits apart at the right end of the link row and opens an inline panel rather
 * than taking the reader anywhere, so it is a button with `aria-expanded`, not
 * a link. `panel` is the id of the `CitePanel` it discloses.
 */
interface Props {
  /** id of the CitePanel this button controls. */
  panel: string;
}
const { panel } = Astro.props as Props;
---

<button
  type="button"
  class="cite-btn"
  data-fold-toggle
  aria-expanded="false"
  aria-controls={panel}
>
  <span class="cite-q" aria-hidden="true">&#10078;</span>Cite
</button>
